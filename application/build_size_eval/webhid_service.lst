  35:Cpp_Core/Inc/webhid_service.hpp **** 
  36:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kRxQueueDepth = 4u;
  37:Cpp_Core/Inc/webhid_service.hpp ****     // CH585 can forward one full four-report USB OUT window before the next
  38:Cpp_Core/Inc/webhid_service.hpp ****     // WebHID service tick. Drain that complete window in the same tick so a
  39:Cpp_Core/Inc/webhid_service.hpp ****     // fragmented bootstrap request cannot leave two stale reports occupying
  40:Cpp_Core/Inc/webhid_service.hpp ****     // the queue when the following USB window is collected.
  41:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kRxProcessBudget = kRxQueueDepth;
  42:Cpp_Core/Inc/webhid_service.hpp ****     /*
  43:Cpp_Core/Inc/webhid_service.hpp ****      * Legacy WebConfig accepted logical JSON messages up to 16 KiB. Keep the
  44:Cpp_Core/Inc/webhid_service.hpp ****      * same bounded capacity in static RAM so a large request never attempts
  45:Cpp_Core/Inc/webhid_service.hpp ****      * to reserve the application's 8 KiB newlib heap.
  46:Cpp_Core/Inc/webhid_service.hpp ****      */
  47:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kMaximumLogicalBytes = 16u * 1024u;
  48:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kMaximumStreamBytes = 8u * 1024u;
  49:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kMaximumEventBytes = 8u * 1024u;
  50:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kMaximumQueuedEventBytes = 16u * 1024u;
  51:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kMaximumEventQueue = 8u;
  52:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kMaximumOutboundBytes = 16u * 1024u;
  53:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kMaximumOutboundMessages = 8u;
  54:Cpp_Core/Inc/webhid_service.hpp ****     static constexpr size_t kEdgeQueueDepth = 64u;
  55:Cpp_Core/Inc/webhid_service.hpp ****     struct LogicalAssembler
  56:Cpp_Core/Inc/webhid_service.hpp ****     {
  57:Cpp_Core/Inc/webhid_service.hpp ****         bool active = false;
  58:Cpp_Core/Inc/webhid_service.hpp ****         uint8_t type = 0u;
  59:Cpp_Core/Inc/webhid_service.hpp ****         bool secure = false;
  60:Cpp_Core/Inc/webhid_service.hpp ****         bool discardingOversize = false;
  61:Cpp_Core/Inc/webhid_service.hpp ****         uint32_t errorTransactionId = 0u;
  62:Cpp_Core/Inc/webhid_service.hpp ****         size_t length = 0u;
  63:Cpp_Core/Inc/webhid_service.hpp ****         /*
  64:Cpp_Core/Inc/webhid_service.hpp ****          * The linker reserves only 8 KiB for the newlib heap. Reserving an
  65:Cpp_Core/Inc/webhid_service.hpp ****          * 8 KiB std::vector for the first fragmented bootstrap request also
  66:Cpp_Core/Inc/webhid_service.hpp ****          * needs allocator metadata and can fault inside _malloc_r. Keep the
  67:Cpp_Core/Inc/webhid_service.hpp ****          * protocol's bounded logical-message workspace in static RAM instead.
  68:Cpp_Core/Inc/webhid_service.hpp ****          * The extra byte is the NUL terminator required by cJSON.
  69:Cpp_Core/Inc/webhid_service.hpp ****          */
  70:Cpp_Core/Inc/webhid_service.hpp ****         std::array<uint8_t, kMaximumLogicalBytes + 1u> bytes = {};
  71:Cpp_Core/Inc/webhid_service.hpp ****     };
