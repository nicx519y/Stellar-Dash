  68:Drivers/ROTARY-ENCODER/rotary-encoder.c **** static uint8_t rotenc_read_ab(void)
  69:Drivers/ROTARY-ENCODER/rotary-encoder.c **** {
  70:Drivers/ROTARY-ENCODER/rotary-encoder.c ****     const uint8_t a =
  71:Drivers/ROTARY-ENCODER/rotary-encoder.c ****         (HAL_GPIO_ReadPin(ROTENC_A_PORT, ROTENC_A_PIN) == GPIO_PIN_SET) ? 1u : 0u;
  72:Drivers/ROTARY-ENCODER/rotary-encoder.c ****     const uint8_t b =
  73:Drivers/ROTARY-ENCODER/rotary-encoder.c ****         (HAL_GPIO_ReadPin(ROTENC_B_PORT, ROTENC_B_PIN) == GPIO_PIN_SET) ? 1u : 0u;
  74:Drivers/ROTARY-ENCODER/rotary-encoder.c ****     return (uint8_t)((a << 1) | b);
  75:Drivers/ROTARY-ENCODER/rotary-encoder.c **** }
