2333:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_gcd(mbedtls_mpi *G, const mbedtls_mpi *A, const mbedtls_mpi *B)
2334:Libs/mbedtls/library/bignum.c **** {
2335:Libs/mbedtls/library/bignum.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
2336:Libs/mbedtls/library/bignum.c ****     size_t lz, lzt;
2337:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi TA, TB;
2338:Libs/mbedtls/library/bignum.c **** 
2339:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(G != NULL);
2340:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(A != NULL);
2341:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(B != NULL);
2342:Libs/mbedtls/library/bignum.c **** 
2343:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_init(&TA); mbedtls_mpi_init(&TB);
2344:Libs/mbedtls/library/bignum.c **** 
2345:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TA, A));
2346:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TB, B));
2347:Libs/mbedtls/library/bignum.c **** 
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccFcTTHc.s 			page 55


2348:Libs/mbedtls/library/bignum.c ****     lz = mbedtls_mpi_lsb(&TA);
2349:Libs/mbedtls/library/bignum.c ****     lzt = mbedtls_mpi_lsb(&TB);
2350:Libs/mbedtls/library/bignum.c **** 
2351:Libs/mbedtls/library/bignum.c ****     /* The loop below gives the correct result when A==0 but not when B==0.
2352:Libs/mbedtls/library/bignum.c ****      * So have a special case for B==0. Leverage the fact that we just
2353:Libs/mbedtls/library/bignum.c ****      * calculated the lsb and lsb(B)==0 iff B is odd or 0 to make the test
2354:Libs/mbedtls/library/bignum.c ****      * slightly more efficient than cmp_int(). */
2355:Libs/mbedtls/library/bignum.c ****     if (lzt == 0 && mbedtls_mpi_get_bit(&TB, 0) == 0) {
2356:Libs/mbedtls/library/bignum.c ****         ret = mbedtls_mpi_copy(G, A);
