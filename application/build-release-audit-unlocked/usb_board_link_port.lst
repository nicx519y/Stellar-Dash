  32:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kSpiTimeoutMs = 5u;
  33:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kReadGapMs = 1u;
  34:Src/transport/usb/usb_board_link_port.cpp **** /* This is a deadline, not pacing: return as soon as RX-ready is observed.
  35:Src/transport/usb/usb_board_link_port.cpp ****  * DMA direction changes during PREPARE must finish before another command. */
  36:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kEventReleaseTimeoutMs = 20u;
  37:Src/transport/usb/usb_board_link_port.cpp **** /*
  38:Src/transport/usb/usb_board_link_port.cpp ****  * PA12 rising-edge handling on CH585 is the RX rearm boundary.  A concurrent
  39:Src/transport/usb/usb_board_link_port.cpp ****  * USBHS ISR can delay that edge handler, so bootstrap, CAPS, and IAP retain
  40:Src/transport/usb/usb_board_link_port.cpp ****  * the proven 200-us ownership guard.  After CAPS explicitly advertises the
  41:Src/transport/usb/usb_board_link_port.cpp ****  * fast-data-plane contract, Application input frames use a fixed 20-us guard;
  42:Src/transport/usb/usb_board_link_port.cpp ****  * CH585 still performs its second NSS sample before the DMA direction switch.
  43:Src/transport/usb/usb_board_link_port.cpp ****  */
  44:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kOwnershipGuardSlowUs = 200u;
  45:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kOwnershipGuardFastUs = 20u;
  46:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kExpectedSpiClockHz = 120000000u;
  47:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kFastSpiPrescaler = 8u;
  48:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kInputFrameBytes =
  49:Src/transport/usb/usb_board_link_port.cpp ****     USB_BOARD_INPUT_V1_BYTES + USB_BOARD_LINK_HEADER_BYTES +
  50:Src/transport/usb/usb_board_link_port.cpp ****     USB_BOARD_LINK_CHECKSUM_BYTES;
  51:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kInputFrameWireUs =
  52:Src/transport/usb/usb_board_link_port.cpp ****     ((kInputFrameBytes * 8u * kFastSpiPrescaler * 1000000u) +
  53:Src/transport/usb/usb_board_link_port.cpp ****      kExpectedSpiClockHz - 1u) / kExpectedSpiClockHz;
  54:Src/transport/usb/usb_board_link_port.cpp **** static_assert(kOwnershipGuardFastUs + kInputFrameWireUs <= 50u,
  55:Src/transport/usb/usb_board_link_port.cpp ****               "fast BoardLink input frame exceeds the 50-us NSS budget");
  56:Src/transport/usb/usb_board_link_port.cpp **** static_assert(kOwnershipGuardFastUs + kInputFrameWireUs < 125u,
  57:Src/transport/usb/usb_board_link_port.cpp ****               "fast BoardLink input frame cannot fit an 8-kHz period");
