  59:Src/power/drivers/bq25895/bq25895.c **** /*
  60:Src/power/drivers/bq25895/bq25895.c ****  * Safe 1S2P / 8000 mAh common charging profile.  Input current and VINDPM
  61:Src/power/drivers/bq25895/bq25895.c ****  * are selected separately after VBUS ADC identifies a 5 V or 9 V source.
  62:Src/power/drivers/bq25895/bq25895.c ****  * BQ25895 DPDM/MaxCharge and ICO are disabled because the board's USB-C/PD
  63:Src/power/drivers/bq25895/bq25895.c ****  * negotiation is owned by CH224A and BQ25895 D+/D- are not connected.
  64:Src/power/drivers/bq25895/bq25895.c ****  *
  65:Src/power/drivers/bq25895/bq25895.c ****  * Common profile:
  66:Src/power/drivers/bq25895/bq25895.c ****  *   ICHG 1.6 A
  67:Src/power/drivers/bq25895/bq25895.c ****  *   IPRECHG 256 mA, ITERM 64 mA
  68:Src/power/drivers/bq25895/bq25895.c ****  *   VREG 4.192 V, BATLOWV 3.0 V, VRECHG 100 mV
  69:Src/power/drivers/bq25895/bq25895.c ****  *   watchdog disabled, termination enabled, 8-hour safety timer
  70:Src/power/drivers/bq25895/bq25895.c ****  *   BAT_COMP/VCLAMP disabled, TREG 80 C
  71:Src/power/drivers/bq25895/bq25895.c ****  */
  72:Src/power/drivers/bq25895/bq25895.c **** static const BQ25895_ProfileField k_safe_common_profile[] = {
