 329:Src/firmware/ch585_iap_client.cpp ****         }
 330:Src/firmware/ch585_iap_client.cpp ****         HAL_Delay(kApplicationCapsRetryMs);
 331:Src/firmware/ch585_iap_client.cpp ****     } while ((HAL_GetTick() - capsStarted) < kApplicationCapsWindowMs);
