 571:Libs/cJSON/cJSON.c ****     unsigned char decimal_point = get_decimal_point();
 572:Libs/cJSON/cJSON.c ****     double test = 0.0;
 573:Libs/cJSON/cJSON.c **** 
 574:Libs/cJSON/cJSON.c ****     if (output_buffer == NULL)
 575:Libs/cJSON/cJSON.c ****     {
 576:Libs/cJSON/cJSON.c ****         return false;
 577:Libs/cJSON/cJSON.c ****     }
 578:Libs/cJSON/cJSON.c **** 
 579:Libs/cJSON/cJSON.c ****     /* This checks for NaN and Infinity */
 580:Libs/cJSON/cJSON.c ****     if (isnan(d) || isinf(d))
 581:Libs/cJSON/cJSON.c ****     {
 582:Libs/cJSON/cJSON.c ****         length = sprintf((char*)number_buffer, "null");
 583:Libs/cJSON/cJSON.c ****     }
