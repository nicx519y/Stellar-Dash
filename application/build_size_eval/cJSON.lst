 563:Libs/cJSON/cJSON.c **** /* Render the number nicely from the given item into a string. */
 564:Libs/cJSON/cJSON.c **** static cJSON_bool print_number(const cJSON * const item, printbuffer * const output_buffer)
 565:Libs/cJSON/cJSON.c **** {
 566:Libs/cJSON/cJSON.c ****     unsigned char *output_pointer = NULL;
