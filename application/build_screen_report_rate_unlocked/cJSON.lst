 224:Libs/cJSON/cJSON.c ****     }
 225:Libs/cJSON/cJSON.c **** 
 226:Libs/cJSON/cJSON.c ****     global_hooks.deallocate = free;
 227:Libs/cJSON/cJSON.c ****     if (hooks->free_fn != NULL)
