 422:Libs/cJSON/cJSON_Utils.c ****     }
 423:Libs/cJSON/cJSON_Utils.c ****     /* make sure the detached item doesn't point anywhere anymore */
 424:Libs/cJSON/cJSON_Utils.c ****     c->prev = c->next = NULL;
 425:Libs/cJSON/cJSON_Utils.c **** 
 426:Libs/cJSON/cJSON_Utils.c ****     return c;
 427:Libs/cJSON/cJSON_Utils.c **** }
