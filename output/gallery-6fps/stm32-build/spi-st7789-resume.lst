   4:Src/display/drivers/st7789/spi-st7789-resume.c **** // Cold boot powers PI9 long before the display driver starts. On resume the
   5:Src/display/drivers/st7789/spi-st7789-resume.c **** // rail has just risen, and this PCB exposes no host-controlled LCD RESX pin.
   6:Src/display/drivers/st7789/spi-st7789-resume.c **** // Allow the module's power/reset circuit to settle before the first command.
   7:Src/display/drivers/st7789/spi-st7789-resume.c **** // This is a board margin, not an acknowledgement from the write-only panel.
   8:Src/display/drivers/st7789/spi-st7789-resume.c **** enum { PANEL_POWER_SETTLE_MS = 120u };
