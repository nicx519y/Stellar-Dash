2090:Libs/mbedtls/library/bignum.c ****     /*
2091:Libs/mbedtls/library/bignum.c ****      * This function is not constant-trace: its memory accesses depend on the
2092:Libs/mbedtls/library/bignum.c ****      * exponent value. To defend against timing attacks, callers (such as RSA
2093:Libs/mbedtls/library/bignum.c ****      * and DHM) should use exponent blinding. However this is not enough if the
2094:Libs/mbedtls/library/bignum.c ****      * adversary can find the exponent in a single trace, so this function
2095:Libs/mbedtls/library/bignum.c ****      * takes extra precautions against adversaries who can observe memory
2096:Libs/mbedtls/library/bignum.c ****      * access patterns.
2097:Libs/mbedtls/library/bignum.c ****      *
2098:Libs/mbedtls/library/bignum.c ****      * This function performs a series of multiplications by table elements and
2099:Libs/mbedtls/library/bignum.c ****      * squarings, and we want the prevent the adversary from finding out which
2100:Libs/mbedtls/library/bignum.c ****      * table element was used, and from distinguishing between multiplications
2101:Libs/mbedtls/library/bignum.c ****      * and squarings. Firstly, when multiplying by an element of the window
2102:Libs/mbedtls/library/bignum.c ****      * W[i], we do a constant-trace table lookup to obfuscate i. This leaves
2103:Libs/mbedtls/library/bignum.c ****      * squarings as having a different memory access patterns from other
2104:Libs/mbedtls/library/bignum.c ****      * multiplications. So secondly, we put the accumulator in the table as
2105:Libs/mbedtls/library/bignum.c ****      * well, and also do a constant-trace table lookup to multiply by the
2106:Libs/mbedtls/library/bignum.c ****      * accumulator which is W[x_index].
2107:Libs/mbedtls/library/bignum.c ****      *
2108:Libs/mbedtls/library/bignum.c ****      * This way, all multiplications take the form of a lookup-and-multiply.
2109:Libs/mbedtls/library/bignum.c ****      * The number of lookup-and-multiply operations inside each iteration of
2110:Libs/mbedtls/library/bignum.c ****      * the main loop still depends on the bits of the exponent, but since the
2111:Libs/mbedtls/library/bignum.c ****      * other operations in the loop don't have an easily recognizable memory
2112:Libs/mbedtls/library/bignum.c ****      * trace, an adversary is unlikely to be able to observe the exact
2113:Libs/mbedtls/library/bignum.c ****      * patterns.
2114:Libs/mbedtls/library/bignum.c ****      *
2115:Libs/mbedtls/library/bignum.c ****      * An adversary may still be able to recover the exponent if they can
2116:Libs/mbedtls/library/bignum.c ****      * observe both memory accesses and branches. However, branch prediction
2117:Libs/mbedtls/library/bignum.c ****      * exploitation typically requires many traces of execution over the same
2118:Libs/mbedtls/library/bignum.c ****      * data, which is defeated by randomized blinding.
2119:Libs/mbedtls/library/bignum.c ****      */
2120:Libs/mbedtls/library/bignum.c ****     const size_t x_index = 0;
2121:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_init(&W[x_index]);
2122:Libs/mbedtls/library/bignum.c **** 
2123:Libs/mbedtls/library/bignum.c ****     j = N->n + 1;
2124:Libs/mbedtls/library/bignum.c ****     /* All W[i] including the accumulator must have at least N->n limbs for
2125:Libs/mbedtls/library/bignum.c ****      * the mbedtls_mpi_montmul() and mpi_montred() calls later. Here we ensure
2126:Libs/mbedtls/library/bignum.c ****      * that W[1] and the accumulator W[x_index] are large enough. later we'll
2127:Libs/mbedtls/library/bignum.c ****      * grow other W[i] to the same length. They must not be shrunk midway
2128:Libs/mbedtls/library/bignum.c ****      * through this function!
2129:Libs/mbedtls/library/bignum.c ****      */
2130:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(&W[x_index], j));
2131:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(&W[1],  j));
2132:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(&T, j * 2));
2133:Libs/mbedtls/library/bignum.c **** 
2134:Libs/mbedtls/library/bignum.c ****     /*
2135:Libs/mbedtls/library/bignum.c ****      * Compensate for negative A (and correct at the end)
2136:Libs/mbedtls/library/bignum.c ****      */
2137:Libs/mbedtls/library/bignum.c ****     neg = (A->s == -1);
2138:Libs/mbedtls/library/bignum.c ****     if (neg) {
2139:Libs/mbedtls/library/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&Apos, A));
2140:Libs/mbedtls/library/bignum.c ****         Apos.s = 1;
