  28:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h ****  */
  29:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** 
  30:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // Written by Gabriel Dos Reis <dosreis@cmla.ens-cachan.fr>
  31:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** 
  32:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** #ifndef _CPP_TYPE_TRAITS_H
  33:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** #define _CPP_TYPE_TRAITS_H 1
  34:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** 
  35:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** #pragma GCC system_header
  36:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** 
  37:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** #include <bits/c++config.h>
  38:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** 
  39:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** //
  40:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // This file provides some compile-time information about various types.
  41:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // These representations were designed, on purpose, to be constant-expressions
  42:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // and not types as found in <bits/type_traits.h>.  In particular, they
  43:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // can be used in control structures and the optimizer hopefully will do
  44:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // the obvious thing.
  45:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** //
  46:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // Why integral expressions, and not functions nor types?
  47:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // Firstly, these compile-time entities are used as template-arguments
  48:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // so function return values won't work:  We need compile-time entities.
  49:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // We're left with types and constant  integral expressions.
  50:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // Secondly, from the point of view of ease of use, type-based compile-time
  51:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // information is -not- *that* convenient.  One has to write lots of
  52:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // overloaded functions and to hope that the compiler will select the right
  53:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // one. As a net effect, the overall structure isn't very clear at first
  54:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // glance.
  55:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // Thirdly, partial ordering and overload resolution (of function templates)
  56:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // is highly costly in terms of compiler-resource.  It is a Good Thing to
  57:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // keep these resource consumption as least as possible.
  58:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** //
  59:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // See valarray_array.h for a case use.
  60:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** //
  61:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** // -- Gaby (dosreis@cmla.ens-cachan.fr) 2000-03-06.
  62:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\cpp_type_traits.h **** //
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccYoUrkL.s 			page 805


