2181:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(ecp_mul_comb_core(grp, RR, T, T_size, k, d,
2182:Libs/mbedtls/library/ecp.c ****                                       f_rng, p_rng, rs_ctx));
