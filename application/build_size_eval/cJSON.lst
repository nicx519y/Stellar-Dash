 713:Libs/cJSON/cJSON.c ****         }
 714:Libs/cJSON/cJSON.c **** 
 715:Libs/cJSON/cJSON.c ****         /* get the second utf16 sequence */
 716:Libs/cJSON/cJSON.c ****         second_code = parse_hex4(second_sequence + 2);
