   6:../common/usb_monitor_protocol.h **** /* Independent of RF CTL1 and Windows HBC1. All integers are little endian.
   7:../common/usb_monitor_protocol.h ****  * HID input/feature reports remain 32 bytes, without a report ID on the wire. */
   8:../common/usb_monitor_protocol.h **** #define UM_CONTROL_MAGIC 0x31434d55u /* UMC1 */
   9:../common/usb_monitor_protocol.h **** #define UM_STATS_MAGIC   0x31534d55u /* UMS1 */
  10:../common/usb_monitor_protocol.h **** #define UM_EDGE_MAGIC    0x31454d55u /* UME1 */
  11:../common/usb_monitor_protocol.h **** #define UM_VERSION 1u
  12:../common/usb_monitor_protocol.h **** #define UM_BYTES 32u
  13:../common/usb_monitor_protocol.h **** #define UM_ENABLE 1u
  14:../common/usb_monitor_protocol.h **** #define UM_LATENCY 2u
  15:../common/usb_monitor_protocol.h **** #define UM_QUERY 0u
  16:../common/usb_monitor_protocol.h **** #define UM_CONFIGURE 1u
  17:../common/usb_monitor_protocol.h **** #define UM_RENEW 2u
  18:../common/usb_monitor_protocol.h **** #define UM_LEASE_US 3000000u
  19:../common/usb_monitor_protocol.h **** #define UM_CLOCK_TTL_US 2000000u
  20:../common/usb_monitor_protocol.h **** #define UM_MATCH_US 20000u /* less than an 8-bit sequence wrap at 8 kHz */
  21:../common/usb_monitor_protocol.h **** #define UM_UNKNOWN 0xffffffffu
  22:../common/usb_monitor_protocol.h **** #define UM_SOURCE 1u
  23:../common/usb_monitor_protocol.h **** #define UM_DONE 2u
  24:../common/usb_monitor_protocol.h **** #define UM_CLOCK 4u
  25:../common/usb_monitor_protocol.h **** #define UM_OVERWRITTEN 8u
  26:../common/usb_monitor_protocol.h **** #define UM_TIMEOUT 16u
  27:../common/usb_monitor_protocol.h **** #define UM_SEND_FAILED 32u
  28:../common/usb_monitor_protocol.h **** #define UM_UNMATCHED 64u
  29:../common/usb_monitor_protocol.h **** #define UM_OVERFLOW 128u
  30:../common/usb_monitor_protocol.h **** #define UM_BOARD_COMMAND 0x0au
  31:../common/usb_monitor_protocol.h **** #define UM_BOARD_EVENT 0x8bu
  32:../common/usb_monitor_protocol.h **** #define UM_BOARD_QUERY 0u
  33:../common/usb_monitor_protocol.h **** #define UM_BOARD_CLOCK 1u
  34:../common/usb_monitor_protocol.h **** #define UM_BOARD_EDGE 2u
  35:../common/usb_monitor_protocol.h **** 
  36:../common/usb_monitor_protocol.h **** /* Feature: magic[0], version[4], opcode[5], status[6], flags[7],
  37:../common/usb_monitor_protocol.h ****  * transaction[8], session[12], period_ms:u16[16], speed[18], caps[19],
  38:../common/usb_monitor_protocol.h ****  * drops:u32[20], reserved[24..29], CRC16[30] over bytes 0..29.
  39:../common/usb_monitor_protocol.h ****  * Stats: magic, version/flags/speed/reserved, session, device_us,
  40:../common/usb_monitor_protocol.h ****  * received, completed, overwritten, rate:u16, diagnostic_drops:u16.
  41:../common/usb_monitor_protocol.h ****  * Edge: magic, version/page/revision/flags, session, event, previous,
  42:../common/usb_monitor_protocol.h ****  * current, two u32 values. Pages 0 ADC/logic, 1 SPI-wait/SPI,
  43:../common/usb_monitor_protocol.h ****  * 2 CH585 receive-to-arm/arm-to-complete, 3 total lower/upper (us).
  44:../common/usb_monitor_protocol.h ****  * Four pages form one revision; UNKNOWN is not a zero duration.
  45:../common/usb_monitor_protocol.h ****  * Board messages use the existing BoardLink frame checksum: op/version/flags/seq,
  46:../common/usb_monitor_protocol.h ****  * session:u32[4], transaction/event:u32[8], then payload.
  47:../common/usb_monitor_protocol.h ****  * QUERY: cumulative source diagnostic drops[12]. Reply echoes header, t2[12], t3[16].
  48:../common/usb_monitor_protocol.h ****  * CLOCK: signed CH585-minus-STM32 lower[12], upper[16], query t2[20].
  49:../common/usb_monitor_protocol.h ****  * EDGE: previous[12], current[16], sample_us[20], ADC[24], logic[28],
  50:../common/usb_monitor_protocol.h ****  * SPI-wait[32], SPI[36]. seq is the original input sequence.
  51:../common/usb_monitor_protocol.h ****  */
