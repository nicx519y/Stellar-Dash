 144:Cpp_Core/Src/firmware/firmware_manager.cpp ****     // 3. 验证设备兼容性
 145:Cpp_Core/Src/firmware/firmware_manager.cpp ****     if (strcmp(metadata->device_model, DEVICE_MODEL_STRING) != 0) {
