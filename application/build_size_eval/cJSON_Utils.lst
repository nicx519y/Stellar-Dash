 111:Libs/cJSON/cJSON_Utils.c **** /* securely comparison of floating-point variables */
 112:Libs/cJSON/cJSON_Utils.c **** static cJSON_bool compare_double(double a, double b)
 113:Libs/cJSON/cJSON_Utils.c **** {
 114:Libs/cJSON/cJSON_Utils.c ****     double maxVal = fabs(a) > fabs(b) ? fabs(a) : fabs(b);
 115:Libs/cJSON/cJSON_Utils.c ****     return (fabs(a - b) <= maxVal * DBL_EPSILON);
 116:Libs/cJSON/cJSON_Utils.c **** }
