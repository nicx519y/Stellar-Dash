1535:Libs/mbedtls/library/bignum.c ****  * Baseline multiplication: X = A * b
1536:Libs/mbedtls/library/bignum.c ****  */
1537:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_mul_int(mbedtls_mpi *X, const mbedtls_mpi *A, mbedtls_mpi_uint b)
1538:Libs/mbedtls/library/bignum.c **** {
