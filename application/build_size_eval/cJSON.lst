 209:Libs/cJSON/cJSON.c **** CJSON_PUBLIC(void) cJSON_InitHooks(cJSON_Hooks* hooks)
 210:Libs/cJSON/cJSON.c **** {
 211:Libs/cJSON/cJSON.c ****     if (hooks == NULL)
 212:Libs/cJSON/cJSON.c ****     {
 213:Libs/cJSON/cJSON.c ****         /* Reset hooks */
 214:Libs/cJSON/cJSON.c ****         global_hooks.allocate = malloc;
 215:Libs/cJSON/cJSON.c ****         global_hooks.deallocate = free;
 216:Libs/cJSON/cJSON.c ****         global_hooks.reallocate = realloc;
 217:Libs/cJSON/cJSON.c ****         return;
 218:Libs/cJSON/cJSON.c ****     }
 219:Libs/cJSON/cJSON.c **** 
 220:Libs/cJSON/cJSON.c ****     global_hooks.allocate = malloc;
 221:Libs/cJSON/cJSON.c ****     if (hooks->malloc_fn != NULL)
 222:Libs/cJSON/cJSON.c ****     {
 223:Libs/cJSON/cJSON.c ****         global_hooks.allocate = hooks->malloc_fn;
 224:Libs/cJSON/cJSON.c ****     }
 225:Libs/cJSON/cJSON.c **** 
 226:Libs/cJSON/cJSON.c ****     global_hooks.deallocate = free;
 227:Libs/cJSON/cJSON.c ****     if (hooks->free_fn != NULL)
 228:Libs/cJSON/cJSON.c ****     {
 229:Libs/cJSON/cJSON.c ****         global_hooks.deallocate = hooks->free_fn;
 230:Libs/cJSON/cJSON.c ****     }
 231:Libs/cJSON/cJSON.c **** 
 232:Libs/cJSON/cJSON.c ****     /* use realloc only if both free and malloc are used */
 233:Libs/cJSON/cJSON.c ****     global_hooks.reallocate = NULL;
 234:Libs/cJSON/cJSON.c ****     if ((global_hooks.allocate == malloc) && (global_hooks.deallocate == free))
 235:Libs/cJSON/cJSON.c ****     {
 236:Libs/cJSON/cJSON.c ****         global_hooks.reallocate = realloc;
 237:Libs/cJSON/cJSON.c ****     }
 238:Libs/cJSON/cJSON.c **** }
