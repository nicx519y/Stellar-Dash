  15:Src/webconfig/webhid_rpc_dispatcher.cpp **** constexpr size_t kMaximumSerializedResponseBytes = 16u * 1024u;
  16:Src/webconfig/webhid_rpc_dispatcher.cpp **** /*
  17:Src/webconfig/webhid_rpc_dispatcher.cpp ****  * cJSON_PrintPreallocated() writes directly into this single static response
  18:Src/webconfig/webhid_rpc_dispatcher.cpp ****  * workspace. The dispatcher is called synchronously from the WebHID service,
  19:Src/webconfig/webhid_rpc_dispatcher.cpp ****  * which copies the result into its outbound storage before another request is
  20:Src/webconfig/webhid_rpc_dispatcher.cpp ****  * dispatched. Keeping this buffer out of newlib's 32 KiB heap avoids a second
  21:Src/webconfig/webhid_rpc_dispatcher.cpp ****  * near-16 KiB allocation while the command handler's cJSON tree is alive.
  22:Src/webconfig/webhid_rpc_dispatcher.cpp ****  * This CPU-only scratch is cleared before every serialization and on session
  23:Src/webconfig/webhid_rpc_dispatcher.cpp ****  * reset. The existing D2 NOLOAD area needs no startup initialization for it;
  24:Src/webconfig/webhid_rpc_dispatcher.cpp ****  * keep AXI SRAM available for executable code and ordinary static state.
  25:Src/webconfig/webhid_rpc_dispatcher.cpp ****  */
