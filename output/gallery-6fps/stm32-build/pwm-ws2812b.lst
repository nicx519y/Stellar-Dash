  80:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** 
  81:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** static uint32_t get_tim4_clock_hz(void)
  82:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** {
  83:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****     uint32_t pclk1 = HAL_RCC_GetPCLK1Freq();
  84:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****     uint32_t ppre1 = (RCC->D2CFGR & RCC_D2CFGR_D2PPRE1);
