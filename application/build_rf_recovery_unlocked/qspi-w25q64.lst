  63:Src/config/drivers/qspi/qspi-w25q64.c **** /*
  64:Src/config/drivers/qspi/qspi-w25q64.c ****  * Blocking QUADSPI automatic polling keeps the peripheral BUSY until the
  65:Src/config/drivers/qspi/qspi-w25q64.c ****  * status-match flag is raised. If that match is missed, the HAL timeout can
  66:Src/config/drivers/qspi/qspi-w25q64.c ****  * itself be starved by unrelated high-frequency interrupts. Use short,
  67:Src/config/drivers/qspi/qspi-w25q64.c ****  * individually bounded indirect status reads so the peripheral returns to
  68:Src/config/drivers/qspi/qspi-w25q64.c ****  * READY between polls and the caller always retains control.
  69:Src/config/drivers/qspi/qspi-w25q64.c ****  */
  70:Src/config/drivers/qspi/qspi-w25q64.c **** #define W25Qxx_READY_TIMEOUT_MS        HAL_QSPI_TIMEOUT_DEFAULT_VALUE
  71:Src/config/drivers/qspi/qspi-w25q64.c **** #define W25Qxx_READY_POLL_MAX_ATTEMPTS 250000UL
  72:Src/config/drivers/qspi/qspi-w25q64.c **** #define W25Qxx_READY_POLL_SPIN_DIVISOR 100000UL
