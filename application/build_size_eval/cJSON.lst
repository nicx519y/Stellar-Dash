 490:Libs/cJSON/cJSON.c ****     /* calculate new buffer size */
 491:Libs/cJSON/cJSON.c ****     if (needed > (INT_MAX / 2))
 492:Libs/cJSON/cJSON.c ****     {
 493:Libs/cJSON/cJSON.c ****         /* overflow of int, use INT_MAX if possible */
 494:Libs/cJSON/cJSON.c ****         if (needed <= INT_MAX)
 495:Libs/cJSON/cJSON.c ****         {
 496:Libs/cJSON/cJSON.c ****             newsize = INT_MAX;
 497:Libs/cJSON/cJSON.c ****         }
 498:Libs/cJSON/cJSON.c ****         else
 499:Libs/cJSON/cJSON.c ****         {
 500:Libs/cJSON/cJSON.c ****             return NULL;
 501:Libs/cJSON/cJSON.c ****         }
 502:Libs/cJSON/cJSON.c ****     }
 503:Libs/cJSON/cJSON.c ****     else
 504:Libs/cJSON/cJSON.c ****     {
 505:Libs/cJSON/cJSON.c ****         newsize = needed * 2;
 506:Libs/cJSON/cJSON.c ****     }
 507:Libs/cJSON/cJSON.c **** 
 508:Libs/cJSON/cJSON.c ****     if (p->hooks.reallocate != NULL)
 509:Libs/cJSON/cJSON.c ****     {
 510:Libs/cJSON/cJSON.c ****         /* reallocate with realloc if available */
 511:Libs/cJSON/cJSON.c ****         newbuffer = (unsigned char*)p->hooks.reallocate(p->buffer, newsize);
 512:Libs/cJSON/cJSON.c ****         if (newbuffer == NULL)
