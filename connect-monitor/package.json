{
  "name": "connect-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "HBox USB/RF connection monitor client",
  "main": "dist/electron/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build --config renderer/vite.config.ts",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron dist/electron/main.js",
    "start:mock": "cross-env MONITOR_MOCK=1 electron dist/electron/main.js",
    "dev:renderer": "vite --config renderer/vite.config.ts",
    "dev:electron": "npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist/electron/main.js",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0"
  },
  "optionalDependencies": {
    "node-hid": "^3.1.2",
    "serialport": "^12.0.0"
  }
}
