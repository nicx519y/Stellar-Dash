   5:Drivers/PWM-WS2812B/pwm-ws2812b.c **** /* WS2812B-Mini-V3J data protocol (datasheet):
   6:Drivers/PWM-WS2812B/pwm-ws2812b.c **** |-------------------------------------------|
   7:Drivers/PWM-WS2812B/pwm-ws2812b.c **** |T0H | 220ns ~ 380ns
   8:Drivers/PWM-WS2812B/pwm-ws2812b.c **** |T1H | 580ns ~ 1us
   9:Drivers/PWM-WS2812B/pwm-ws2812b.c **** |T0L | 580ns ~ 1us
  10:Drivers/PWM-WS2812B/pwm-ws2812b.c **** |T1L | 580ns ~ 1us
  11:Drivers/PWM-WS2812B/pwm-ws2812b.c **** |RES | above 280us |
  12:Drivers/PWM-WS2812B/pwm-ws2812b.c **** |-------------------------------------------
  13:Drivers/PWM-WS2812B/pwm-ws2812b.c **** */
  14:Drivers/PWM-WS2812B/pwm-ws2812b.c **** 
  15:Drivers/PWM-WS2812B/pwm-ws2812b.c **** /* 240MHz timer clock, period=308 ticks -> 1.283us (779.22kHz).
  16:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  *
  17:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  * Both key-module schematics populate WS2812B-MINI-V3J.  Keep the high and
  18:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  * low portions away from the datasheet limits; 160 ticks previously left
  19:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  * only about 3ns of T1L margin.  The centered values also leave more time for
  20:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  * the next CCR DMA write before the following PWM period:
  21:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  *   T1H = 150/240MHz = 625ns, T1L = 658ns
  22:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  *   T0H =  72/240MHz = 300ns, T0L = 983ns
  23:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  *
  24:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  * The ambient path already uses and has verified the same centered timing.
  25:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  */
  26:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define KEYS_HIGH_CCR_CODE       150u
  27:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define KEYS_LOW_CCR_CODE         72u
  28:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define AMBIENT_HIGH_CCR_CODE    150u
  29:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define AMBIENT_LOW_CCR_CODE      72u
  30:Drivers/PWM-WS2812B/pwm-ws2812b.c **** 
  31:Drivers/PWM-WS2812B/pwm-ws2812b.c **** /* One reset slot is 24 zero-duty PWM periods, about 30.8us at 779.22kHz.
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\cc2088Hu.s 			page 2


  32:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  * Ten slots produce about 308us, the shortest whole-slot value that remains
  33:Drivers/PWM-WS2812B/pwm-ws2812b.c ****  * above the WS2812B-MINI-V3J datasheet reset/latch minimum of 280us. */
  34:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define WS2812B_KEYS_RESET_SLOT_COUNT       10u
  35:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define WS2812B_AMBIENT_RESET_SLOT_COUNT    10u
  36:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define WS2812B_FRAME_BUFFER_LEN_FOR(count, resetSlots) \
  37:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     ((((uint32_t)(count) + (uint32_t)(resetSlots)) * 24u) * \
  38:Drivers/PWM-WS2812B/pwm-ws2812b.c ****      (uint32_t)NUM_LEDs_PER_ADC_BUTTON)
  39:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define WS2812B_DMA_BUFFER_LEN_FOR(count, resetSlots) \
  40:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     (2u * WS2812B_FRAME_BUFFER_LEN_FOR((count), (resetSlots)))
  41:Drivers/PWM-WS2812B/pwm-ws2812b.c **** 
  42:Drivers/PWM-WS2812B/pwm-ws2812b.c **** #define LED_DEFAULT_BRIGHTNESS 128
  43:Drivers/PWM-WS2812B/pwm-ws2812b.c **** 
  44:Drivers/PWM-WS2812B/pwm-ws2812b.c **** enum {
  45:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     WS2812B_KEYS_LED_COUNT = (NUM_ADC_BUTTONS + NUM_GPIO_BUTTONS),
  46:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     WS2812B_AMBIENT_LED_COUNT = NUM_LED_AROUND
  47:Drivers/PWM-WS2812B/pwm-ws2812b.c **** };
  48:Drivers/PWM-WS2812B/pwm-ws2812b.c **** 
  49:Drivers/PWM-WS2812B/pwm-ws2812b.c **** enum {
  50:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     WS2812B_KEYS_PAYLOAD_BUFFER_LEN =
  51:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         WS2812B_KEYS_LED_COUNT * NUM_LEDs_PER_ADC_BUTTON * 24u,
  52:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     WS2812B_AMBIENT_PAYLOAD_BUFFER_LEN =
  53:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         WS2812B_AMBIENT_LED_COUNT * NUM_LEDs_PER_ADC_BUTTON * 24u,
  54:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     WS2812B_KEYS_FRAME_BUFFER_LEN = (int)WS2812B_FRAME_BUFFER_LEN_FOR(
  55:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         WS2812B_KEYS_LED_COUNT, WS2812B_KEYS_RESET_SLOT_COUNT),
  56:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     WS2812B_AMBIENT_FRAME_BUFFER_LEN = (int)WS2812B_FRAME_BUFFER_LEN_FOR(
  57:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         WS2812B_AMBIENT_LED_COUNT, WS2812B_AMBIENT_RESET_SLOT_COUNT),
  58:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     WS2812B_KEYS_DMA_BUFFER_LEN = (int)WS2812B_DMA_BUFFER_LEN_FOR(
  59:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         WS2812B_KEYS_LED_COUNT, WS2812B_KEYS_RESET_SLOT_COUNT),
  60:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     WS2812B_AMBIENT_DMA_BUFFER_LEN = (int)WS2812B_DMA_BUFFER_LEN_FOR(
  61:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         WS2812B_AMBIENT_LED_COUNT, WS2812B_AMBIENT_RESET_SLOT_COUNT)
  62:Drivers/PWM-WS2812B/pwm-ws2812b.c **** };
