1391:Libs/cJSON/cJSON_Utils.c **** static cJSON *generate_merge_patch(cJSON * const from, cJSON * const to, const cJSON_bool case_sens
1392:Libs/cJSON/cJSON_Utils.c **** {
1393:Libs/cJSON/cJSON_Utils.c ****     cJSON *from_child = NULL;
1394:Libs/cJSON/cJSON_Utils.c ****     cJSON *to_child = NULL;
1395:Libs/cJSON/cJSON_Utils.c ****     cJSON *patch = NULL;
1396:Libs/cJSON/cJSON_Utils.c ****     if (to == NULL)
1397:Libs/cJSON/cJSON_Utils.c ****     {
1398:Libs/cJSON/cJSON_Utils.c ****         /* patch to delete everything */
1399:Libs/cJSON/cJSON_Utils.c ****         return cJSON_CreateNull();
1400:Libs/cJSON/cJSON_Utils.c ****     }
1401:Libs/cJSON/cJSON_Utils.c ****     if (!cJSON_IsObject(to) || !cJSON_IsObject(from))
1402:Libs/cJSON/cJSON_Utils.c ****     {
1403:Libs/cJSON/cJSON_Utils.c ****         return cJSON_Duplicate(to, 1);
1404:Libs/cJSON/cJSON_Utils.c ****     }
1405:Libs/cJSON/cJSON_Utils.c **** 
1406:Libs/cJSON/cJSON_Utils.c ****     sort_object(from, case_sensitive);
1407:Libs/cJSON/cJSON_Utils.c ****     sort_object(to, case_sensitive);
1408:Libs/cJSON/cJSON_Utils.c **** 
1409:Libs/cJSON/cJSON_Utils.c ****     from_child = from->child;
1410:Libs/cJSON/cJSON_Utils.c ****     to_child = to->child;
1411:Libs/cJSON/cJSON_Utils.c ****     patch = cJSON_CreateObject();
1412:Libs/cJSON/cJSON_Utils.c ****     if (patch == NULL)
1413:Libs/cJSON/cJSON_Utils.c ****     {
1414:Libs/cJSON/cJSON_Utils.c ****         return NULL;
1415:Libs/cJSON/cJSON_Utils.c ****     }
1416:Libs/cJSON/cJSON_Utils.c ****     while (from_child || to_child)
1417:Libs/cJSON/cJSON_Utils.c ****     {
1418:Libs/cJSON/cJSON_Utils.c ****         int diff;
1419:Libs/cJSON/cJSON_Utils.c ****         if (from_child != NULL)
1420:Libs/cJSON/cJSON_Utils.c ****         {
1421:Libs/cJSON/cJSON_Utils.c ****             if (to_child != NULL)
1422:Libs/cJSON/cJSON_Utils.c ****             {
1423:Libs/cJSON/cJSON_Utils.c ****                 diff = strcmp(from_child->string, to_child->string);
1424:Libs/cJSON/cJSON_Utils.c ****             }
1425:Libs/cJSON/cJSON_Utils.c ****             else
1426:Libs/cJSON/cJSON_Utils.c ****             {
1427:Libs/cJSON/cJSON_Utils.c ****                 diff = -1;
1428:Libs/cJSON/cJSON_Utils.c ****             }
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccwotn7V.s 			page 121


1429:Libs/cJSON/cJSON_Utils.c ****         }
1430:Libs/cJSON/cJSON_Utils.c ****         else
1431:Libs/cJSON/cJSON_Utils.c ****         {
1432:Libs/cJSON/cJSON_Utils.c ****             diff = 1;
1433:Libs/cJSON/cJSON_Utils.c ****         }
1434:Libs/cJSON/cJSON_Utils.c **** 
1435:Libs/cJSON/cJSON_Utils.c ****         if (diff < 0)
1436:Libs/cJSON/cJSON_Utils.c ****         {
1437:Libs/cJSON/cJSON_Utils.c ****             /* from has a value that to doesn't have -> remove */
1438:Libs/cJSON/cJSON_Utils.c ****             cJSON_AddItemToObject(patch, from_child->string, cJSON_CreateNull());
1439:Libs/cJSON/cJSON_Utils.c **** 
1440:Libs/cJSON/cJSON_Utils.c ****             from_child = from_child->next;
1441:Libs/cJSON/cJSON_Utils.c ****         }
1442:Libs/cJSON/cJSON_Utils.c ****         else if (diff > 0)
1443:Libs/cJSON/cJSON_Utils.c ****         {
1444:Libs/cJSON/cJSON_Utils.c ****             /* to has a value that from doesn't have -> add to patch */
1445:Libs/cJSON/cJSON_Utils.c ****             cJSON_AddItemToObject(patch, to_child->string, cJSON_Duplicate(to_child, 1));
1446:Libs/cJSON/cJSON_Utils.c **** 
1447:Libs/cJSON/cJSON_Utils.c ****             to_child = to_child->next;
1448:Libs/cJSON/cJSON_Utils.c ****         }
1449:Libs/cJSON/cJSON_Utils.c ****         else
1450:Libs/cJSON/cJSON_Utils.c ****         {
1451:Libs/cJSON/cJSON_Utils.c ****             /* object key exists in both objects */
1452:Libs/cJSON/cJSON_Utils.c ****             if (!compare_json(from_child, to_child, case_sensitive))
1453:Libs/cJSON/cJSON_Utils.c ****             {
1454:Libs/cJSON/cJSON_Utils.c ****                 /* not identical --> generate a patch */
1455:Libs/cJSON/cJSON_Utils.c ****                 cJSON_AddItemToObject(patch, to_child->string, cJSONUtils_GenerateMergePatch(from_c
1456:Libs/cJSON/cJSON_Utils.c ****             }
1457:Libs/cJSON/cJSON_Utils.c **** 
1458:Libs/cJSON/cJSON_Utils.c ****             /* next key in the object */
1459:Libs/cJSON/cJSON_Utils.c ****             from_child = from_child->next;
1460:Libs/cJSON/cJSON_Utils.c ****             to_child = to_child->next;
1461:Libs/cJSON/cJSON_Utils.c ****         }
1462:Libs/cJSON/cJSON_Utils.c ****     }
1463:Libs/cJSON/cJSON_Utils.c ****     if (patch->child == NULL)
1464:Libs/cJSON/cJSON_Utils.c ****     {
1465:Libs/cJSON/cJSON_Utils.c ****         /* no patch generated */
1466:Libs/cJSON/cJSON_Utils.c ****         cJSON_Delete(patch);
1467:Libs/cJSON/cJSON_Utils.c ****         return NULL;
1468:Libs/cJSON/cJSON_Utils.c ****     }
1469:Libs/cJSON/cJSON_Utils.c **** 
1470:Libs/cJSON/cJSON_Utils.c ****     return patch;
1471:Libs/cJSON/cJSON_Utils.c **** }
