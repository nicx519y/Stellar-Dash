 139:Drivers/I2C-BQ25895/bq25895.c **** static bool update_register(BQ25895_Handle* handle, uint8_t reg, uint8_t mask, uint8_t value)
 140:Drivers/I2C-BQ25895/bq25895.c **** {
 141:Drivers/I2C-BQ25895/bq25895.c ****     uint8_t before = 0;
 142:Drivers/I2C-BQ25895/bq25895.c ****     if (!read_register(handle, reg, &before)) {
 143:Drivers/I2C-BQ25895/bq25895.c ****         return false;
