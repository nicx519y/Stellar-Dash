 159:Cpp_Core/Src/leds/led_animation.cpp **** // 随机选择不重复的按钮
 160:Cpp_Core/Src/leds/led_animation.cpp **** static uint8_t selectRandomButtons(uint8_t total, uint8_t count, uint8_t* exclude, uint8_t excludeC
 161:Cpp_Core/Src/leds/led_animation.cpp ****     uint8_t available[NUM_LED];
 162:Cpp_Core/Src/leds/led_animation.cpp ****     uint8_t availableCount = 0;
 163:Cpp_Core/Src/leds/led_animation.cpp ****     
 164:Cpp_Core/Src/leds/led_animation.cpp ****     // 生成可用按钮列表
 165:Cpp_Core/Src/leds/led_animation.cpp ****     for (uint8_t i = 0; i < total; i++) {
 166:Cpp_Core/Src/leds/led_animation.cpp ****         bool isExcluded = false;
 167:Cpp_Core/Src/leds/led_animation.cpp ****         for (uint8_t j = 0; j < excludeCount; j++) {
 168:Cpp_Core/Src/leds/led_animation.cpp ****             if (exclude[j] == i) {
 169:Cpp_Core/Src/leds/led_animation.cpp ****                 isExcluded = true;
 170:Cpp_Core/Src/leds/led_animation.cpp ****                 break;
 171:Cpp_Core/Src/leds/led_animation.cpp ****             }
 172:Cpp_Core/Src/leds/led_animation.cpp ****         }
 173:Cpp_Core/Src/leds/led_animation.cpp ****         if (!isExcluded) {
