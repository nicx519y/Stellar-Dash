1007:Libs/mbedtls/library/ecp_curves.c **** MBEDTLS_STATIC_TESTABLE
1008:Libs/mbedtls/library/ecp_curves.c **** void mbedtls_ecp_fix_negative(mbedtls_mpi *N, signed char c, size_t bits)
1009:Libs/mbedtls/library/ecp_curves.c **** {
1010:Libs/mbedtls/library/ecp_curves.c ****     size_t i;
1011:Libs/mbedtls/library/ecp_curves.c **** 
1012:Libs/mbedtls/library/ecp_curves.c ****     /* Set N := 2^bits - 1 - N. We know that 0 <= N < 2^bits, so
1013:Libs/mbedtls/library/ecp_curves.c ****      * set the absolute value to 0xfff...fff - N. There is no carry
1014:Libs/mbedtls/library/ecp_curves.c ****      * since we're subtracting from all-bits-one.  */
