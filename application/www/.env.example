# V2 hosted build (default). Set legacy-websocket only for the retained V1 build.
NEXT_PUBLIC_DEVICE_TRANSPORT=webhid
# Mock-only safety flag: keep the UI accessible when no hardware is connected.
NEXT_PUBLIC_OFFLINE_PREVIEW=false

# Hardware-free local QA (enable both):
# NEXT_PUBLIC_DEVICE_TRANSPORT=mock
# NEXT_PUBLIC_OFFLINE_PREVIEW=true

# Vendor-defined Maintenance HID collection. Values accept decimal or 0x hex.
NEXT_PUBLIC_WEBHID_USAGE_PAGE=0xFF00
NEXT_PUBLIC_WEBHID_USAGE=0x01
NEXT_PUBLIC_WEBHID_REPORT_ID=0
NEXT_PUBLIC_WEBHID_VENDOR_ID=0xCAFE
NEXT_PUBLIC_WEBHID_PRODUCT_ID=0x4021

NEXT_PUBLIC_DEVICE_AUTH_CHALLENGE_ENDPOINT=/api/v2/device-auth/challenges
NEXT_PUBLIC_DEVICE_AUTH_VERIFY_ENDPOINT=/api/v2/device-auth/verify
# Optional explicit pin. Defaults to the challenge endpoint's origin.
NEXT_PUBLIC_DEVICE_AUTH_SERVER_ORIGIN=
NEXT_PUBLIC_FIRMWARE_SERVER_HOST=
