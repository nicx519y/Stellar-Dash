 723:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         }
 724:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         *strip_published_generation(strip) = next;
 725:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         *strip_applied_generation(strip) = next;
 726:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     }
