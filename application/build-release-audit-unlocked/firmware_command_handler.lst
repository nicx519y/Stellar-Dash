3401:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\basic_string.h ****        *  @param __n2  Number of characters of s.
3402:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\basic_string.h ****        *  @return  Integer < 0, 0, or > 0.
