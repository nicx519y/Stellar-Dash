 185:Cpp_Core/Src/configs/profile_command_handler.cpp **** uint32_t ProfileCommandHandler::getKeyMappingVirtualMask(cJSON* keyMappingJSON) {
 186:Cpp_Core/Src/configs/profile_command_handler.cpp ****     if(!keyMappingJSON || !cJSON_IsArray(keyMappingJSON)) {
 187:Cpp_Core/Src/configs/profile_command_handler.cpp ****         return 0;
 188:Cpp_Core/Src/configs/profile_command_handler.cpp ****     }
 189:Cpp_Core/Src/configs/profile_command_handler.cpp **** 
 190:Cpp_Core/Src/configs/profile_command_handler.cpp ****     uint32_t virtualMask = 0;
 191:Cpp_Core/Src/configs/profile_command_handler.cpp ****     cJSON* item = NULL;
 192:Cpp_Core/Src/configs/profile_command_handler.cpp ****     cJSON_ArrayForEach(item, keyMappingJSON) {
 193:Cpp_Core/Src/configs/profile_command_handler.cpp ****         if (!item || !cJSON_IsNumber(item)) continue;
 194:Cpp_Core/Src/configs/profile_command_handler.cpp ****         int idx = (int)cJSON_GetNumberValue(item);
 195:Cpp_Core/Src/configs/profile_command_handler.cpp ****         if (idx < 0 || idx >= (NUM_ADC_BUTTONS + NUM_GPIO_BUTTONS)) continue;
 196:Cpp_Core/Src/configs/profile_command_handler.cpp ****         virtualMask |= (1u << (uint32_t)idx);
 197:Cpp_Core/Src/configs/profile_command_handler.cpp ****     }
 198:Cpp_Core/Src/configs/profile_command_handler.cpp ****     return virtualMask;
 199:Cpp_Core/Src/configs/profile_command_handler.cpp **** }
