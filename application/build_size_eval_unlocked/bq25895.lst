 145:Drivers/I2C-BQ25895/bq25895.c **** 
 146:Drivers/I2C-BQ25895/bq25895.c ****     const uint8_t after = (uint8_t)((before & (uint8_t)~mask) | (value & mask));
 147:Drivers/I2C-BQ25895/bq25895.c ****     if (after != before && !write_register(handle, reg, after)) {
 148:Drivers/I2C-BQ25895/bq25895.c ****         return false;
 149:Drivers/I2C-BQ25895/bq25895.c ****     }
