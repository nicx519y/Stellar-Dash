  20:Libs/CRC32/src/CRC32.hpp **** 
  21:Libs/CRC32/src/CRC32.hpp **** 	/// \brief Update the current checksum caclulation with the given data.
  22:Libs/CRC32/src/CRC32.hpp **** 	/// \param data The data to add to the checksum.
  23:Libs/CRC32/src/CRC32.hpp **** 	void update(const uint8_t &data);
  24:Libs/CRC32/src/CRC32.hpp **** 
  25:Libs/CRC32/src/CRC32.hpp **** 	/// \brief Update the current checksum caclulation with the given data.
  26:Libs/CRC32/src/CRC32.hpp **** 	/// \tparam Type The data type to read.
  27:Libs/CRC32/src/CRC32.hpp **** 	/// \param data The data to add to the checksum.
  28:Libs/CRC32/src/CRC32.hpp **** 	template <typename Type>
  29:Libs/CRC32/src/CRC32.hpp **** 	void update(const Type &data) {
  30:Libs/CRC32/src/CRC32.hpp **** 		update(&data, 1);
  31:Libs/CRC32/src/CRC32.hpp **** 	}
  32:Libs/CRC32/src/CRC32.hpp **** 
  33:Libs/CRC32/src/CRC32.hpp **** 	/// \brief Update the current checksum caclulation with the given data.
  34:Libs/CRC32/src/CRC32.hpp **** 	/// \tparam Type The data type to read.
  35:Libs/CRC32/src/CRC32.hpp **** 	/// \param data The array to add to the checksum.
  36:Libs/CRC32/src/CRC32.hpp **** 	/// \param size Size of the array to add.
  37:Libs/CRC32/src/CRC32.hpp **** 	template <typename Type>
  38:Libs/CRC32/src/CRC32.hpp **** 	void update(const Type *data, uint16_t size) {
  39:Libs/CRC32/src/CRC32.hpp **** 		uint16_t nBytes = size * sizeof(Type);
