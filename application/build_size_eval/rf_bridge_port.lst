 111:Cpp_Core/Src/rf_bridge_port.cpp **** static void rf_mask_irq_line(void) {
 112:Cpp_Core/Src/rf_bridge_port.cpp ****     /*
 113:Cpp_Core/Src/rf_bridge_port.cpp ****      * EXTI15_10 is shared with MAX17048 ALERT# on PC13.  Mask only PE10;
 114:Cpp_Core/Src/rf_bridge_port.cpp ****      * disabling the NVIC vector would also suppress the fuel-gauge alert.
 115:Cpp_Core/Src/rf_bridge_port.cpp ****      * GPIO_MODE_INPUT alone does not remove a previous EXTI configuration.
 116:Cpp_Core/Src/rf_bridge_port.cpp ****      */
 117:Cpp_Core/Src/rf_bridge_port.cpp ****     CLEAR_BIT(EXTI_D1->IMR1, RF_BRIDGE_IRQ_PIN);
