 429:Libs/cJSON/cJSON_Utils.c **** /* detach an item at the given path */
 430:Libs/cJSON/cJSON_Utils.c **** static cJSON *detach_path(cJSON *object, const unsigned char *path, const cJSON_bool case_sensitive
 431:Libs/cJSON/cJSON_Utils.c **** {
 432:Libs/cJSON/cJSON_Utils.c ****     unsigned char *parent_pointer = NULL;
 433:Libs/cJSON/cJSON_Utils.c ****     unsigned char *child_pointer = NULL;
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccPVXknh.s 			page 28


 434:Libs/cJSON/cJSON_Utils.c ****     cJSON *parent = NULL;
 435:Libs/cJSON/cJSON_Utils.c ****     cJSON *detached_item = NULL;
 436:Libs/cJSON/cJSON_Utils.c **** 
 437:Libs/cJSON/cJSON_Utils.c ****     /* copy path and split it in parent and child */
 438:Libs/cJSON/cJSON_Utils.c ****     parent_pointer = cJSONUtils_strdup(path);
 439:Libs/cJSON/cJSON_Utils.c ****     if (parent_pointer == NULL) {
 440:Libs/cJSON/cJSON_Utils.c ****         goto cleanup;
 441:Libs/cJSON/cJSON_Utils.c ****     }
 442:Libs/cJSON/cJSON_Utils.c **** 
 443:Libs/cJSON/cJSON_Utils.c ****     child_pointer = (unsigned char*)strrchr((char*)parent_pointer, '/'); /* last '/' */
 444:Libs/cJSON/cJSON_Utils.c ****     if (child_pointer == NULL)
 445:Libs/cJSON/cJSON_Utils.c ****     {
 446:Libs/cJSON/cJSON_Utils.c ****         goto cleanup;
 447:Libs/cJSON/cJSON_Utils.c ****     }
 448:Libs/cJSON/cJSON_Utils.c ****     /* split strings */
 449:Libs/cJSON/cJSON_Utils.c ****     child_pointer[0] = '\0';
 450:Libs/cJSON/cJSON_Utils.c ****     child_pointer++;
 451:Libs/cJSON/cJSON_Utils.c **** 
 452:Libs/cJSON/cJSON_Utils.c ****     parent = get_item_from_pointer(object, (char*)parent_pointer, case_sensitive);
 453:Libs/cJSON/cJSON_Utils.c ****     decode_pointer_inplace(child_pointer);
 454:Libs/cJSON/cJSON_Utils.c **** 
 455:Libs/cJSON/cJSON_Utils.c ****     if (cJSON_IsArray(parent))
 456:Libs/cJSON/cJSON_Utils.c ****     {
 457:Libs/cJSON/cJSON_Utils.c ****         size_t index = 0;
 458:Libs/cJSON/cJSON_Utils.c ****         if (!decode_array_index_from_pointer(child_pointer, &index))
 459:Libs/cJSON/cJSON_Utils.c ****         {
 460:Libs/cJSON/cJSON_Utils.c ****             goto cleanup;
 461:Libs/cJSON/cJSON_Utils.c ****         }
 462:Libs/cJSON/cJSON_Utils.c ****         detached_item = detach_item_from_array(parent, index);
 463:Libs/cJSON/cJSON_Utils.c ****     }
 464:Libs/cJSON/cJSON_Utils.c ****     else if (cJSON_IsObject(parent))
 465:Libs/cJSON/cJSON_Utils.c ****     {
 466:Libs/cJSON/cJSON_Utils.c ****         detached_item = cJSON_DetachItemFromObject(parent, (char*)child_pointer);
 467:Libs/cJSON/cJSON_Utils.c ****     }
 468:Libs/cJSON/cJSON_Utils.c ****     else
 469:Libs/cJSON/cJSON_Utils.c ****     {
 470:Libs/cJSON/cJSON_Utils.c ****         /* Couldn't find object to remove child from. */
 471:Libs/cJSON/cJSON_Utils.c ****         goto cleanup;
 472:Libs/cJSON/cJSON_Utils.c ****     }
 473:Libs/cJSON/cJSON_Utils.c **** 
 474:Libs/cJSON/cJSON_Utils.c **** cleanup:
 475:Libs/cJSON/cJSON_Utils.c ****     if (parent_pointer != NULL)
 476:Libs/cJSON/cJSON_Utils.c ****     {
 477:Libs/cJSON/cJSON_Utils.c ****         cJSON_free(parent_pointer);
 478:Libs/cJSON/cJSON_Utils.c ****     }
 479:Libs/cJSON/cJSON_Utils.c **** 
 480:Libs/cJSON/cJSON_Utils.c ****     return detached_item;
 481:Libs/cJSON/cJSON_Utils.c **** }
