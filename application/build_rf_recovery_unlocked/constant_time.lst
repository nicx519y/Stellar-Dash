 404:Libs/mbedtls/library/constant_time.c **** {
 405:Libs/mbedtls/library/constant_time.c ****     /*
 406:Libs/mbedtls/library/constant_time.c ****      * This function breaks the HMAC abstraction and uses the md_clone()
 407:Libs/mbedtls/library/constant_time.c ****      * extension to the MD API in order to get constant-flow behaviour.
 408:Libs/mbedtls/library/constant_time.c ****      *
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccvCVS6d.s 			page 19


 409:Libs/mbedtls/library/constant_time.c ****      * HMAC(msg) is defined as HASH(okey + HASH(ikey + msg)) where + means
 410:Libs/mbedtls/library/constant_time.c ****      * concatenation, and okey/ikey are the XOR of the key with some fixed bit
 411:Libs/mbedtls/library/constant_time.c ****      * patterns (see RFC 2104, sec. 2), which are stored in ctx->hmac_ctx.
 412:Libs/mbedtls/library/constant_time.c ****      *
 413:Libs/mbedtls/library/constant_time.c ****      * We'll first compute inner_hash = HASH(ikey + msg) by hashing up to
 414:Libs/mbedtls/library/constant_time.c ****      * minlen, then cloning the context, and for each byte up to maxlen
 415:Libs/mbedtls/library/constant_time.c ****      * finishing up the hash computation, keeping only the correct result.
 416:Libs/mbedtls/library/constant_time.c ****      *
 417:Libs/mbedtls/library/constant_time.c ****      * Then we only need to compute HASH(okey + inner_hash) and we're done.
 418:Libs/mbedtls/library/constant_time.c ****      */
 419:Libs/mbedtls/library/constant_time.c ****     const mbedtls_md_type_t md_alg = mbedtls_md_get_type(ctx->md_info);
 420:Libs/mbedtls/library/constant_time.c ****     /* TLS 1.0-1.2 only support SHA-384, SHA-256, SHA-1, MD-5,
 421:Libs/mbedtls/library/constant_time.c ****      * all of which have the same block size except SHA-384. */
 422:Libs/mbedtls/library/constant_time.c ****     const size_t block_size = md_alg == MBEDTLS_MD_SHA384 ? 128 : 64;
 423:Libs/mbedtls/library/constant_time.c ****     const unsigned char * const ikey = ctx->hmac_ctx;
 424:Libs/mbedtls/library/constant_time.c ****     const unsigned char * const okey = ikey + block_size;
 425:Libs/mbedtls/library/constant_time.c ****     const size_t hash_size = mbedtls_md_get_size(ctx->md_info);
 426:Libs/mbedtls/library/constant_time.c **** 
 427:Libs/mbedtls/library/constant_time.c ****     unsigned char aux_out[MBEDTLS_MD_MAX_SIZE];
 428:Libs/mbedtls/library/constant_time.c ****     mbedtls_md_context_t aux;
 429:Libs/mbedtls/library/constant_time.c ****     size_t offset;
 430:Libs/mbedtls/library/constant_time.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
 431:Libs/mbedtls/library/constant_time.c **** 
 432:Libs/mbedtls/library/constant_time.c ****     mbedtls_md_init(&aux);
 433:Libs/mbedtls/library/constant_time.c **** 
 434:Libs/mbedtls/library/constant_time.c **** #define MD_CHK(func_call) \
 435:Libs/mbedtls/library/constant_time.c ****     do {                    \
 436:Libs/mbedtls/library/constant_time.c ****         ret = (func_call);  \
 437:Libs/mbedtls/library/constant_time.c ****         if (ret != 0)      \
 438:Libs/mbedtls/library/constant_time.c ****         goto cleanup;   \
 439:Libs/mbedtls/library/constant_time.c ****     } while (0)
 440:Libs/mbedtls/library/constant_time.c **** 
 441:Libs/mbedtls/library/constant_time.c ****     MD_CHK(mbedtls_md_setup(&aux, ctx->md_info, 0));
 442:Libs/mbedtls/library/constant_time.c **** 
 443:Libs/mbedtls/library/constant_time.c ****     /* After hmac_start() of hmac_reset(), ikey has already been hashed,
