  32:Cpp_Core/Src/firmware/firmware_manager.cpp **** 
  33:Cpp_Core/Src/firmware/firmware_manager.cpp **** static bool decode_sha256(const char encoded[65], uint8_t decoded[32]) {
  34:Cpp_Core/Src/firmware/firmware_manager.cpp ****     if (encoded == nullptr || decoded == nullptr || encoded[64] != '\0') {
  35:Cpp_Core/Src/firmware/firmware_manager.cpp ****         return false;
  36:Cpp_Core/Src/firmware/firmware_manager.cpp ****     }
  37:Cpp_Core/Src/firmware/firmware_manager.cpp ****     for (size_t i = 0; i < 32; ++i) {
  38:Cpp_Core/Src/firmware/firmware_manager.cpp ****         const int high = decode_hex_digit(encoded[i * 2]);
  39:Cpp_Core/Src/firmware/firmware_manager.cpp ****         const int low = decode_hex_digit(encoded[i * 2 + 1]);
  40:Cpp_Core/Src/firmware/firmware_manager.cpp ****         if (high < 0 || low < 0) return false;
  41:Cpp_Core/Src/firmware/firmware_manager.cpp ****         decoded[i] = static_cast<uint8_t>((high << 4) | low);
  42:Cpp_Core/Src/firmware/firmware_manager.cpp ****     }
  43:Cpp_Core/Src/firmware/firmware_manager.cpp ****     return true;
  44:Cpp_Core/Src/firmware/firmware_manager.cpp **** }
  45:Cpp_Core/Src/firmware/firmware_manager.cpp **** 
  46:Cpp_Core/Src/firmware/firmware_manager.cpp **** static bool constant_time_equal(const uint8_t* left,
  47:Cpp_Core/Src/firmware/firmware_manager.cpp ****                                 const uint8_t* right,
  48:Cpp_Core/Src/firmware/firmware_manager.cpp ****                                 size_t length) {
  49:Cpp_Core/Src/firmware/firmware_manager.cpp ****     uint8_t difference = 0;
  50:Cpp_Core/Src/firmware/firmware_manager.cpp ****     for (size_t i = 0; i < length; ++i) {
  51:Cpp_Core/Src/firmware/firmware_manager.cpp ****         difference |= static_cast<uint8_t>(left[i] ^ right[i]);
  52:Cpp_Core/Src/firmware/firmware_manager.cpp ****     }
  53:Cpp_Core/Src/firmware/firmware_manager.cpp ****     return difference == 0;
  54:Cpp_Core/Src/firmware/firmware_manager.cpp **** }
