2097:Libs/mbedtls/library/ecp.c **** /*
2098:Libs/mbedtls/library/ecp.c ****  * Recode the scalar to get constant-time comb multiplication
2099:Libs/mbedtls/library/ecp.c ****  *
2100:Libs/mbedtls/library/ecp.c ****  * As the actual scalar recoding needs an odd scalar as a starting point,
2101:Libs/mbedtls/library/ecp.c ****  * this wrapper ensures that by replacing m by N - m if necessary, and
2102:Libs/mbedtls/library/ecp.c ****  * informs the caller that the result of multiplication will be negated.
2103:Libs/mbedtls/library/ecp.c ****  *
2104:Libs/mbedtls/library/ecp.c ****  * This works because we only support large prime order for Short Weierstrass
2105:Libs/mbedtls/library/ecp.c ****  * curves, so N is always odd hence either m or N - m is.
2106:Libs/mbedtls/library/ecp.c ****  *
2107:Libs/mbedtls/library/ecp.c ****  * See ecp_comb_recode_core() for background.
2108:Libs/mbedtls/library/ecp.c ****  */
2109:Libs/mbedtls/library/ecp.c **** static int ecp_comb_recode_scalar(const mbedtls_ecp_group *grp,
2110:Libs/mbedtls/library/ecp.c ****                                   const mbedtls_mpi *m,
2111:Libs/mbedtls/library/ecp.c ****                                   unsigned char k[COMB_MAX_D + 1],
2112:Libs/mbedtls/library/ecp.c ****                                   size_t d,
2113:Libs/mbedtls/library/ecp.c ****                                   unsigned char w,
2114:Libs/mbedtls/library/ecp.c ****                                   unsigned char *parity_trick)
2115:Libs/mbedtls/library/ecp.c **** {
2116:Libs/mbedtls/library/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
2117:Libs/mbedtls/library/ecp.c ****     mbedtls_mpi M, mm;
2118:Libs/mbedtls/library/ecp.c **** 
2119:Libs/mbedtls/library/ecp.c ****     mbedtls_mpi_init(&M);
2120:Libs/mbedtls/library/ecp.c ****     mbedtls_mpi_init(&mm);
2121:Libs/mbedtls/library/ecp.c **** 
2122:Libs/mbedtls/library/ecp.c ****     /* N is always odd (see above), just make extra sure */
2123:Libs/mbedtls/library/ecp.c ****     if (mbedtls_mpi_get_bit(&grp->N, 0) != 1) {
2124:Libs/mbedtls/library/ecp.c ****         return MBEDTLS_ERR_ECP_BAD_INPUT_DATA;
2125:Libs/mbedtls/library/ecp.c ****     }
2126:Libs/mbedtls/library/ecp.c **** 
2127:Libs/mbedtls/library/ecp.c ****     /* do we need the parity trick? */
2128:Libs/mbedtls/library/ecp.c ****     *parity_trick = (mbedtls_mpi_get_bit(m, 0) == 0);
2129:Libs/mbedtls/library/ecp.c **** 
2130:Libs/mbedtls/library/ecp.c ****     /* execute parity fix in constant time */
2131:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&M, m));
2132:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_sub_mpi(&mm, &grp->N, m));
2133:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_safe_cond_assign(&M, &mm, *parity_trick));
2134:Libs/mbedtls/library/ecp.c **** 
2135:Libs/mbedtls/library/ecp.c ****     /* actual scalar recoding */
2136:Libs/mbedtls/library/ecp.c ****     ecp_comb_recode_core(k, d, w, &M);
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccQL5QWa.s 			page 130


2137:Libs/mbedtls/library/ecp.c **** 
2138:Libs/mbedtls/library/ecp.c **** cleanup:
2139:Libs/mbedtls/library/ecp.c ****     mbedtls_mpi_free(&mm);
2140:Libs/mbedtls/library/ecp.c ****     mbedtls_mpi_free(&M);
2141:Libs/mbedtls/library/ecp.c **** 
2142:Libs/mbedtls/library/ecp.c ****     return ret;
2143:Libs/mbedtls/library/ecp.c **** }
2144:Libs/mbedtls/library/ecp.c **** 
2145:Libs/mbedtls/library/ecp.c **** /*
2146:Libs/mbedtls/library/ecp.c ****  * Perform comb multiplication (for short Weierstrass curves)
2147:Libs/mbedtls/library/ecp.c ****  * once the auxiliary table has been pre-computed.
2148:Libs/mbedtls/library/ecp.c ****  *
2149:Libs/mbedtls/library/ecp.c ****  * Scalar recoding may use a parity trick that makes us compute -m * P,
2150:Libs/mbedtls/library/ecp.c ****  * if that is the case we'll need to recover m * P at the end.
