  45:Libs/mbedtls/library/bignum.c **** #define ciL    (sizeof(mbedtls_mpi_uint))         /* chars in limb  */
  46:Libs/mbedtls/library/bignum.c **** #define biL    (ciL << 3)               /* bits  in limb  */
  47:Libs/mbedtls/library/bignum.c **** #define biH    (ciL << 2)               /* half limb size */
  48:Libs/mbedtls/library/bignum.c **** 
