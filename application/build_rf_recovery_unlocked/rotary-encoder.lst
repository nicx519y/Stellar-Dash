  69:Src/input/drivers/rotary_encoder/rotary-encoder.c **** {
  70:Src/input/drivers/rotary_encoder/rotary-encoder.c ****     const uint8_t a =
  71:Src/input/drivers/rotary_encoder/rotary-encoder.c ****         (HAL_GPIO_ReadPin(ROTENC_A_PORT, ROTENC_A_PIN) == GPIO_PIN_SET) ? 1u : 0u;
  72:Src/input/drivers/rotary_encoder/rotary-encoder.c ****     const uint8_t b =
  73:Src/input/drivers/rotary_encoder/rotary-encoder.c ****         (HAL_GPIO_ReadPin(ROTENC_B_PORT, ROTENC_B_PIN) == GPIO_PIN_SET) ? 1u : 0u;
  74:Src/input/drivers/rotary_encoder/rotary-encoder.c ****     return (uint8_t)((a << 1) | b);
  75:Src/input/drivers/rotary_encoder/rotary-encoder.c **** }
