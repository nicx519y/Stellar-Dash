 177:Cpp_Core/Src/leds/led_animation.cpp ****     
 178:Cpp_Core/Src/leds/led_animation.cpp ****     // 随机选择
 179:Cpp_Core/Src/leds/led_animation.cpp ****     uint8_t actualCount = (count < availableCount) ? count : availableCount;
 180:Cpp_Core/Src/leds/led_animation.cpp ****     for (uint8_t i = 0; i < actualCount && availableCount > 0; i++) {
 181:Cpp_Core/Src/leds/led_animation.cpp ****         uint8_t randomIndex = rand() % availableCount;
 182:Cpp_Core/Src/leds/led_animation.cpp ****         result[i] = available[randomIndex];
 183:Cpp_Core/Src/leds/led_animation.cpp ****         
 184:Cpp_Core/Src/leds/led_animation.cpp ****         // 移除已选择的按钮
 185:Cpp_Core/Src/leds/led_animation.cpp ****         for (uint8_t j = randomIndex; j < availableCount - 1; j++) {
 186:Cpp_Core/Src/leds/led_animation.cpp ****             available[j] = available[j + 1];
 187:Cpp_Core/Src/leds/led_animation.cpp ****         }
 188:Cpp_Core/Src/leds/led_animation.cpp ****         availableCount--;
 189:Cpp_Core/Src/leds/led_animation.cpp ****     }
 190:Cpp_Core/Src/leds/led_animation.cpp ****     
