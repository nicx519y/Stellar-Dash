 168:Libs/cJSON/cJSON.c **** }
 169:Libs/cJSON/cJSON.c **** static void CJSON_CDECL internal_free(void *pointer)
 170:Libs/cJSON/cJSON.c **** {
 171:Libs/cJSON/cJSON.c ****     free(pointer);
 172:Libs/cJSON/cJSON.c **** }
 173:Libs/cJSON/cJSON.c **** static void * CJSON_CDECL internal_realloc(void *pointer, size_t size)
 174:Libs/cJSON/cJSON.c **** {
 175:Libs/cJSON/cJSON.c ****     return realloc(pointer, size);
 176:Libs/cJSON/cJSON.c **** }
 177:Libs/cJSON/cJSON.c **** #else
 178:Libs/cJSON/cJSON.c **** #define internal_malloc malloc
 179:Libs/cJSON/cJSON.c **** #define internal_free free
 180:Libs/cJSON/cJSON.c **** #define internal_realloc realloc
 181:Libs/cJSON/cJSON.c **** #endif
