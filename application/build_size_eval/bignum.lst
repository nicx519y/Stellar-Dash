 431:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint d;
 432:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi T;
 433:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(X != NULL);
 434:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(s != NULL);
 435:Libs/mbedtls/library/bignum.c **** 
 436:Libs/mbedtls/library/bignum.c ****     if (radix < 2 || radix > 16) {
 437:Libs/mbedtls/library/bignum.c ****         return MBEDTLS_ERR_MPI_BAD_INPUT_DATA;
 438:Libs/mbedtls/library/bignum.c ****     }
 439:Libs/mbedtls/library/bignum.c **** 
 440:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_init(&T);
