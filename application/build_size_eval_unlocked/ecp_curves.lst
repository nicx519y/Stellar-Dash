1016:Libs/mbedtls/library/ecp_curves.c ****         N->p[i] = ~(mbedtls_mpi_uint) 0 - N->p[i];
1017:Libs/mbedtls/library/ecp_curves.c ****     }
1018:Libs/mbedtls/library/ecp_curves.c ****     /* Add 1, taking care of the carry. */
1019:Libs/mbedtls/library/ecp_curves.c ****     i = 0;
1020:Libs/mbedtls/library/ecp_curves.c ****     do {
1021:Libs/mbedtls/library/ecp_curves.c ****         ++N->p[i];
1022:Libs/mbedtls/library/ecp_curves.c ****     } while (N->p[i++] == 0 && i <= bits / 8 / sizeof(mbedtls_mpi_uint));
1023:Libs/mbedtls/library/ecp_curves.c ****     /* Invert the sign.
1024:Libs/mbedtls/library/ecp_curves.c ****      * Now N = N0 - 2^bits where N0 is the initial value of N. */
1025:Libs/mbedtls/library/ecp_curves.c ****     N->s = -1;
1026:Libs/mbedtls/library/ecp_curves.c **** 
1027:Libs/mbedtls/library/ecp_curves.c ****     /* Add |c| * 2^bits to the absolute value. Since c and N are
1028:Libs/mbedtls/library/ecp_curves.c ****      * negative, this adds c * 2^bits. */
