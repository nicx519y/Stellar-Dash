 139:Src/leds/led_animation.cpp **** // 颜色插值函数
 140:Src/leds/led_animation.cpp **** RGBColor lerpColor(const RGBColor& colorA, const RGBColor& colorB, float t) {
 141:Src/leds/led_animation.cpp ****     t = fmaxf(0.0f, fminf(1.0f, t)); // 确保t在0-1范围内
 142:Src/leds/led_animation.cpp ****     
 143:Src/leds/led_animation.cpp ****     RGBColor result;
 144:Src/leds/led_animation.cpp ****     result.r = (uint8_t)(colorA.r * (1.0f - t) + colorB.r * t);
 145:Src/leds/led_animation.cpp ****     result.g = (uint8_t)(colorA.g * (1.0f - t) + colorB.g * t);
 146:Src/leds/led_animation.cpp ****     result.b = (uint8_t)(colorA.b * (1.0f - t) + colorB.b * t);
 147:Src/leds/led_animation.cpp ****     
 148:Src/leds/led_animation.cpp ****     return result;
 149:Src/leds/led_animation.cpp **** }
 150:Src/leds/led_animation.cpp **** 
 151:Src/leds/led_animation.cpp **** // 随机选择不重复的按钮
 152:Src/leds/led_animation.cpp **** static uint8_t selectRandomButtons(uint8_t total, uint8_t count, uint8_t* exclude, uint8_t excludeC
 153:Src/leds/led_animation.cpp ****     uint8_t available[NUM_LED];
 154:Src/leds/led_animation.cpp ****     uint8_t availableCount = 0;
 155:Src/leds/led_animation.cpp ****     
 156:Src/leds/led_animation.cpp ****     // 生成可用按钮列表
 157:Src/leds/led_animation.cpp ****     for (uint8_t i = 0; i < total; i++) {
 158:Src/leds/led_animation.cpp ****         bool isExcluded = false;
 159:Src/leds/led_animation.cpp ****         for (uint8_t j = 0; j < excludeCount; j++) {
 160:Src/leds/led_animation.cpp ****             if (exclude[j] == i) {
 161:Src/leds/led_animation.cpp ****                 isExcluded = true;
 162:Src/leds/led_animation.cpp ****                 break;
 163:Src/leds/led_animation.cpp ****             }
 164:Src/leds/led_animation.cpp ****         }
 165:Src/leds/led_animation.cpp ****         if (!isExcluded) {
 166:Src/leds/led_animation.cpp ****             available[availableCount++] = i;
 167:Src/leds/led_animation.cpp ****         }
 168:Src/leds/led_animation.cpp ****     }
 169:Src/leds/led_animation.cpp ****     
 170:Src/leds/led_animation.cpp ****     // 随机选择
 171:Src/leds/led_animation.cpp ****     uint8_t actualCount = (count < availableCount) ? count : availableCount;
 172:Src/leds/led_animation.cpp ****     for (uint8_t i = 0; i < actualCount && availableCount > 0; i++) {
 173:Src/leds/led_animation.cpp ****         uint8_t randomIndex = rand() % availableCount;
 174:Src/leds/led_animation.cpp ****         result[i] = available[randomIndex];
 175:Src/leds/led_animation.cpp ****         
 176:Src/leds/led_animation.cpp ****         // 移除已选择的按钮
 177:Src/leds/led_animation.cpp ****         for (uint8_t j = randomIndex; j < availableCount - 1; j++) {
 178:Src/leds/led_animation.cpp ****             available[j] = available[j + 1];
 179:Src/leds/led_animation.cpp ****         }
 180:Src/leds/led_animation.cpp ****         availableCount--;
 181:Src/leds/led_animation.cpp ****     }
 182:Src/leds/led_animation.cpp ****     
 183:Src/leds/led_animation.cpp ****     return actualCount;
 184:Src/leds/led_animation.cpp **** }
