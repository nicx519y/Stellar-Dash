  49:Libs/mbedtls/library/gcm.c **** }
  50:Libs/mbedtls/library/gcm.c **** 
  51:Libs/mbedtls/library/gcm.c **** /*
  52:Libs/mbedtls/library/gcm.c ****  * Precompute small multiples of H, that is set
  53:Libs/mbedtls/library/gcm.c ****  *      HH[i] || HL[i] = H times i,
  54:Libs/mbedtls/library/gcm.c ****  * where i is seen as a field element as in [MGV], ie high-order bits
  55:Libs/mbedtls/library/gcm.c ****  * correspond to low powers of P. The result is stored in the same way, that
  56:Libs/mbedtls/library/gcm.c ****  * is the high-order bit of HH corresponds to P^0 and the low-order bit of HL
  57:Libs/mbedtls/library/gcm.c ****  * corresponds to P^127.
  58:Libs/mbedtls/library/gcm.c ****  */
  59:Libs/mbedtls/library/gcm.c **** static int gcm_gen_table(mbedtls_gcm_context *ctx)
  60:Libs/mbedtls/library/gcm.c **** {
  61:Libs/mbedtls/library/gcm.c ****     int ret, i, j;
  62:Libs/mbedtls/library/gcm.c ****     uint64_t hi, lo;
  63:Libs/mbedtls/library/gcm.c ****     uint64_t vl, vh;
  64:Libs/mbedtls/library/gcm.c ****     unsigned char h[16];
  65:Libs/mbedtls/library/gcm.c ****     size_t olen = 0;
  66:Libs/mbedtls/library/gcm.c **** 
  67:Libs/mbedtls/library/gcm.c ****     memset(h, 0, 16);
  68:Libs/mbedtls/library/gcm.c ****     if ((ret = mbedtls_cipher_update(&ctx->cipher_ctx, h, 16, h, &olen)) != 0) {
  69:Libs/mbedtls/library/gcm.c ****         return ret;
  70:Libs/mbedtls/library/gcm.c ****     }
  71:Libs/mbedtls/library/gcm.c **** 
  72:Libs/mbedtls/library/gcm.c ****     /* pack h as two 64-bits ints, big-endian */
  73:Libs/mbedtls/library/gcm.c ****     hi = MBEDTLS_GET_UINT32_BE(h,  0);
  74:Libs/mbedtls/library/gcm.c ****     lo = MBEDTLS_GET_UINT32_BE(h,  4);
  75:Libs/mbedtls/library/gcm.c ****     vh = (uint64_t) hi << 32 | lo;
  76:Libs/mbedtls/library/gcm.c **** 
  77:Libs/mbedtls/library/gcm.c ****     hi = MBEDTLS_GET_UINT32_BE(h,  8);
  78:Libs/mbedtls/library/gcm.c ****     lo = MBEDTLS_GET_UINT32_BE(h,  12);
  79:Libs/mbedtls/library/gcm.c ****     vl = (uint64_t) hi << 32 | lo;
  80:Libs/mbedtls/library/gcm.c **** 
  81:Libs/mbedtls/library/gcm.c ****     /* 8 = 1000 corresponds to 1 in GF(2^128) */
  82:Libs/mbedtls/library/gcm.c ****     ctx->HL[8] = vl;
  83:Libs/mbedtls/library/gcm.c ****     ctx->HH[8] = vh;
  84:Libs/mbedtls/library/gcm.c **** 
  85:Libs/mbedtls/library/gcm.c **** #if defined(MBEDTLS_AESNI_HAVE_CODE)
  86:Libs/mbedtls/library/gcm.c ****     /* With CLMUL support, we need only h, not the rest of the table */
  87:Libs/mbedtls/library/gcm.c ****     if (mbedtls_aesni_has_support(MBEDTLS_AESNI_CLMUL)) {
  88:Libs/mbedtls/library/gcm.c ****         return 0;
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccEjJvNp.s 			page 3


  89:Libs/mbedtls/library/gcm.c ****     }
  90:Libs/mbedtls/library/gcm.c **** #endif
  91:Libs/mbedtls/library/gcm.c **** 
  92:Libs/mbedtls/library/gcm.c ****     /* 0 corresponds to 0 in GF(2^128) */
  93:Libs/mbedtls/library/gcm.c ****     ctx->HH[0] = 0;
  94:Libs/mbedtls/library/gcm.c ****     ctx->HL[0] = 0;
  95:Libs/mbedtls/library/gcm.c **** 
  96:Libs/mbedtls/library/gcm.c ****     for (i = 4; i > 0; i >>= 1) {
  97:Libs/mbedtls/library/gcm.c ****         uint32_t T = (vl & 1) * 0xe1000000U;
  98:Libs/mbedtls/library/gcm.c ****         vl  = (vh << 63) | (vl >> 1);
  99:Libs/mbedtls/library/gcm.c ****         vh  = (vh >> 1) ^ ((uint64_t) T << 32);
 100:Libs/mbedtls/library/gcm.c **** 
 101:Libs/mbedtls/library/gcm.c ****         ctx->HL[i] = vl;
 102:Libs/mbedtls/library/gcm.c ****         ctx->HH[i] = vh;
 103:Libs/mbedtls/library/gcm.c ****     }
 104:Libs/mbedtls/library/gcm.c **** 
 105:Libs/mbedtls/library/gcm.c ****     for (i = 2; i <= 8; i *= 2) {
 106:Libs/mbedtls/library/gcm.c ****         uint64_t *HiL = ctx->HL + i, *HiH = ctx->HH + i;
 107:Libs/mbedtls/library/gcm.c ****         vh = *HiH;
 108:Libs/mbedtls/library/gcm.c ****         vl = *HiL;
 109:Libs/mbedtls/library/gcm.c ****         for (j = 1; j < i; j++) {
 110:Libs/mbedtls/library/gcm.c ****             HiH[j] = vh ^ ctx->HH[j];
 111:Libs/mbedtls/library/gcm.c ****             HiL[j] = vl ^ ctx->HL[j];
 112:Libs/mbedtls/library/gcm.c ****         }
 113:Libs/mbedtls/library/gcm.c ****     }
 114:Libs/mbedtls/library/gcm.c **** 
 115:Libs/mbedtls/library/gcm.c ****     return 0;
 116:Libs/mbedtls/library/gcm.c **** }
 117:Libs/mbedtls/library/gcm.c **** 
 118:Libs/mbedtls/library/gcm.c **** int mbedtls_gcm_setkey(mbedtls_gcm_context *ctx,
 119:Libs/mbedtls/library/gcm.c ****                        mbedtls_cipher_id_t cipher,
 120:Libs/mbedtls/library/gcm.c ****                        const unsigned char *key,
 121:Libs/mbedtls/library/gcm.c ****                        unsigned int keybits)
 122:Libs/mbedtls/library/gcm.c **** {
 123:Libs/mbedtls/library/gcm.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
 124:Libs/mbedtls/library/gcm.c ****     const mbedtls_cipher_info_t *cipher_info;
 125:Libs/mbedtls/library/gcm.c **** 
 126:Libs/mbedtls/library/gcm.c ****     GCM_VALIDATE_RET(ctx != NULL);
 127:Libs/mbedtls/library/gcm.c ****     GCM_VALIDATE_RET(key != NULL);
 128:Libs/mbedtls/library/gcm.c ****     GCM_VALIDATE_RET(keybits == 128 || keybits == 192 || keybits == 256);
 129:Libs/mbedtls/library/gcm.c **** 
 130:Libs/mbedtls/library/gcm.c ****     cipher_info = mbedtls_cipher_info_from_values(cipher, keybits,
 131:Libs/mbedtls/library/gcm.c ****                                                   MBEDTLS_MODE_ECB);
 132:Libs/mbedtls/library/gcm.c ****     if (cipher_info == NULL) {
 133:Libs/mbedtls/library/gcm.c ****         return MBEDTLS_ERR_GCM_BAD_INPUT;
 134:Libs/mbedtls/library/gcm.c ****     }
 135:Libs/mbedtls/library/gcm.c **** 
 136:Libs/mbedtls/library/gcm.c ****     if (cipher_info->block_size != 16) {
 137:Libs/mbedtls/library/gcm.c ****         return MBEDTLS_ERR_GCM_BAD_INPUT;
 138:Libs/mbedtls/library/gcm.c ****     }
 139:Libs/mbedtls/library/gcm.c **** 
 140:Libs/mbedtls/library/gcm.c ****     mbedtls_cipher_free(&ctx->cipher_ctx);
 141:Libs/mbedtls/library/gcm.c **** 
 142:Libs/mbedtls/library/gcm.c ****     if ((ret = mbedtls_cipher_setup(&ctx->cipher_ctx, cipher_info)) != 0) {
 143:Libs/mbedtls/library/gcm.c ****         return ret;
 144:Libs/mbedtls/library/gcm.c ****     }
 145:Libs/mbedtls/library/gcm.c **** 
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccEjJvNp.s 			page 4


 146:Libs/mbedtls/library/gcm.c ****     if ((ret = mbedtls_cipher_setkey(&ctx->cipher_ctx, key, keybits,
 147:Libs/mbedtls/library/gcm.c ****                                      MBEDTLS_ENCRYPT)) != 0) {
 148:Libs/mbedtls/library/gcm.c ****         return ret;
 149:Libs/mbedtls/library/gcm.c ****     }
 150:Libs/mbedtls/library/gcm.c **** 
 151:Libs/mbedtls/library/gcm.c ****     if ((ret = gcm_gen_table(ctx)) != 0) {
 152:Libs/mbedtls/library/gcm.c ****         return ret;
 153:Libs/mbedtls/library/gcm.c ****     }
 154:Libs/mbedtls/library/gcm.c **** 
 155:Libs/mbedtls/library/gcm.c ****     return 0;
 156:Libs/mbedtls/library/gcm.c **** }
 157:Libs/mbedtls/library/gcm.c **** 
 158:Libs/mbedtls/library/gcm.c **** /*
 159:Libs/mbedtls/library/gcm.c ****  * Shoup's method for multiplication use this table with
 160:Libs/mbedtls/library/gcm.c ****  *      last4[x] = x times P^128
 161:Libs/mbedtls/library/gcm.c ****  * where x and last4[x] are seen as elements of GF(2^128) as in [MGV]
 162:Libs/mbedtls/library/gcm.c ****  */
 163:Libs/mbedtls/library/gcm.c **** static const uint64_t last4[16] =
 164:Libs/mbedtls/library/gcm.c **** {
 165:Libs/mbedtls/library/gcm.c ****     0x0000, 0x1c20, 0x3840, 0x2460,
 166:Libs/mbedtls/library/gcm.c ****     0x7080, 0x6ca0, 0x48c0, 0x54e0,
 167:Libs/mbedtls/library/gcm.c ****     0xe100, 0xfd20, 0xd940, 0xc560,
 168:Libs/mbedtls/library/gcm.c ****     0x9180, 0x8da0, 0xa9c0, 0xb5e0
 169:Libs/mbedtls/library/gcm.c **** };
