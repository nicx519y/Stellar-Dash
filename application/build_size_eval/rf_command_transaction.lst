 113:Cpp_Core/Src/rf_command_transaction.cpp ****     const uint16_t expectedLen = static_cast<uint16_t>(3u + payloadLen + 1u);
 114:Cpp_Core/Src/rf_command_transaction.cpp ****     if ((expectedLen != frameLen) ||
 115:Cpp_Core/Src/rf_command_transaction.cpp ****         (checksum8(frame, static_cast<uint16_t>(frameLen - 1u)) != frame[frameLen - 1u])) {
