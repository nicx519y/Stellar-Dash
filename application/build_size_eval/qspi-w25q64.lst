  55:Drivers/QSPI-W25Q64/qspi-w25q64.c **** /*
  56:Drivers/QSPI-W25Q64/qspi-w25q64.c ****  * Blocking QUADSPI automatic polling keeps the peripheral BUSY until the
  57:Drivers/QSPI-W25Q64/qspi-w25q64.c ****  * status-match flag is raised. If that match is missed, the HAL timeout can
  58:Drivers/QSPI-W25Q64/qspi-w25q64.c ****  * itself be starved by unrelated high-frequency interrupts. Use short,
  59:Drivers/QSPI-W25Q64/qspi-w25q64.c ****  * individually bounded indirect status reads so the peripheral returns to
  60:Drivers/QSPI-W25Q64/qspi-w25q64.c ****  * READY between polls and the caller always retains control.
  61:Drivers/QSPI-W25Q64/qspi-w25q64.c ****  */
  62:Drivers/QSPI-W25Q64/qspi-w25q64.c **** #define W25Qxx_READY_TIMEOUT_MS        HAL_QSPI_TIMEOUT_DEFAULT_VALUE
