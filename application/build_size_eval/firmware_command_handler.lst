 107:Cpp_Core/Src/configs/firmware_command_handler.cpp **** DeviceCommandResponse FirmwareCommandHandler::handle(const DeviceCommandRequest& request) {
 108:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     const std::string& command = request.getCommand();
 109:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     
 110:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     if (command == "get_device_auth") {
 111:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleGetDeviceAuth(request);
 112:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "get_firmware_metadata") {
 113:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleGetFirmwareMetadata(request);
 114:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "create_firmware_upgrade_session") {
 115:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleCreateFirmwareUpgradeSession(request);
 116:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "upload_firmware_chunk") {
 117:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleUploadFirmwareChunk(request);
 118:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "complete_firmware_upgrade_session") {
 119:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleCompleteFirmwareUpgradeSession(request);
 120:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "abort_firmware_upgrade_session") {
 121:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleAbortFirmwareUpgradeSession(request);
 122:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "get_firmware_upgrade_status") {
 123:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleGetFirmwareUpgradeStatus(request);
 124:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "cleanup_firmware_upgrade_session") {
 125:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleCleanupFirmwareUpgradeSession(request);
 126:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "ch585_update_status") {
 127:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleCh585UpdateStatus(request);
 128:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "ch585_update_begin") {
 129:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleCh585UpdateBegin(request);
 130:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "ch585_update_chunk") {
 131:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleCh585UpdateChunk(request);
 132:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     } else if (command == "ch585_update_complete") {
 133:Cpp_Core/Src/configs/firmware_command_handler.cpp ****         return handleCh585UpdateComplete(request);
 134:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     }
 135:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     
 136:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     // 未知命令
 137:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     LOG_WARN("DeviceCommand", "FirmwareCommandHandler: Unknown command: %s", command.c_str());
 138:Cpp_Core/Src/configs/firmware_command_handler.cpp ****     return create_error_response(request.getCid(), command, -1, "Unknown firmware command");
 139:Cpp_Core/Src/configs/firmware_command_handler.cpp **** }
