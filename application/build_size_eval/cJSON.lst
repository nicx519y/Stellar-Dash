 298:Libs/cJSON/cJSON.c **** /* check if the given size is left to read in a given parse buffer (starting with 1) */
 299:Libs/cJSON/cJSON.c **** #define can_read(buffer, size) ((buffer != NULL) && (((buffer)->offset + size) <= (buffer)->length)
 300:Libs/cJSON/cJSON.c **** /* check if the buffer can be accessed at the given index (starting with 0) */
 301:Libs/cJSON/cJSON.c **** #define can_access_at_index(buffer, index) ((buffer != NULL) && (((buffer)->offset + index) < (buff
 302:Libs/cJSON/cJSON.c **** #define cannot_access_at_index(buffer, index) (!can_access_at_index(buffer, index))
 303:Libs/cJSON/cJSON.c **** /* get a pointer to the buffer at the position */
 304:Libs/cJSON/cJSON.c **** #define buffer_at_offset(buffer) ((buffer)->content + (buffer)->offset)
 305:Libs/cJSON/cJSON.c **** 
 306:Libs/cJSON/cJSON.c **** /* Parse the input text to generate a number, and populate the result into item. */
 307:Libs/cJSON/cJSON.c **** static cJSON_bool parse_number(cJSON * const item, parse_buffer * const input_buffer)
 308:Libs/cJSON/cJSON.c **** {
 309:Libs/cJSON/cJSON.c ****     double number = 0;
 310:Libs/cJSON/cJSON.c ****     unsigned char *after_end = NULL;
 311:Libs/cJSON/cJSON.c ****     unsigned char number_c_string[64];
 312:Libs/cJSON/cJSON.c ****     unsigned char decimal_point = get_decimal_point();
 313:Libs/cJSON/cJSON.c ****     size_t i = 0;
 314:Libs/cJSON/cJSON.c **** 
 315:Libs/cJSON/cJSON.c ****     if ((input_buffer == NULL) || (input_buffer->content == NULL))
 316:Libs/cJSON/cJSON.c ****     {
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccWtILFT.s 			page 7


 317:Libs/cJSON/cJSON.c ****         return false;
 318:Libs/cJSON/cJSON.c ****     }
 319:Libs/cJSON/cJSON.c **** 
 320:Libs/cJSON/cJSON.c ****     /* copy the number into a temporary buffer and replace '.' with the decimal point
 321:Libs/cJSON/cJSON.c ****      * of the current locale (for strtod)
 322:Libs/cJSON/cJSON.c ****      * This also takes care of '\0' not necessarily being available for marking the end of the inpu
 323:Libs/cJSON/cJSON.c ****     for (i = 0; (i < (sizeof(number_c_string) - 1)) && can_access_at_index(input_buffer, i); i++)
 324:Libs/cJSON/cJSON.c ****     {
 325:Libs/cJSON/cJSON.c ****         switch (buffer_at_offset(input_buffer)[i])
 326:Libs/cJSON/cJSON.c ****         {
 327:Libs/cJSON/cJSON.c ****             case '0':
 328:Libs/cJSON/cJSON.c ****             case '1':
 329:Libs/cJSON/cJSON.c ****             case '2':
 330:Libs/cJSON/cJSON.c ****             case '3':
