1946:Libs/mbedtls/library/bignum.c ****         mpi_mul_hlp(m, B->p, d, u0);
1947:Libs/mbedtls/library/bignum.c ****         mpi_mul_hlp(n, N->p, d, u1);
1948:Libs/mbedtls/library/bignum.c **** 
1949:Libs/mbedtls/library/bignum.c ****         *d++ = u0; d[n + 1] = 0;
1950:Libs/mbedtls/library/bignum.c ****     }
1951:Libs/mbedtls/library/bignum.c **** 
1952:Libs/mbedtls/library/bignum.c ****     /* At this point, d is either the desired result or the desired result
1953:Libs/mbedtls/library/bignum.c ****      * plus N. We now potentially subtract N, avoiding leaking whether the
1954:Libs/mbedtls/library/bignum.c ****      * subtraction is performed through side channels. */
1955:Libs/mbedtls/library/bignum.c **** 
1956:Libs/mbedtls/library/bignum.c ****     /* Copy the n least significant limbs of d to A, so that
1957:Libs/mbedtls/library/bignum.c ****      * A = d if d < N (recall that N has n limbs). */
1958:Libs/mbedtls/library/bignum.c ****     memcpy(A->p, d, n * ciL);
