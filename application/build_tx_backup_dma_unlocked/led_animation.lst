 425:Src/leds/led_animation.cpp ****     }
 426:Src/leds/led_animation.cpp ****     
 427:Src/leds/led_animation.cpp ****     // 计算该按钮被经过的总次数
 428:Src/leds/led_animation.cpp ****     bool hasBeenPassed = transformPassedPositions[params.index] == 1;
 429:Src/leds/led_animation.cpp ****     uint32_t totalPasses = transformCycleCount + (hasBeenPassed ? 1 : 0);
 430:Src/leds/led_animation.cpp ****     bool isOddPasses = (totalPasses % 2) == 1;
 431:Src/leds/led_animation.cpp ****     
 432:Src/leds/led_animation.cpp ****     // 确定该按钮当前应该显示的基础颜色（经过后永久改变）
 433:Src/leds/led_animation.cpp ****     RGBColor buttonBaseColor = isOddPasses ? params.backColor2 : params.backColor1;
 434:Src/leds/led_animation.cpp ****     RGBColor buttonAltColor = isOddPasses ? params.backColor1 : params.backColor2;
 435:Src/leds/led_animation.cpp ****     
 436:Src/leds/led_animation.cpp ****     // 计算渐变区域
 437:Src/leds/led_animation.cpp ****     float leftEdge = centerX - bandWidth / 2.0f;
 438:Src/leds/led_animation.cpp ****     float rightEdge = centerX + bandWidth / 2.0f;
 439:Src/leds/led_animation.cpp ****     
 440:Src/leds/led_animation.cpp ****     RGBColor color;
 441:Src/leds/led_animation.cpp ****     
 442:Src/leds/led_animation.cpp ****     if (btnX < leftEdge) {
 443:Src/leds/led_animation.cpp ****         // 左侧区域：使用该按钮的基础颜色
 444:Src/leds/led_animation.cpp ****         color = buttonBaseColor;
 445:Src/leds/led_animation.cpp ****     } else if (btnX > rightEdge) {
 446:Src/leds/led_animation.cpp ****         // 右侧区域：使用该按钮的基础颜色
 447:Src/leds/led_animation.cpp ****         color = buttonBaseColor;
 448:Src/leds/led_animation.cpp ****     } else {
 449:Src/leds/led_animation.cpp ****         // 渐变区域：从替代颜色渐变到基础颜色
 450:Src/leds/led_animation.cpp ****         float t = (btnX - leftEdge) / bandWidth; // 0~1
