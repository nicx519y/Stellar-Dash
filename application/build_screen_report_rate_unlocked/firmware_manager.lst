  43:Src/firmware/firmware_manager.cpp ****         const int high = decode_hex_digit(encoded[i * 2]);
  44:Src/firmware/firmware_manager.cpp ****         const int low = decode_hex_digit(encoded[i * 2 + 1]);
  45:Src/firmware/firmware_manager.cpp ****         if (high < 0 || low < 0) return false;
  46:Src/firmware/firmware_manager.cpp ****         decoded[i] = static_cast<uint8_t>((high << 4) | low);
  47:Src/firmware/firmware_manager.cpp ****     }
  48:Src/firmware/firmware_manager.cpp ****     return true;
  49:Src/firmware/firmware_manager.cpp **** }
