  75:Cpp_Core/Src/gamepad/GamepadState.cpp ****  * @param dpad The GameState.dpad value.
  76:Cpp_Core/Src/gamepad/GamepadState.cpp ****  * @return uint8_t The new dpad value.
  77:Cpp_Core/Src/gamepad/GamepadState.cpp ****  */
  78:Cpp_Core/Src/gamepad/GamepadState.cpp **** uint8_t filterToFourWayMode(uint8_t dpad)
  79:Cpp_Core/Src/gamepad/GamepadState.cpp **** {
  80:Cpp_Core/Src/gamepad/GamepadState.cpp **** 	updateDpad(dpad, DIRECTION_UP);
  81:Cpp_Core/Src/gamepad/GamepadState.cpp **** 	updateDpad(dpad, DIRECTION_DOWN);
  82:Cpp_Core/Src/gamepad/GamepadState.cpp **** 	updateDpad(dpad, DIRECTION_LEFT);
  83:Cpp_Core/Src/gamepad/GamepadState.cpp **** 	return updateDpad(dpad, DIRECTION_RIGHT);
  84:Cpp_Core/Src/gamepad/GamepadState.cpp **** }
