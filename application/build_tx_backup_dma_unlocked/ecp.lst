1576:Libs/mbedtls/library/ecp.c **** /*
1577:Libs/mbedtls/library/ecp.c ****  * Addition: R = P + Q, mixed affine-Jacobian coordinates (GECC 3.22)
1578:Libs/mbedtls/library/ecp.c ****  *
1579:Libs/mbedtls/library/ecp.c ****  * The coordinates of Q must be normalized (= affine),
1580:Libs/mbedtls/library/ecp.c ****  * but those of P don't need to. R is not normalized.
1581:Libs/mbedtls/library/ecp.c ****  *
1582:Libs/mbedtls/library/ecp.c ****  * Special cases: (1) P or Q is zero, (2) R is zero, (3) P == Q.
1583:Libs/mbedtls/library/ecp.c ****  * None of these cases can happen as intermediate step in ecp_mul_comb():
1584:Libs/mbedtls/library/ecp.c ****  * - at each step, P, Q and R are multiples of the base point, the factor
1585:Libs/mbedtls/library/ecp.c ****  *   being less than its order, so none of them is zero;
1586:Libs/mbedtls/library/ecp.c ****  * - Q is an odd multiple of the base point, P an even multiple,
1587:Libs/mbedtls/library/ecp.c ****  *   due to the choice of precomputed points in the modified comb method.
1588:Libs/mbedtls/library/ecp.c ****  * So branches for these cases do not leak secret information.
1589:Libs/mbedtls/library/ecp.c ****  *
1590:Libs/mbedtls/library/ecp.c ****  * We accept Q->Z being unset (saving memory in tables) as meaning 1.
1591:Libs/mbedtls/library/ecp.c ****  *
1592:Libs/mbedtls/library/ecp.c ****  * Cost: 1A := 8M + 3S
1593:Libs/mbedtls/library/ecp.c ****  */
1594:Libs/mbedtls/library/ecp.c **** static int ecp_add_mixed(const mbedtls_ecp_group *grp, mbedtls_ecp_point *R,
1595:Libs/mbedtls/library/ecp.c ****                          const mbedtls_ecp_point *P, const mbedtls_ecp_point *Q)
1596:Libs/mbedtls/library/ecp.c **** {
1597:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_SELF_TEST)
1598:Libs/mbedtls/library/ecp.c ****     add_count++;
1599:Libs/mbedtls/library/ecp.c **** #endif
1600:Libs/mbedtls/library/ecp.c **** 
1601:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_ECP_ADD_MIXED_ALT)
1602:Libs/mbedtls/library/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
1603:Libs/mbedtls/library/ecp.c ****         return mbedtls_internal_ecp_add_mixed(grp, R, P, Q);
1604:Libs/mbedtls/library/ecp.c ****     }
1605:Libs/mbedtls/library/ecp.c **** #endif /* MBEDTLS_ECP_ADD_MIXED_ALT */
1606:Libs/mbedtls/library/ecp.c **** 
1607:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_ADD_MIXED_ALT)
