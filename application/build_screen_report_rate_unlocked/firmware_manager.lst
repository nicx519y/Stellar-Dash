  38:Src/firmware/firmware_manager.cpp **** static bool decode_sha256(const char encoded[65], uint8_t decoded[32]) {
  39:Src/firmware/firmware_manager.cpp ****     if (encoded == nullptr || decoded == nullptr || encoded[64] != '\0') {
  40:Src/firmware/firmware_manager.cpp ****         return false;
  41:Src/firmware/firmware_manager.cpp ****     }
