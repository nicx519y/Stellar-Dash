 547:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     /* A previous asynchronous HAL stop could leave the channel in ERROR/BUSY.
 548:Drivers/PWM-WS2812B/pwm-ws2812b.c ****      * Normalize only this strip's DMA/channel before retrying; the other TIM4
 549:Drivers/PWM-WS2812B/pwm-ws2812b.c ****      * channel is deliberately left untouched. */
 550:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     if (*st == WS2812B_ERROR) {
 551:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         DMA_HandleTypeDef* recoveryDma = strip_dma_handle(strip);
