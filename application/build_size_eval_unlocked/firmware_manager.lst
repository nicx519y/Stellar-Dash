 170:Cpp_Core/Src/firmware/firmware_manager.cpp ****     // 7. 验证CRC32校验和（与bootloader保持一致的计算方法）
 171:Cpp_Core/Src/firmware/firmware_manager.cpp ****     const uint8_t* data = (const uint8_t*)metadata;
 172:Cpp_Core/Src/firmware/firmware_manager.cpp ****     size_t skip_offset = offsetof(FirmwareMetadata, metadata_crc32);
 173:Cpp_Core/Src/firmware/firmware_manager.cpp ****     size_t skip_size = sizeof(uint32_t);
 174:Cpp_Core/Src/firmware/firmware_manager.cpp ****     
 175:Cpp_Core/Src/firmware/firmware_manager.cpp ****     // 使用与bootloader相同的跳过字段方法
 176:Cpp_Core/Src/firmware/firmware_manager.cpp ****     uint32_t calculated_crc = 0xFFFFFFFF;
 177:Cpp_Core/Src/firmware/firmware_manager.cpp ****     
 178:Cpp_Core/Src/firmware/firmware_manager.cpp ****     for (size_t i = 0; i < METADATA_STRUCT_SIZE; i++) {
 179:Cpp_Core/Src/firmware/firmware_manager.cpp ****         // 跳过指定区域（CRC32字段本身）
 180:Cpp_Core/Src/firmware/firmware_manager.cpp ****         if (i >= skip_offset && i < skip_offset + skip_size) {
 181:Cpp_Core/Src/firmware/firmware_manager.cpp ****             continue;
 182:Cpp_Core/Src/firmware/firmware_manager.cpp ****         }
