  99:Libs/mbedtls/library/ecp.c **** /*
 100:Libs/mbedtls/library/ecp.c ****  * Counts of point addition and doubling, and field multiplications.
 101:Libs/mbedtls/library/ecp.c ****  * Used to test resistance of point multiplication to simple timing attacks.
 102:Libs/mbedtls/library/ecp.c ****  */
 103:Libs/mbedtls/library/ecp.c **** static unsigned long add_count, dbl_count, mul_count;
 104:Libs/mbedtls/library/ecp.c **** #endif
 105:Libs/mbedtls/library/ecp.c **** 
 106:Libs/mbedtls/library/ecp.c **** #if !defined(MBEDTLS_ECP_NO_INTERNAL_RNG)
 107:Libs/mbedtls/library/ecp.c **** /*
 108:Libs/mbedtls/library/ecp.c ****  * Currently ecp_mul() takes a RNG function as an argument, used for
 109:Libs/mbedtls/library/ecp.c ****  * side-channel protection, but it can be NULL. The initial reasoning was
 110:Libs/mbedtls/library/ecp.c ****  * that people will pass non-NULL RNG when they care about side-channels, but
 111:Libs/mbedtls/library/ecp.c ****  * unfortunately we have some APIs that call ecp_mul() with a NULL RNG, with
 112:Libs/mbedtls/library/ecp.c ****  * no opportunity for the user to do anything about it.
 113:Libs/mbedtls/library/ecp.c ****  *
 114:Libs/mbedtls/library/ecp.c ****  * The obvious strategies for addressing that include:
 115:Libs/mbedtls/library/ecp.c ****  * - change those APIs so that they take RNG arguments;
 116:Libs/mbedtls/library/ecp.c ****  * - require a global RNG to be available to all crypto modules.
 117:Libs/mbedtls/library/ecp.c ****  *
 118:Libs/mbedtls/library/ecp.c ****  * Unfortunately those would break compatibility. So what we do instead is
 119:Libs/mbedtls/library/ecp.c ****  * have our own internal DRBG instance, seeded from the secret scalar.
 120:Libs/mbedtls/library/ecp.c ****  *
 121:Libs/mbedtls/library/ecp.c ****  * The following is a light-weight abstraction layer for doing that with
 122:Libs/mbedtls/library/ecp.c ****  * HMAC_DRBG (first choice) or CTR_DRBG.
 123:Libs/mbedtls/library/ecp.c ****  */
 124:Libs/mbedtls/library/ecp.c **** 
 125:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_HMAC_DRBG_C)
 126:Libs/mbedtls/library/ecp.c **** 
 127:Libs/mbedtls/library/ecp.c **** /* DRBG context type */
 128:Libs/mbedtls/library/ecp.c **** typedef mbedtls_hmac_drbg_context ecp_drbg_context;
 129:Libs/mbedtls/library/ecp.c **** 
 130:Libs/mbedtls/library/ecp.c **** /* DRBG context init */
 131:Libs/mbedtls/library/ecp.c **** static inline void ecp_drbg_init(ecp_drbg_context *ctx)
 132:Libs/mbedtls/library/ecp.c **** {
 133:Libs/mbedtls/library/ecp.c ****     mbedtls_hmac_drbg_init(ctx);
 134:Libs/mbedtls/library/ecp.c **** }
 135:Libs/mbedtls/library/ecp.c **** 
 136:Libs/mbedtls/library/ecp.c **** /* DRBG context free */
 137:Libs/mbedtls/library/ecp.c **** static inline void ecp_drbg_free(ecp_drbg_context *ctx)
 138:Libs/mbedtls/library/ecp.c **** {
 139:Libs/mbedtls/library/ecp.c ****     mbedtls_hmac_drbg_free(ctx);
 140:Libs/mbedtls/library/ecp.c **** }
 141:Libs/mbedtls/library/ecp.c **** 
 142:Libs/mbedtls/library/ecp.c **** /* DRBG function */
 143:Libs/mbedtls/library/ecp.c **** static inline int ecp_drbg_random(void *p_rng,
 144:Libs/mbedtls/library/ecp.c ****                                   unsigned char *output, size_t output_len)
 145:Libs/mbedtls/library/ecp.c **** {
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccosdxRQ.s 			page 4


 146:Libs/mbedtls/library/ecp.c ****     return mbedtls_hmac_drbg_random(p_rng, output, output_len);
 147:Libs/mbedtls/library/ecp.c **** }
 148:Libs/mbedtls/library/ecp.c **** 
 149:Libs/mbedtls/library/ecp.c **** /* DRBG context seeding */
 150:Libs/mbedtls/library/ecp.c **** static int ecp_drbg_seed(ecp_drbg_context *ctx,
 151:Libs/mbedtls/library/ecp.c ****                          const mbedtls_mpi *secret, size_t secret_len)
 152:Libs/mbedtls/library/ecp.c **** {
 153:Libs/mbedtls/library/ecp.c ****     int ret;
 154:Libs/mbedtls/library/ecp.c ****     unsigned char secret_bytes[MBEDTLS_ECP_MAX_BYTES];
 155:Libs/mbedtls/library/ecp.c ****     /* The list starts with strong hashes */
 156:Libs/mbedtls/library/ecp.c ****     const mbedtls_md_type_t md_type =
 157:Libs/mbedtls/library/ecp.c ****         (mbedtls_md_type_t) (mbedtls_md_list()[0]);
 158:Libs/mbedtls/library/ecp.c ****     const mbedtls_md_info_t *md_info = mbedtls_md_info_from_type(md_type);
 159:Libs/mbedtls/library/ecp.c **** 
 160:Libs/mbedtls/library/ecp.c ****     if (secret_len > MBEDTLS_ECP_MAX_BYTES) {
 161:Libs/mbedtls/library/ecp.c ****         ret = MBEDTLS_ERR_ECP_RANDOM_FAILED;
 162:Libs/mbedtls/library/ecp.c ****         goto cleanup;
 163:Libs/mbedtls/library/ecp.c ****     }
 164:Libs/mbedtls/library/ecp.c **** 
 165:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(secret,
 166:Libs/mbedtls/library/ecp.c ****                                              secret_bytes, secret_len));
 167:Libs/mbedtls/library/ecp.c **** 
 168:Libs/mbedtls/library/ecp.c ****     ret = mbedtls_hmac_drbg_seed_buf(ctx, md_info, secret_bytes, secret_len);
 169:Libs/mbedtls/library/ecp.c **** 
 170:Libs/mbedtls/library/ecp.c **** cleanup:
 171:Libs/mbedtls/library/ecp.c ****     mbedtls_platform_zeroize(secret_bytes, secret_len);
 172:Libs/mbedtls/library/ecp.c **** 
 173:Libs/mbedtls/library/ecp.c ****     return ret;
 174:Libs/mbedtls/library/ecp.c **** }
 175:Libs/mbedtls/library/ecp.c **** 
 176:Libs/mbedtls/library/ecp.c **** #elif defined(MBEDTLS_CTR_DRBG_C)
 177:Libs/mbedtls/library/ecp.c **** 
 178:Libs/mbedtls/library/ecp.c **** /* DRBG context type */
 179:Libs/mbedtls/library/ecp.c **** typedef mbedtls_ctr_drbg_context ecp_drbg_context;
 180:Libs/mbedtls/library/ecp.c **** 
 181:Libs/mbedtls/library/ecp.c **** /* DRBG context init */
 182:Libs/mbedtls/library/ecp.c **** static inline void ecp_drbg_init(ecp_drbg_context *ctx)
 183:Libs/mbedtls/library/ecp.c **** {
 184:Libs/mbedtls/library/ecp.c ****     mbedtls_ctr_drbg_init(ctx);
 185:Libs/mbedtls/library/ecp.c **** }
 186:Libs/mbedtls/library/ecp.c **** 
 187:Libs/mbedtls/library/ecp.c **** /* DRBG context free */
 188:Libs/mbedtls/library/ecp.c **** static inline void ecp_drbg_free(ecp_drbg_context *ctx)
 189:Libs/mbedtls/library/ecp.c **** {
 190:Libs/mbedtls/library/ecp.c ****     mbedtls_ctr_drbg_free(ctx);
 191:Libs/mbedtls/library/ecp.c **** }
 192:Libs/mbedtls/library/ecp.c **** 
 193:Libs/mbedtls/library/ecp.c **** /* DRBG function */
 194:Libs/mbedtls/library/ecp.c **** static inline int ecp_drbg_random(void *p_rng,
 195:Libs/mbedtls/library/ecp.c ****                                   unsigned char *output, size_t output_len)
 196:Libs/mbedtls/library/ecp.c **** {
 197:Libs/mbedtls/library/ecp.c ****     return mbedtls_ctr_drbg_random(p_rng, output, output_len);
 198:Libs/mbedtls/library/ecp.c **** }
 199:Libs/mbedtls/library/ecp.c **** 
 200:Libs/mbedtls/library/ecp.c **** /*
 201:Libs/mbedtls/library/ecp.c ****  * Since CTR_DRBG doesn't have a seed_buf() function the way HMAC_DRBG does,
 202:Libs/mbedtls/library/ecp.c ****  * we need to pass an entropy function when seeding. So we use a dummy
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccosdxRQ.s 			page 5


 203:Libs/mbedtls/library/ecp.c ****  * function for that, and pass the actual entropy as customisation string.
 204:Libs/mbedtls/library/ecp.c ****  * (During seeding of CTR_DRBG the entropy input and customisation string are
 205:Libs/mbedtls/library/ecp.c ****  * concatenated before being used to update the secret state.)
 206:Libs/mbedtls/library/ecp.c ****  */
 207:Libs/mbedtls/library/ecp.c **** static int ecp_ctr_drbg_null_entropy(void *ctx, unsigned char *out, size_t len)
 208:Libs/mbedtls/library/ecp.c **** {
 209:Libs/mbedtls/library/ecp.c ****     (void) ctx;
 210:Libs/mbedtls/library/ecp.c ****     memset(out, 0, len);
 211:Libs/mbedtls/library/ecp.c ****     return 0;
 212:Libs/mbedtls/library/ecp.c **** }
 213:Libs/mbedtls/library/ecp.c **** 
 214:Libs/mbedtls/library/ecp.c **** /* DRBG context seeding */
 215:Libs/mbedtls/library/ecp.c **** static int ecp_drbg_seed(ecp_drbg_context *ctx,
 216:Libs/mbedtls/library/ecp.c ****                          const mbedtls_mpi *secret, size_t secret_len)
 217:Libs/mbedtls/library/ecp.c **** {
 218:Libs/mbedtls/library/ecp.c ****     int ret;
 219:Libs/mbedtls/library/ecp.c ****     unsigned char secret_bytes[MBEDTLS_ECP_MAX_BYTES];
 220:Libs/mbedtls/library/ecp.c **** 
 221:Libs/mbedtls/library/ecp.c ****     if (secret_len > MBEDTLS_ECP_MAX_BYTES) {
 222:Libs/mbedtls/library/ecp.c ****         ret = MBEDTLS_ERR_ECP_RANDOM_FAILED;
 223:Libs/mbedtls/library/ecp.c ****         goto cleanup;
 224:Libs/mbedtls/library/ecp.c ****     }
 225:Libs/mbedtls/library/ecp.c **** 
 226:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_write_binary(secret,
 227:Libs/mbedtls/library/ecp.c ****                                              secret_bytes, secret_len));
 228:Libs/mbedtls/library/ecp.c **** 
 229:Libs/mbedtls/library/ecp.c ****     ret = mbedtls_ctr_drbg_seed(ctx, ecp_ctr_drbg_null_entropy, NULL,
 230:Libs/mbedtls/library/ecp.c ****                                 secret_bytes, secret_len);
 231:Libs/mbedtls/library/ecp.c **** 
 232:Libs/mbedtls/library/ecp.c **** cleanup:
 233:Libs/mbedtls/library/ecp.c ****     mbedtls_platform_zeroize(secret_bytes, secret_len);
 234:Libs/mbedtls/library/ecp.c **** 
 235:Libs/mbedtls/library/ecp.c ****     return ret;
 236:Libs/mbedtls/library/ecp.c **** }
