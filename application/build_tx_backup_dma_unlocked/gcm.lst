 158:Libs/mbedtls/library/gcm.c **** /*
 159:Libs/mbedtls/library/gcm.c ****  * Shoup's method for multiplication use this table with
 160:Libs/mbedtls/library/gcm.c ****  *      last4[x] = x times P^128
 161:Libs/mbedtls/library/gcm.c ****  * where x and last4[x] are seen as elements of GF(2^128) as in [MGV]
 162:Libs/mbedtls/library/gcm.c ****  */
 163:Libs/mbedtls/library/gcm.c **** static const uint64_t last4[16] =
 164:Libs/mbedtls/library/gcm.c **** {
 165:Libs/mbedtls/library/gcm.c ****     0x0000, 0x1c20, 0x3840, 0x2460,
 166:Libs/mbedtls/library/gcm.c ****     0x7080, 0x6ca0, 0x48c0, 0x54e0,
 167:Libs/mbedtls/library/gcm.c ****     0xe100, 0xfd20, 0xd940, 0xc560,
 168:Libs/mbedtls/library/gcm.c ****     0x9180, 0x8da0, 0xa9c0, 0xb5e0
 169:Libs/mbedtls/library/gcm.c **** };
