 806:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** #endif
 807:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** 
 808:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****       typedef _Deque_base<_Tp, _Alloc>			_Base;
 809:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****       typedef typename _Base::_Tp_alloc_type		_Tp_alloc_type;
