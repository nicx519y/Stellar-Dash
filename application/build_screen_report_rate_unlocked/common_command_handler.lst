 225:Src/webconfig/configs/common_command_handler.cpp ****         return handleStartButtonMonitoring(request);
 226:Src/webconfig/configs/common_command_handler.cpp ****     } else if (command == "stop_button_monitoring") {
 227:Src/webconfig/configs/common_command_handler.cpp ****         return handleStopButtonMonitoring(request);
 228:Src/webconfig/configs/common_command_handler.cpp ****     } else if (command == "start_button_performance_monitoring") {
 229:Src/webconfig/configs/common_command_handler.cpp ****         return handleStartButtonPerformanceMonitoring(request);
 230:Src/webconfig/configs/common_command_handler.cpp ****     } else if (command == "stop_button_performance_monitoring") {
 231:Src/webconfig/configs/common_command_handler.cpp ****         return handleStopButtonPerformanceMonitoring(request);
 232:Src/webconfig/configs/common_command_handler.cpp ****     } else if (command == "get_device_logs_list") {
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\cciDITJH.s 			page 147


 233:Src/webconfig/configs/common_command_handler.cpp ****         return handleGetDeviceLogsList(request);
