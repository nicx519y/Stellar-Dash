  59:Drivers/I2C-BQ25895/bq25895.c **** /*
  60:Drivers/I2C-BQ25895/bq25895.c ****  * Safe 1S2P / 8000 mAh common charging profile.  Input current and VINDPM
  61:Drivers/I2C-BQ25895/bq25895.c ****  * are selected separately after VBUS ADC identifies a 5 V or 9 V source.
  62:Drivers/I2C-BQ25895/bq25895.c ****  * BQ25895 DPDM/MaxCharge and ICO are disabled because the board's USB-C/PD
  63:Drivers/I2C-BQ25895/bq25895.c ****  * negotiation is owned by CH224A and BQ25895 D+/D- are not connected.
  64:Drivers/I2C-BQ25895/bq25895.c ****  *
  65:Drivers/I2C-BQ25895/bq25895.c ****  * Common profile:
  66:Drivers/I2C-BQ25895/bq25895.c ****  *   ICHG 1.6 A
  67:Drivers/I2C-BQ25895/bq25895.c ****  *   IPRECHG 256 mA, ITERM 64 mA
  68:Drivers/I2C-BQ25895/bq25895.c ****  *   VREG 4.192 V, BATLOWV 3.0 V, VRECHG 100 mV
  69:Drivers/I2C-BQ25895/bq25895.c ****  *   watchdog disabled, termination enabled, 8-hour safety timer
  70:Drivers/I2C-BQ25895/bq25895.c ****  *   BAT_COMP/VCLAMP disabled, TREG 80 C
  71:Drivers/I2C-BQ25895/bq25895.c ****  */
  72:Drivers/I2C-BQ25895/bq25895.c **** static const BQ25895_ProfileField k_safe_common_profile[] = {
  73:Drivers/I2C-BQ25895/bq25895.c ****     {BQ_REG_ADC_CONTROL, 0x1Du, 0x00u},
  74:Drivers/I2C-BQ25895/bq25895.c ****     {BQ_REG_CHARGE_CURRENT, 0xFFu, 0x19u},
  75:Drivers/I2C-BQ25895/bq25895.c ****     {BQ_REG_PRECHARGE_TERM_CURRENT, 0xFFu, 0x30u},
  76:Drivers/I2C-BQ25895/bq25895.c ****     {BQ_REG_CHARGE_VOLTAGE, 0xFFu, 0x5Au},
  77:Drivers/I2C-BQ25895/bq25895.c ****     {BQ_REG_TIMER_CONTROL, 0xBEu, 0x8Au},
  78:Drivers/I2C-BQ25895/bq25895.c ****     {BQ_REG_IR_THERMAL_CONTROL, 0xFFu, 0x01u},
  79:Drivers/I2C-BQ25895/bq25895.c **** };
  80:Drivers/I2C-BQ25895/bq25895.c **** 
