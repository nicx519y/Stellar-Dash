  27:Libs/mbedtls/library/platform_util.c **** /*
  28:Libs/mbedtls/library/platform_util.c ****  * This implementation should never be optimized out by the compiler
  29:Libs/mbedtls/library/platform_util.c ****  *
  30:Libs/mbedtls/library/platform_util.c ****  * This implementation for mbedtls_platform_zeroize() was inspired from Colin
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccNLFS1X.s 			page 2


  31:Libs/mbedtls/library/platform_util.c ****  * Percival's blog article at:
  32:Libs/mbedtls/library/platform_util.c ****  *
  33:Libs/mbedtls/library/platform_util.c ****  * http://www.daemonology.net/blog/2014-09-04-how-to-zero-a-buffer.html
  34:Libs/mbedtls/library/platform_util.c ****  *
  35:Libs/mbedtls/library/platform_util.c ****  * It uses a volatile function pointer to the standard memset(). Because the
  36:Libs/mbedtls/library/platform_util.c ****  * pointer is volatile the compiler expects it to change at
  37:Libs/mbedtls/library/platform_util.c ****  * any time and will not optimize out the call that could potentially perform
  38:Libs/mbedtls/library/platform_util.c ****  * other operations on the input buffer instead of just setting it to 0.
  39:Libs/mbedtls/library/platform_util.c ****  * Nevertheless, as pointed out by davidtgoldblatt on Hacker News
  40:Libs/mbedtls/library/platform_util.c ****  * (refer to http://www.daemonology.net/blog/2014-09-05-erratum.html for
  41:Libs/mbedtls/library/platform_util.c ****  * details), optimizations of the following form are still possible:
  42:Libs/mbedtls/library/platform_util.c ****  *
  43:Libs/mbedtls/library/platform_util.c ****  * if( memset_func != memset )
  44:Libs/mbedtls/library/platform_util.c ****  *     memset_func( buf, 0, len );
  45:Libs/mbedtls/library/platform_util.c ****  *
  46:Libs/mbedtls/library/platform_util.c ****  * Note that it is extremely difficult to guarantee that
  47:Libs/mbedtls/library/platform_util.c ****  * mbedtls_platform_zeroize() will not be optimized out by aggressive compilers
  48:Libs/mbedtls/library/platform_util.c ****  * in a portable way. For this reason, Mbed TLS also provides the configuration
  49:Libs/mbedtls/library/platform_util.c ****  * option MBEDTLS_PLATFORM_ZEROIZE_ALT, which allows users to configure
  50:Libs/mbedtls/library/platform_util.c ****  * mbedtls_platform_zeroize() to use a suitable implementation for their
  51:Libs/mbedtls/library/platform_util.c ****  * platform and needs.
  52:Libs/mbedtls/library/platform_util.c ****  */
  53:Libs/mbedtls/library/platform_util.c **** static void *(*const volatile memset_func)(void *, int, size_t) = memset;
  54:Libs/mbedtls/library/platform_util.c **** 
  55:Libs/mbedtls/library/platform_util.c **** void mbedtls_platform_zeroize(void *buf, size_t len)
  56:Libs/mbedtls/library/platform_util.c **** {
