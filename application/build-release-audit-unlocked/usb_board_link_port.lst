 583:Src/transport/usb/usb_board_link_port.cpp ****     if (!USBBoardLinkPort_HasEvent() && !USBBoardLinkPort_Send(request, requestLength)) return fals
 584:Src/transport/usb/usb_board_link_port.cpp ****     while (HAL_GetTick() - started < budget) {
 585:Src/transport/usb/usb_board_link_port.cpp ****         if (!USBBoardLinkPort_HasEvent()) { HAL_Delay(1u); continue; }
 586:Src/transport/usb/usb_board_link_port.cpp ****         // ROLE_SELECTED is six bytes. Allow the existing small scan prefix,
