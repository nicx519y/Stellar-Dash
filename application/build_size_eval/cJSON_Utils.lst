 392:Libs/cJSON/cJSON_Utils.c **** /* non-broken cJSON_DetachItemFromArray */
 393:Libs/cJSON/cJSON_Utils.c **** static cJSON *detach_item_from_array(cJSON *array, size_t which)
 394:Libs/cJSON/cJSON_Utils.c **** {
 395:Libs/cJSON/cJSON_Utils.c ****     cJSON *c = array->child;
 396:Libs/cJSON/cJSON_Utils.c ****     while (c && (which > 0))
 397:Libs/cJSON/cJSON_Utils.c ****     {
 398:Libs/cJSON/cJSON_Utils.c ****         c = c->next;
 399:Libs/cJSON/cJSON_Utils.c ****         which--;
 400:Libs/cJSON/cJSON_Utils.c ****     }
 401:Libs/cJSON/cJSON_Utils.c ****     if (!c)
 402:Libs/cJSON/cJSON_Utils.c ****     {
 403:Libs/cJSON/cJSON_Utils.c ****         /* item doesn't exist */
 404:Libs/cJSON/cJSON_Utils.c ****         return NULL;
 405:Libs/cJSON/cJSON_Utils.c ****     }
 406:Libs/cJSON/cJSON_Utils.c ****     if (c != array->child)
 407:Libs/cJSON/cJSON_Utils.c ****     {
 408:Libs/cJSON/cJSON_Utils.c ****         /* not the first element */
 409:Libs/cJSON/cJSON_Utils.c ****         c->prev->next = c->next;
 410:Libs/cJSON/cJSON_Utils.c ****     }
 411:Libs/cJSON/cJSON_Utils.c ****     if (c->next)
 412:Libs/cJSON/cJSON_Utils.c ****     {
 413:Libs/cJSON/cJSON_Utils.c ****         c->next->prev = c->prev;
 414:Libs/cJSON/cJSON_Utils.c ****     }
 415:Libs/cJSON/cJSON_Utils.c ****     if (c == array->child)
 416:Libs/cJSON/cJSON_Utils.c ****     {
 417:Libs/cJSON/cJSON_Utils.c ****         array->child = c->next;
 418:Libs/cJSON/cJSON_Utils.c ****     }
 419:Libs/cJSON/cJSON_Utils.c ****     else if (c->next == NULL)
 420:Libs/cJSON/cJSON_Utils.c ****     {
