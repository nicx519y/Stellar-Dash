  11:Inc/webconfig/configs/firmware_command_handler.hpp **** #pragma pack(push, 1)
  12:Inc/webconfig/configs/firmware_command_handler.hpp **** struct BinaryFirmwareChunkHeader {
  13:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint8_t command;                    // 命令类型 (BINARY_CMD_UPLOAD_FIRMWARE_CHUNK)
  14:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint8_t reserved1;                  // 保留字节，用于对齐
  15:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint16_t session_id_len;            // session_id字符串长度
  16:Inc/webconfig/configs/firmware_command_handler.hpp ****     char session_id[32];                // session_id字符串（固定32字节，不足补0）
  17:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint16_t component_name_len;        // component_name字符串长度  
  18:Inc/webconfig/configs/firmware_command_handler.hpp ****     char component_name[16];            // component_name字符串（固定16字节，不足补0）
  19:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint32_t chunk_index;               // 分片索引
  20:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint32_t total_chunks;              // 总分片数
  21:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint32_t chunk_size;                // 分片大小
  22:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint32_t chunk_offset;              // 分片偏移
  23:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint32_t target_address;            // 目标地址
  24:Inc/webconfig/configs/firmware_command_handler.hpp ****     uint8_t checksum[32];               // 完整SHA256校验和
  25:Inc/webconfig/configs/firmware_command_handler.hpp **** };
  26:Inc/webconfig/configs/firmware_command_handler.hpp **** #pragma pack(pop)
  27:Inc/webconfig/configs/firmware_command_handler.hpp **** static_assert(sizeof(BinaryFirmwareChunkHeader) == 106,
