 554:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         }
 555:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         TIM_CHANNEL_STATE_SET(
 556:Drivers/PWM-WS2812B/pwm-ws2812b.c ****             &htim4, strip_tim_channel(strip), HAL_TIM_CHANNEL_STATE_READY);
 557:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         *st = WS2812B_STOP;
 558:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     }
