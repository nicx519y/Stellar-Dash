 158:Cpp_Core/Src/leds/leds_manager.cpp **** void LEDsManager::refreshDefaultProfile()
 159:Cpp_Core/Src/leds/leds_manager.cpp **** {
 160:Cpp_Core/Src/leds/leds_manager.cpp ****     if (usingTemporaryConfig) return;
 161:Cpp_Core/Src/leds/leds_manager.cpp **** 
 162:Cpp_Core/Src/leds/leds_manager.cpp ****     const bool shouldRestart = runtimeEnabled;
 163:Cpp_Core/Src/leds/leds_manager.cpp ****     opts = &STORAGE_MANAGER.getDefaultGamepadProfile()->ledsConfigs;
 164:Cpp_Core/Src/leds/leds_manager.cpp ****     const bool* enabledKeys = STORAGE_MANAGER.getDefaultGamepadProfile()->keysConfig.keysEnableTag;
 165:Cpp_Core/Src/leds/leds_manager.cpp ****     enabledKeysMask = 0;
 166:Cpp_Core/Src/leds/leds_manager.cpp ****     for(uint8_t i = 0; i < 32; i++) {
 167:Cpp_Core/Src/leds/leds_manager.cpp ****         if(i < NUM_ADC_BUTTONS) {
 168:Cpp_Core/Src/leds/leds_manager.cpp ****             enabledKeysMask |= (enabledKeys[i] ? (1 << i) : 0);
 169:Cpp_Core/Src/leds/leds_manager.cpp ****         } else {
 170:Cpp_Core/Src/leds/leds_manager.cpp ****             enabledKeysMask |= (1 << i);
 171:Cpp_Core/Src/leds/leds_manager.cpp ****         }
 172:Cpp_Core/Src/leds/leds_manager.cpp ****     }
 173:Cpp_Core/Src/leds/leds_manager.cpp **** 
 174:Cpp_Core/Src/leds/leds_manager.cpp ****     if (shouldRestart) {
 175:Cpp_Core/Src/leds/leds_manager.cpp ****         deinit();
 176:Cpp_Core/Src/leds/leds_manager.cpp ****         setup();
 177:Cpp_Core/Src/leds/leds_manager.cpp ****     }
 178:Cpp_Core/Src/leds/leds_manager.cpp **** }
