 185:Src/webconfig/configs/profile_command_handler.cpp **** uint32_t ProfileCommandHandler::getKeyMappingVirtualMask(cJSON* keyMappingJSON) {
 186:Src/webconfig/configs/profile_command_handler.cpp ****     if(!keyMappingJSON || !cJSON_IsArray(keyMappingJSON)) {
 187:Src/webconfig/configs/profile_command_handler.cpp ****         return 0;
 188:Src/webconfig/configs/profile_command_handler.cpp ****     }
 189:Src/webconfig/configs/profile_command_handler.cpp **** 
 190:Src/webconfig/configs/profile_command_handler.cpp ****     uint32_t virtualMask = 0;
 191:Src/webconfig/configs/profile_command_handler.cpp ****     cJSON* item = NULL;
 192:Src/webconfig/configs/profile_command_handler.cpp ****     cJSON_ArrayForEach(item, keyMappingJSON) {
 193:Src/webconfig/configs/profile_command_handler.cpp ****         if (!item || !cJSON_IsNumber(item)) continue;
 194:Src/webconfig/configs/profile_command_handler.cpp ****         int idx = (int)cJSON_GetNumberValue(item);
