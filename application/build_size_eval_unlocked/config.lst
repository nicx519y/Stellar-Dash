  28:Cpp_Core/Src/config.cpp **** /*
  29:Cpp_Core/Src/config.cpp ****  * Power-loss-safe configuration journal.
  30:Cpp_Core/Src/config.cpp ****  *
  31:Cpp_Core/Src/config.cpp ****  * APP_CONFIG and the currently unused LOG_STORAGE regions form two independent
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\cc3HR1p3.s 			page 2


  32:Cpp_Core/Src/config.cpp ****  * 64 KiB banks. A bank only becomes visible after the payload write completes
  33:Cpp_Core/Src/config.cpp ****  * and the commit word is programmed in a separate final page-program
  34:Cpp_Core/Src/config.cpp ****  * operation. Until then the previously committed bank remains authoritative.
  35:Cpp_Core/Src/config.cpp ****  *
  36:Cpp_Core/Src/config.cpp ****  * The payload deliberately remains the native Config image so existing config
  37:Cpp_Core/Src/config.cpp ****  * version migrations still apply after the journal layer selects a bank.
  38:Cpp_Core/Src/config.cpp ****  */
  39:Cpp_Core/Src/config.cpp **** #define CONFIG_BANK_A_ADDR           CONFIG_ADDR_ORIGIN
  40:Cpp_Core/Src/config.cpp **** #define CONFIG_BANK_B_ADDR           LOG_STORAGE_ADDR
  41:Cpp_Core/Src/config.cpp **** #define CONFIG_BANK_SIZE             (64u * 1024u)
