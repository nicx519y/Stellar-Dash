 184:Src/firmware/ch585_firmware_update.cpp **** static bool writeWithoutErase(uint32_t address,
 185:Src/firmware/ch585_firmware_update.cpp ****                               const uint8_t* data,
 186:Src/firmware/ch585_firmware_update.cpp ****                               uint32_t length)
 187:Src/firmware/ch585_firmware_update.cpp **** {
 188:Src/firmware/ch585_firmware_update.cpp ****     const uint32_t mappedAddress = 0x90000000u | flashOffset(address);
 189:Src/firmware/ch585_firmware_update.cpp ****     const uint32_t originalLength = length;
 190:Src/firmware/ch585_firmware_update.cpp ****     address = flashOffset(address);
 191:Src/firmware/ch585_firmware_update.cpp ****     const bool wasMapped = QSPI_W25Qxx_IsMemoryMappedMode();
 192:Src/firmware/ch585_firmware_update.cpp ****     if (wasMapped && QSPI_W25Qxx_ExitMemoryMappedMode() != QSPI_W25Qxx_OK) {
 193:Src/firmware/ch585_firmware_update.cpp ****         return false;
 194:Src/firmware/ch585_firmware_update.cpp ****     }
 195:Src/firmware/ch585_firmware_update.cpp ****     bool ok = true;
 196:Src/firmware/ch585_firmware_update.cpp ****     while (length != 0u) {
 197:Src/firmware/ch585_firmware_update.cpp ****         const uint32_t pageRemaining = 256u - (address & 0xFFu);
 198:Src/firmware/ch585_firmware_update.cpp ****         const uint16_t chunk = static_cast<uint16_t>(
 199:Src/firmware/ch585_firmware_update.cpp ****             length < pageRemaining ? length : pageRemaining);
 200:Src/firmware/ch585_firmware_update.cpp ****         if (QSPI_W25Qxx_WritePage(const_cast<uint8_t*>(data), address, chunk) !=
 201:Src/firmware/ch585_firmware_update.cpp ****             QSPI_W25Qxx_OK) {
 202:Src/firmware/ch585_firmware_update.cpp ****             ok = false;
 203:Src/firmware/ch585_firmware_update.cpp ****             break;
 204:Src/firmware/ch585_firmware_update.cpp ****         }
 205:Src/firmware/ch585_firmware_update.cpp ****         address += chunk;
 206:Src/firmware/ch585_firmware_update.cpp ****         data += chunk;
 207:Src/firmware/ch585_firmware_update.cpp ****         length -= chunk;
 208:Src/firmware/ch585_firmware_update.cpp ****     }
 209:Src/firmware/ch585_firmware_update.cpp ****     if (wasMapped && QSPI_W25Qxx_EnterMemoryMappedMode() != QSPI_W25Qxx_OK) {
 210:Src/firmware/ch585_firmware_update.cpp ****         ok = false;
 211:Src/firmware/ch585_firmware_update.cpp ****     } else if (wasMapped) {
 212:Src/firmware/ch585_firmware_update.cpp ****         invalidateMappedRange(mappedAddress, originalLength);
 213:Src/firmware/ch585_firmware_update.cpp ****     }
 214:Src/firmware/ch585_firmware_update.cpp ****     return ok;
 215:Src/firmware/ch585_firmware_update.cpp **** }
