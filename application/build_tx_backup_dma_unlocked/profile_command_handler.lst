 196:Src/webconfig/configs/profile_command_handler.cpp ****         virtualMask |= (1u << (uint32_t)idx);
 197:Src/webconfig/configs/profile_command_handler.cpp ****     }
 198:Src/webconfig/configs/profile_command_handler.cpp ****     return virtualMask;
