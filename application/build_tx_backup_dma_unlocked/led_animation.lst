 452:Src/leds/led_animation.cpp ****         float smoothT = t * t * (3.0f - 2.0f * t);
 453:Src/leds/led_animation.cpp ****         color = lerpColor(buttonAltColor, buttonBaseColor, smoothT);
 454:Src/leds/led_animation.cpp ****     }
