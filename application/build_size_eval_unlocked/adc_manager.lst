 809:Cpp_Core/Src/adc_btns/adc_manager.cpp **** /**
 810:Cpp_Core/Src/adc_btns/adc_manager.cpp ****  * @brief 删除映射
 811:Cpp_Core/Src/adc_btns/adc_manager.cpp ****  * @param id 映射ID
 812:Cpp_Core/Src/adc_btns/adc_manager.cpp ****  * @return 是否删除成功
 813:Cpp_Core/Src/adc_btns/adc_manager.cpp ****  */
 814:Cpp_Core/Src/adc_btns/adc_manager.cpp **** ADCBtnsError ADCManager::removeADCMapping(const char *id)
 815:Cpp_Core/Src/adc_btns/adc_manager.cpp **** {
 816:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     if (!id)
 817:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         return ADCBtnsError::INVALID_PARAMS;
 818:Cpp_Core/Src/adc_btns/adc_manager.cpp **** 
 819:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     // 查找要删除的映射索引
 820:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     int8_t targetIdx = findMappingById(id);
 821:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     if (targetIdx == -1)
 822:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         return ADCBtnsError::MAPPING_NOT_FOUND;
 823:Cpp_Core/Src/adc_btns/adc_manager.cpp **** 
 824:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     // 如果只有一个映射，则不能删除
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccmbU5nf.s 			page 308


 825:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     if (store.num <= 1)
 826:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         return ADCBtnsError::MAPPING_DELETE_FAILED;
 827:Cpp_Core/Src/adc_btns/adc_manager.cpp **** 
 828:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     // A dangling default id makes calibration and the INPUT worker unusable.
 829:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     // Require callers to select another default before deleting this mapping.
 830:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     if (getDefaultMapping() == id)
 831:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         return ADCBtnsError::MAPPING_DELETE_FAILED;
 832:Cpp_Core/Src/adc_btns/adc_manager.cpp **** 
 833:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     ADCValuesMapping removedMapping = store.mapping[targetIdx];
 834:Cpp_Core/Src/adc_btns/adc_manager.cpp **** 
 835:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     // 移动数据
 836:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     if (targetIdx < store.num - 1)
 837:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     {
 838:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         memmove(&store.mapping[targetIdx],
 839:Cpp_Core/Src/adc_btns/adc_manager.cpp ****                 &store.mapping[targetIdx + 1],
 840:Cpp_Core/Src/adc_btns/adc_manager.cpp ****                 (store.num - targetIdx - 1) * sizeof(ADCValuesMapping));
 841:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     }
 842:Cpp_Core/Src/adc_btns/adc_manager.cpp **** 
 843:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     store.num--;
 844:Cpp_Core/Src/adc_btns/adc_manager.cpp **** 
 845:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     // 保存更新后的存储结构
 846:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     if (saveStore() != QSPI_W25Qxx_OK)
 847:Cpp_Core/Src/adc_btns/adc_manager.cpp ****     {
 848:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         if (targetIdx < store.num)
 849:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         {
 850:Cpp_Core/Src/adc_btns/adc_manager.cpp ****             memmove(&store.mapping[targetIdx + 1],
 851:Cpp_Core/Src/adc_btns/adc_manager.cpp ****                     &store.mapping[targetIdx],
 852:Cpp_Core/Src/adc_btns/adc_manager.cpp ****                     (store.num - targetIdx) * sizeof(ADCValuesMapping));
 853:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         }
 854:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         store.mapping[targetIdx] = removedMapping;
 855:Cpp_Core/Src/adc_btns/adc_manager.cpp ****         store.num++;
