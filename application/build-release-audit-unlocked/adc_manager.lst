 816:Src/input/adc_btns/adc_manager.cpp ****     int8_t targetIdx = findMappingById(id);
 817:Src/input/adc_btns/adc_manager.cpp ****     if (targetIdx == -1)
 818:Src/input/adc_btns/adc_manager.cpp ****         return ADCBtnsError::MAPPING_NOT_FOUND;
 819:Src/input/adc_btns/adc_manager.cpp **** 
