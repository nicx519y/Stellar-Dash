  68:Src/firmware/firmware_manager.cpp **** // CRC32查找表（全局定义，供所有CRC32函数使用）
  69:Src/firmware/firmware_manager.cpp **** // Metadata is only 807 bytes. The bitwise equivalent avoids retaining a 1 KiB
  70:Src/firmware/firmware_manager.cpp **** // lookup table in AXI SRAM, leaving room for the whole-release installer.
  71:Src/firmware/firmware_manager.cpp **** static uint32_t metadata_crc_byte(uint32_t crc, uint8_t byte) {
  72:Src/firmware/firmware_manager.cpp ****     crc ^= byte;
  73:Src/firmware/firmware_manager.cpp ****     for (unsigned bit=0; bit<8; ++bit)
  74:Src/firmware/firmware_manager.cpp ****         crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
  75:Src/firmware/firmware_manager.cpp ****     return crc;
  76:Src/firmware/firmware_manager.cpp **** }
