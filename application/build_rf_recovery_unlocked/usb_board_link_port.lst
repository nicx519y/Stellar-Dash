  38:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kSpiTimeoutMs = 5u;
  39:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kReadGapMs = 1u;
  40:Src/transport/usb/usb_board_link_port.cpp **** /* This is a deadline, not pacing: return as soon as RX-ready is observed.
  41:Src/transport/usb/usb_board_link_port.cpp ****  * DMA direction changes during PREPARE must finish before another command. */
  42:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kEventReleaseTimeoutMs = 20u;
  43:Src/transport/usb/usb_board_link_port.cpp **** /*
  44:Src/transport/usb/usb_board_link_port.cpp ****  * PA12 rising-edge handling on CH585 is the RX rearm boundary.  A concurrent
  45:Src/transport/usb/usb_board_link_port.cpp ****  * USBHS ISR can delay that edge handler, so bootstrap, CAPS, and IAP retain
  46:Src/transport/usb/usb_board_link_port.cpp ****  * the proven 200-us ownership guard.  After CAPS explicitly advertises the
  47:Src/transport/usb/usb_board_link_port.cpp ****  * fast-data-plane contract, Application input frames use a fixed 20-us guard;
  48:Src/transport/usb/usb_board_link_port.cpp ****  * CH585 still performs its second NSS sample before the DMA direction switch.
  49:Src/transport/usb/usb_board_link_port.cpp ****  */
  50:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kOwnershipGuardSlowUs = 200u;
  51:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kOwnershipGuardFastUs = 20u;
  52:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kExpectedSpiClockHz = 120000000u;
  53:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kFastSpiPrescaler = 8u;
  54:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kInputFrameBytes =
  55:Src/transport/usb/usb_board_link_port.cpp ****     USB_BOARD_INPUT_V1_BYTES + USB_BOARD_LINK_HEADER_BYTES +
  56:Src/transport/usb/usb_board_link_port.cpp ****     USB_BOARD_LINK_CHECKSUM_BYTES;
  57:Src/transport/usb/usb_board_link_port.cpp **** static constexpr uint32_t kInputFrameWireUs =
  58:Src/transport/usb/usb_board_link_port.cpp ****     ((kInputFrameBytes * 8u * kFastSpiPrescaler * 1000000u) +
  59:Src/transport/usb/usb_board_link_port.cpp ****      kExpectedSpiClockHz - 1u) / kExpectedSpiClockHz;
  60:Src/transport/usb/usb_board_link_port.cpp **** static_assert(kOwnershipGuardFastUs + kInputFrameWireUs <= 50u,
  61:Src/transport/usb/usb_board_link_port.cpp ****               "fast BoardLink input frame exceeds the 50-us NSS budget");
  62:Src/transport/usb/usb_board_link_port.cpp **** static_assert(kOwnershipGuardFastUs + kInputFrameWireUs < 125u,
  63:Src/transport/usb/usb_board_link_port.cpp ****               "fast BoardLink input frame cannot fit an 8-kHz period");
