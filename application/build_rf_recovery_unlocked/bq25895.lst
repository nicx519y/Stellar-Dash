  74:Src/power/drivers/bq25895/bq25895.c ****     {BQ_REG_CHARGE_CURRENT, 0xFFu, 0x19u},
  75:Src/power/drivers/bq25895/bq25895.c ****     {BQ_REG_PRECHARGE_TERM_CURRENT, 0xFFu, 0x30u},
  76:Src/power/drivers/bq25895/bq25895.c ****     {BQ_REG_CHARGE_VOLTAGE, 0xFFu, 0x5Au},
  77:Src/power/drivers/bq25895/bq25895.c ****     {BQ_REG_TIMER_CONTROL, 0xBEu, 0x8Au},
  78:Src/power/drivers/bq25895/bq25895.c ****     {BQ_REG_IR_THERMAL_CONTROL, 0xFFu, 0x01u},
