 462:Libs/mbedtls/library/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_lset(X, 0));
 463:Libs/mbedtls/library/bignum.c **** 
 464:Libs/mbedtls/library/bignum.c ****         for (i = slen, j = 0; i > 0; i--, j++) {
 465:Libs/mbedtls/library/bignum.c ****             MBEDTLS_MPI_CHK(mpi_get_digit(&d, radix, s[i - 1]));
