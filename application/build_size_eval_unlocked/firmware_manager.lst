 146:Cpp_Core/Src/firmware/firmware_manager.cpp ****         APP_ERR("FirmwareManager::validate_firmware_metadata: Invalid device model");
 147:Cpp_Core/Src/firmware/firmware_manager.cpp ****         return FIRMWARE_INVALID_DEVICE;
