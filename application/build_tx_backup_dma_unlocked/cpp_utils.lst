 100:Src/support/cpp_utils.cpp **** void safe_add_string_to_object(cJSON* obj, const char* key, const char* value) {
 101:Src/support/cpp_utils.cpp ****     if (!obj || !key || !value) return;
 102:Src/support/cpp_utils.cpp ****     
 103:Src/support/cpp_utils.cpp ****     std::string str_value(value);
 104:Src/support/cpp_utils.cpp ****     if (!is_valid_utf8(str_value.c_str())) {
 105:Src/support/cpp_utils.cpp ****         LOG_WARN("UTILS", "Invalid UTF-8 detected in string '%s', attempting to fix", key);
 106:Src/support/cpp_utils.cpp ****         str_value = fix_utf8_string(str_value);
 107:Src/support/cpp_utils.cpp ****         if (!is_valid_utf8(str_value.c_str())) {
 108:Src/support/cpp_utils.cpp ****             LOG_ERROR("UTILS", "Failed to fix UTF-8 encoding for key '%s', using fallback", key);
 109:Src/support/cpp_utils.cpp ****             // 如果修复失败，使用ASCII字符替换
 110:Src/support/cpp_utils.cpp ****             std::string fallback;
 111:Src/support/cpp_utils.cpp ****             for (char c : str_value) {
 112:Src/support/cpp_utils.cpp ****                 if (c >= 32 && c <= 126) {
 113:Src/support/cpp_utils.cpp ****                     fallback += c;
 114:Src/support/cpp_utils.cpp ****                 } else {
 115:Src/support/cpp_utils.cpp ****                     fallback += '?';
 116:Src/support/cpp_utils.cpp ****                 }
 117:Src/support/cpp_utils.cpp ****             }
 118:Src/support/cpp_utils.cpp ****             str_value = fallback;
 119:Src/support/cpp_utils.cpp ****         }
 120:Src/support/cpp_utils.cpp ****     }
 121:Src/support/cpp_utils.cpp ****     
 122:Src/support/cpp_utils.cpp ****     cJSON_AddStringToObject(obj, key, str_value.c_str());
 123:Src/support/cpp_utils.cpp **** }
