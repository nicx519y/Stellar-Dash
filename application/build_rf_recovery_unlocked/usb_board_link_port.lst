 411:../common/usb_board_link_protocol.h **** /*
 412:../common/usb_board_link_protocol.h ****  * Credits are receiver-owned absolute values, not deltas:
 413:../common/usb_board_link_protocol.h ****  * - CMD_BULK_CREDIT grants CH585 permission to emit 0x86 fragments.
 414:../common/usb_board_link_protocol.h ****  * - EVT_BULK_CREDIT grants STM32 permission to emit 0x06 traffic on non-
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccnbUnJe.s 			page 120


 415:../common/usb_board_link_protocol.h ****  *   WebConfig channels.
