   9:../common/tx_image_bulk.h **** /* SPI-only messages in the existing CRC/epoch/credit protected DMA lane.
  10:../common/tx_image_bulk.h ****  * These kinds must never be forwarded to or accepted from USB. All integers LE.
  11:../common/tx_image_bulk.h ****  * Header: marker, kind, version, status, magic, request ID, offset, length,
  12:../common/tx_image_bulk.h ****  * reserved zero bytes. Body contains only Application bytes, never IAP. */
  13:../common/tx_image_bulk.h **** #define XORA_TX_BULK_MARKER 0xA6u
  14:../common/tx_image_bulk.h **** #define XORA_TX_BULK_REQUEST 0x7Du
  15:../common/tx_image_bulk.h **** #define XORA_TX_BULK_RESPONSE 0x7Eu
  16:../common/tx_image_bulk.h **** #define XORA_TX_BULK_VERSION 1u
  17:../common/tx_image_bulk.h **** #define XORA_TX_BULK_MAGIC 0x32424B54u
  18:../common/tx_image_bulk.h **** #define XORA_TX_BULK_HEADER_BYTES 32u
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccZtW9ho.s 			page 15


