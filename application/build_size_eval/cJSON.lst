 132:Libs/cJSON/cJSON.c **** /* Case insensitive string comparison, doesn't consider two NULL pointers equal though */
 133:Libs/cJSON/cJSON.c **** static int case_insensitive_strcmp(const unsigned char *string1, const unsigned char *string2)
 134:Libs/cJSON/cJSON.c **** {
 135:Libs/cJSON/cJSON.c ****     if ((string1 == NULL) || (string2 == NULL))
 136:Libs/cJSON/cJSON.c ****     {
 137:Libs/cJSON/cJSON.c ****         return 1;
 138:Libs/cJSON/cJSON.c ****     }
 139:Libs/cJSON/cJSON.c **** 
 140:Libs/cJSON/cJSON.c ****     if (string1 == string2)
 141:Libs/cJSON/cJSON.c ****     {
 142:Libs/cJSON/cJSON.c ****         return 0;
 143:Libs/cJSON/cJSON.c ****     }
 144:Libs/cJSON/cJSON.c **** 
 145:Libs/cJSON/cJSON.c ****     for(; tolower(*string1) == tolower(*string2); (void)string1++, string2++)
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccWtILFT.s 			page 4


 146:Libs/cJSON/cJSON.c ****     {
 147:Libs/cJSON/cJSON.c ****         if (*string1 == '\0')
 148:Libs/cJSON/cJSON.c ****         {
 149:Libs/cJSON/cJSON.c ****             return 0;
 150:Libs/cJSON/cJSON.c ****         }
 151:Libs/cJSON/cJSON.c ****     }
 152:Libs/cJSON/cJSON.c **** 
 153:Libs/cJSON/cJSON.c ****     return tolower(*string1) - tolower(*string2);
 154:Libs/cJSON/cJSON.c **** }
