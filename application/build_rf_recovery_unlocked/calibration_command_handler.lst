 290:Src/webconfig/configs/calibration_command_handler.cpp **** DeviceCommandResponse CalibrationCommandHandler::handle(const DeviceCommandRequest& request) {
 291:Src/webconfig/configs/calibration_command_handler.cpp ****     const std::string& command = request.getCommand();
 292:Src/webconfig/configs/calibration_command_handler.cpp ****     
 293:Src/webconfig/configs/calibration_command_handler.cpp ****     // 校准相关命令
 294:Src/webconfig/configs/calibration_command_handler.cpp ****     if (command == "start_manual_calibration") {
 295:Src/webconfig/configs/calibration_command_handler.cpp ****         return handleStartManualCalibration(request);
 296:Src/webconfig/configs/calibration_command_handler.cpp ****     } else if (command == "stop_manual_calibration") {
 297:Src/webconfig/configs/calibration_command_handler.cpp ****         return handleStopManualCalibration(request);
 298:Src/webconfig/configs/calibration_command_handler.cpp ****     } else if (command == "get_calibration_status") {
 299:Src/webconfig/configs/calibration_command_handler.cpp ****         return handleGetCalibrationStatus(request);
 300:Src/webconfig/configs/calibration_command_handler.cpp ****     } else if (command == "clear_manual_calibration_data") {
 301:Src/webconfig/configs/calibration_command_handler.cpp ****         return handleClearManualCalibrationData(request);
 302:Src/webconfig/configs/calibration_command_handler.cpp ****     } else if (command == "check_is_manual_calibration_completed") {
 303:Src/webconfig/configs/calibration_command_handler.cpp ****         return handleCheckIsManualCalibrationCompleted(request);
 304:Src/webconfig/configs/calibration_command_handler.cpp ****     }
 305:Src/webconfig/configs/calibration_command_handler.cpp ****     
 306:Src/webconfig/configs/calibration_command_handler.cpp ****     return create_error_response(request.getCid(), command, -1, "Unknown calibration command");
 307:Src/webconfig/configs/calibration_command_handler.cpp **** }
