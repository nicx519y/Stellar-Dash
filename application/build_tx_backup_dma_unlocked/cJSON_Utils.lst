 483:Libs/cJSON/cJSON_Utils.c **** /* sort lists using mergesort */
 484:Libs/cJSON/cJSON_Utils.c **** static cJSON *sort_list(cJSON *list, const cJSON_bool case_sensitive)
 485:Libs/cJSON/cJSON_Utils.c **** {
 486:Libs/cJSON/cJSON_Utils.c ****     cJSON *first = list;
 487:Libs/cJSON/cJSON_Utils.c ****     cJSON *second = list;
 488:Libs/cJSON/cJSON_Utils.c ****     cJSON *current_item = list;
