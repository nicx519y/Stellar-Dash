 137:Cpp_Core/Src/firmware/firmware_manager.cpp ****     
 138:Cpp_Core/Src/firmware/firmware_manager.cpp ****     // 2. 验证元数据版本兼容性
 139:Cpp_Core/Src/firmware/firmware_manager.cpp ****     if (metadata->metadata_version_major != METADATA_VERSION_MAJOR) {
 140:Cpp_Core/Src/firmware/firmware_manager.cpp ****         APP_ERR("FirmwareManager::validate_firmware_metadata: Invalid metadata version major");
 141:Cpp_Core/Src/firmware/firmware_manager.cpp ****         return FIRMWARE_INVALID_VERSION;
 142:Cpp_Core/Src/firmware/firmware_manager.cpp ****     }
