 457:Libs/cJSON/cJSON.c **** /* realloc printbuffer if necessary to have at least "needed" bytes more */
 458:Libs/cJSON/cJSON.c **** static unsigned char* ensure(printbuffer * const p, size_t needed)
 459:Libs/cJSON/cJSON.c **** {
 460:Libs/cJSON/cJSON.c ****     unsigned char *newbuffer = NULL;
 461:Libs/cJSON/cJSON.c ****     size_t newsize = 0;
 462:Libs/cJSON/cJSON.c **** 
 463:Libs/cJSON/cJSON.c ****     if ((p == NULL) || (p->buffer == NULL))
 464:Libs/cJSON/cJSON.c ****     {
 465:Libs/cJSON/cJSON.c ****         return NULL;
 466:Libs/cJSON/cJSON.c ****     }
 467:Libs/cJSON/cJSON.c **** 
 468:Libs/cJSON/cJSON.c ****     if ((p->length > 0) && (p->offset >= p->length))
 469:Libs/cJSON/cJSON.c ****     {
 470:Libs/cJSON/cJSON.c ****         /* make sure that offset is valid */
 471:Libs/cJSON/cJSON.c ****         return NULL;
 472:Libs/cJSON/cJSON.c ****     }
 473:Libs/cJSON/cJSON.c **** 
 474:Libs/cJSON/cJSON.c ****     if (needed > INT_MAX)
 475:Libs/cJSON/cJSON.c ****     {
 476:Libs/cJSON/cJSON.c ****         /* sizes bigger than INT_MAX are currently not supported */
 477:Libs/cJSON/cJSON.c ****         return NULL;
 478:Libs/cJSON/cJSON.c ****     }
 479:Libs/cJSON/cJSON.c **** 
 480:Libs/cJSON/cJSON.c ****     needed += p->offset + 1;
 481:Libs/cJSON/cJSON.c ****     if (needed <= p->length)
 482:Libs/cJSON/cJSON.c ****     {
 483:Libs/cJSON/cJSON.c ****         return p->buffer + p->offset;
 484:Libs/cJSON/cJSON.c ****     }
 485:Libs/cJSON/cJSON.c **** 
 486:Libs/cJSON/cJSON.c ****     if (p->noalloc) {
 487:Libs/cJSON/cJSON.c ****         return NULL;
