ARM GAS  C:\Users\nicx5\AppData\Local\Temp\cc4OI49C.s 			page 18


 251:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     for (uint8_t i = 0; i < NUM_ADC_BUTTONS; i++) {
 252:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 检查按键是否启用
 253:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         if (!(enabledKeysMask & (1 << i))) {
 254:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             continue; // 跳过未启用的按键
 255:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         }
 256:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 257:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         if (buttonStates[i].isCalibrated) {
 258:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             continue; // 跳过已校准的按键
 259:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         }
 260:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 261:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 记录处理前的状态
 262:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         CalibrationPhase prevPhase = buttonStates[i].phase;
 263:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         bool prevCalibrated = buttonStates[i].isCalibrated;
 264:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         CalibrationLEDColor prevLEDColor = buttonStates[i].ledColor;
 265:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 266:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 267:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 检查是否应该进行采样
 268:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         if (shouldSampleButton(i) && i < adcValues.size()) {
 269:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             uint16_t adcValue = *adcValues[i].valuePtr;
 270:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             if (adcValue > 0 && adcValue <= UINT16_MAX) {
 271:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****                 addSample(i, adcValue);
 272:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             }
 273:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         }
 274:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 275:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 检查状态是否发生变化
 276:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         if (buttonStates[i].phase != prevPhase || 
 277:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             buttonStates[i].isCalibrated != prevCalibrated ||
 278:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             buttonStates[i].ledColor != prevLEDColor) {
 279:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             hasStatusChange = true;
 280:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         }
 281:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     }
 282:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
 283:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     // 检查是否所有按键都已完成校准
 284:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     checkCalibrationCompletion();
 285:Cpp_Core/Src/adc_btns/adc_calibration.cpp **** 
 286:Cpp_Core/Src/adc_btns/adc_calibration.cpp **** #if HAS_LED == 1
 287:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     /*
 288:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****      * WS2812B setters only update the edit frame.  The circular-DMA driver
 289:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****      * needs an explicit submit before that frame can reach the physical
 290:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****      * strip.  Service on every calibration pass so a submit that briefly
 291:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****      * lost the asynchronous HT/TC transaction race is retried on the next
 292:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****      * pass instead of leaving the last calibration colour stuck.
 293:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****      */
 294:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     if (WS2812B_GetStateStrip(WS2812B_STRIP_KEYS) == WS2812B_RUNNING) {
 295:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         WS2812B_ServiceStrip(WS2812B_STRIP_KEYS);
 296:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     }
 297:Cpp_Core/Src/adc_btns/adc_calibration.cpp **** #endif
 298:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
 299:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     // 如果本轮循环有状态变更，触发回调
 300:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     if (hasStatusChange) {
 301:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         triggerCalibrationStatusChangedCallback();
 302:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     }
 303:Cpp_Core/Src/adc_btns/adc_calibration.cpp **** }
