  51:Libs/mbedtls/library/bignum.c **** /*
  52:Libs/mbedtls/library/bignum.c ****  * Convert between bits/chars and number of limbs
  53:Libs/mbedtls/library/bignum.c ****  * Divide first in order to avoid potential overflows
  54:Libs/mbedtls/library/bignum.c ****  */
  55:Libs/mbedtls/library/bignum.c **** #define BITS_TO_LIMBS(i)  ((i) / biL + ((i) % biL != 0))
  56:Libs/mbedtls/library/bignum.c **** #define CHARS_TO_LIMBS(i) ((i) / ciL + ((i) % ciL != 0))
  57:Libs/mbedtls/library/bignum.c **** 
  58:Libs/mbedtls/library/bignum.c **** /* Implementation that should never be optimized out by the compiler */
