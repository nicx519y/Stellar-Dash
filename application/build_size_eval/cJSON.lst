 556:Libs/cJSON/cJSON.c **** /* securely comparison of floating-point variables */
 557:Libs/cJSON/cJSON.c **** static cJSON_bool compare_double(double a, double b)
 558:Libs/cJSON/cJSON.c **** {
 559:Libs/cJSON/cJSON.c ****     double maxVal = fabs(a) > fabs(b) ? fabs(a) : fabs(b);
 560:Libs/cJSON/cJSON.c ****     return (fabs(a - b) <= maxVal * DBL_EPSILON);
 561:Libs/cJSON/cJSON.c **** }
