  74:Src/support/cpp_utils.cpp **** void safe_strncpy(char* dest, const char* src, size_t dest_size) {
  75:Src/support/cpp_utils.cpp ****     if (!dest || !src || dest_size == 0) return;
  76:Src/support/cpp_utils.cpp ****     std::string str_value(src);
  77:Src/support/cpp_utils.cpp ****     if (!is_valid_utf8(str_value.c_str())) {
  78:Src/support/cpp_utils.cpp ****         LOG_WARN("UTILS", "Invalid UTF-8 detected in string, attempting to fix");
  79:Src/support/cpp_utils.cpp ****         str_value = fix_utf8_string(str_value);
  80:Src/support/cpp_utils.cpp ****         if (!is_valid_utf8(str_value.c_str())) {
  81:Src/support/cpp_utils.cpp ****             LOG_ERROR("UTILS", "Failed to fix UTF-8 encoding, using fallback");
  82:Src/support/cpp_utils.cpp ****             std::string fallback;
  83:Src/support/cpp_utils.cpp ****             for (char c : str_value) {
  84:Src/support/cpp_utils.cpp ****                 if (c >= 32 && c <= 126) {
  85:Src/support/cpp_utils.cpp ****                     fallback += c;
  86:Src/support/cpp_utils.cpp ****                 } else {
  87:Src/support/cpp_utils.cpp ****                     fallback += '?';
  88:Src/support/cpp_utils.cpp ****                 }
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccru91DV.s 			page 3


  89:Src/support/cpp_utils.cpp ****             }
  90:Src/support/cpp_utils.cpp ****             str_value = fallback;
  91:Src/support/cpp_utils.cpp ****         }
  92:Src/support/cpp_utils.cpp ****     }
  93:Src/support/cpp_utils.cpp ****     if (str_value.length() >= dest_size) {
  94:Src/support/cpp_utils.cpp ****         str_value = str_value.substr(0, dest_size - 1);
  95:Src/support/cpp_utils.cpp ****     }
  96:Src/support/cpp_utils.cpp ****     strncpy(dest, str_value.c_str(), dest_size - 1);
  97:Src/support/cpp_utils.cpp ****     dest[dest_size - 1] = '\0';
  98:Src/support/cpp_utils.cpp **** }
