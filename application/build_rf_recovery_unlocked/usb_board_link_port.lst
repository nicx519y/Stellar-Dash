 359:../common/usb_board_link_protocol.h **** /*
 360:../common/usb_board_link_protocol.h ****  * Variable-length USB_CONTROL messages use the first four bytes as a common
 361:../common/usb_board_link_protocol.h ****  * header.  A request sets status to USB_BOARD_STATUS_OK.  A response echoes
 362:../common/usb_board_link_protocol.h ****  * opcode/transaction and places the operation result in status.
 363:../common/usb_board_link_protocol.h ****  *
 364:../common/usb_board_link_protocol.h ****  * The serialized length is sizeof(header) + data_length; the fixed-size
 365:../common/usb_board_link_protocol.h ****  * request/response containers make the 60-byte payload ceiling explicit.
 366:../common/usb_board_link_protocol.h ****  */
 367:../common/usb_board_link_protocol.h **** #define USB_BOARD_CONTROL_HEADER_BYTES 4u
