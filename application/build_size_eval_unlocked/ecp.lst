1357:Libs/mbedtls/library/ecp.c **** /*
1358:Libs/mbedtls/library/ecp.c ****  * Normalize jacobian coordinates of an array of (pointers to) points,
1359:Libs/mbedtls/library/ecp.c ****  * using Montgomery's trick to perform only one inversion mod P.
1360:Libs/mbedtls/library/ecp.c ****  * (See for example Cohen's "A Course in Computational Algebraic Number
1361:Libs/mbedtls/library/ecp.c ****  * Theory", Algorithm 10.3.4.)
1362:Libs/mbedtls/library/ecp.c ****  *
1363:Libs/mbedtls/library/ecp.c ****  * Warning: fails (returning an error) if one of the points is zero!
1364:Libs/mbedtls/library/ecp.c ****  * This should never happen, see choice of w in ecp_mul_comb().
1365:Libs/mbedtls/library/ecp.c ****  *
1366:Libs/mbedtls/library/ecp.c ****  * Cost: 1N(t) := 1I + (6t - 3)M + 1S
1367:Libs/mbedtls/library/ecp.c ****  */
1368:Libs/mbedtls/library/ecp.c **** static int ecp_normalize_jac_many(const mbedtls_ecp_group *grp,
1369:Libs/mbedtls/library/ecp.c ****                                   mbedtls_ecp_point *T[], size_t T_size)
1370:Libs/mbedtls/library/ecp.c **** {
1371:Libs/mbedtls/library/ecp.c ****     if (T_size < 2) {
1372:Libs/mbedtls/library/ecp.c ****         return ecp_normalize_jac(grp, *T);
1373:Libs/mbedtls/library/ecp.c ****     }
1374:Libs/mbedtls/library/ecp.c **** 
1375:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_ECP_NORMALIZE_JAC_MANY_ALT)
1376:Libs/mbedtls/library/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
1377:Libs/mbedtls/library/ecp.c ****         return mbedtls_internal_ecp_normalize_jac_many(grp, T, T_size);
1378:Libs/mbedtls/library/ecp.c ****     }
1379:Libs/mbedtls/library/ecp.c **** #endif
1380:Libs/mbedtls/library/ecp.c **** 
1381:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_NORMALIZE_JAC_MANY_ALT)
1382:Libs/mbedtls/library/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
1383:Libs/mbedtls/library/ecp.c **** #else
1384:Libs/mbedtls/library/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
