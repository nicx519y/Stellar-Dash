  45:Libs/mbedtls/library/gcm.c **** void mbedtls_gcm_init(mbedtls_gcm_context *ctx)
  46:Libs/mbedtls/library/gcm.c **** {
  47:Libs/mbedtls/library/gcm.c ****     GCM_VALIDATE(ctx != NULL);
