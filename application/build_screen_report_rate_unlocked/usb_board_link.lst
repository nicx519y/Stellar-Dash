  17:../common/webhid_fast_link.h **** /* Independent of the 0x5A boot/IAP/control framing. All wire integers LE. */
  18:../common/webhid_fast_link.h **** #define WHF_SYNC 0x5Bu
  19:../common/webhid_fast_link.h **** #define WHF_HEADER_BYTES 32u
  20:../common/webhid_fast_link.h **** #define WHF_BATCH 3u
  21:../common/webhid_fast_link.h **** #define WHF_BLOCK_BYTES (WHF_HEADER_BYTES + WHF_BATCH * WEBHID_REPORT_BYTES)
