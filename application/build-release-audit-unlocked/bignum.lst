1471:Libs/mbedtls/library/bignum.c ****  * Baseline multiplication: X = A * B  (HAC 14.12)
1472:Libs/mbedtls/library/bignum.c ****  */
1473:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_mul_mpi(mbedtls_mpi *X, const mbedtls_mpi *A, const mbedtls_mpi *B)
1474:Libs/mbedtls/library/bignum.c **** {
