1293:Libs/mbedtls/library/bignum.c **** 
1294:Libs/mbedtls/library/bignum.c ****     /* X should always be positive as a result of unsigned subtractions. */
1295:Libs/mbedtls/library/bignum.c ****     X->s = 1;
1296:Libs/mbedtls/library/bignum.c **** 
1297:Libs/mbedtls/library/bignum.c **** cleanup:
1298:Libs/mbedtls/library/bignum.c ****     return ret;
1299:Libs/mbedtls/library/bignum.c **** }
