 530:Src/leds/led_animation.cpp ****         // 流星参数 - 调整尾巴长度
 531:Src/leds/led_animation.cpp ****         // 速度1: 5, 速度2: 8, 速度3: 11, 速度4: 14, 速度5: 17
 532:Src/leds/led_animation.cpp ****         // 公式：基础长度2 + 速度 * 3
 533:Src/leds/led_animation.cpp ****         uint8_t meteorLength = 2 + animationSpeed * 3;
 534:Src/leds/led_animation.cpp ****         
 535:Src/leds/led_animation.cpp ****         // 计算流星头部的当前位置（顺时针移动）
