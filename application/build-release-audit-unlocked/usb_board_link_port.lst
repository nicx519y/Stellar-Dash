  10:../common/usb_board_link_protocol.h **** /*
  11:../common/usb_board_link_protocol.h ****  * STM32 <-> on-board CH585 USB control/data link.
  12:../common/usb_board_link_protocol.h ****  *
  13:../common/usb_board_link_protocol.h ****  * This namespace is intentionally separate from the frozen RF 0xA5 protocol.
  14:../common/usb_board_link_protocol.h ****  * A CH585 instance locks into exactly one role after USB_BOARD_CMD_SELECT_ROLE:
  15:../common/usb_board_link_protocol.h ****  * - RF role: this parser is disabled and the existing 0xA5 stack owns SPI.
  16:../common/usb_board_link_protocol.h ****  * - USB/maintenance role: the RF stack is never initialized.
  17:../common/usb_board_link_protocol.h ****  */
  18:../common/usb_board_link_protocol.h **** #define USB_BOARD_LINK_SYNC                 0x5Au
  19:../common/usb_board_link_protocol.h **** #define USB_BOARD_LINK_VERSION              1u
  20:../common/usb_board_link_protocol.h **** #define USB_BOARD_LINK_MAX_FRAME_BYTES      64u
  21:../common/usb_board_link_protocol.h **** #define USB_BOARD_LINK_HEADER_BYTES         3u
  22:../common/usb_board_link_protocol.h **** #define USB_BOARD_LINK_CHECKSUM_BYTES       1u
  23:../common/usb_board_link_protocol.h **** #define USB_BOARD_LINK_MAX_PAYLOAD_BYTES    \
  24:../common/usb_board_link_protocol.h ****     (USB_BOARD_LINK_MAX_FRAME_BYTES - USB_BOARD_LINK_HEADER_BYTES - USB_BOARD_LINK_CHECKSUM_BYTES)
  25:../common/usb_board_link_protocol.h **** 
  26:../common/usb_board_link_protocol.h **** #define USB_BOARD_INPUT_V1_BYTES            10u
  27:../common/usb_board_link_protocol.h **** #define USB_BOARD_TELEMETRY_FRAME_BYTES     32u
  28:../common/usb_board_link_protocol.h **** #define USB_BOARD_FRAGMENT_HEADER_BYTES     8u
  29:../common/usb_board_link_protocol.h **** #define USB_BOARD_FRAGMENT_DATA_BYTES       \
  30:../common/usb_board_link_protocol.h ****     (USB_BOARD_LINK_MAX_PAYLOAD_BYTES - USB_BOARD_FRAGMENT_HEADER_BYTES)
  31:../common/usb_board_link_protocol.h **** #define USB_BOARD_BULK_MESSAGE_MAX_BYTES    1536u
