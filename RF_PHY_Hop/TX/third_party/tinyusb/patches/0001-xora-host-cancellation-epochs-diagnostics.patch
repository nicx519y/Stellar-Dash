+/* XORA: main-loop cancellation of active AND queued control transfers. */
+bool tuh_control_abort_token(uint8_t daddr, uintptr_t token) {
+  bool found = false;
+  unsigned count = tu_fifo_count(&_usbh_pending_ctrl_q) / sizeof(usbh_pending_ctrl_t);
+  for (unsigned i = 0; i < count; i++) {
+    usbh_pending_ctrl_t entry;
+    if (tu_fifo_read_n(&_usbh_pending_ctrl_q, &entry, sizeof(entry)) != sizeof(entry)) break;
+    if (entry.daddr == daddr && entry.user_data == token) found = true;
+    else tu_fifo_write_n(&_usbh_pending_ctrl_q, &entry, sizeof(entry));
+  }
+  usbh_ctrl_xfer_info_t *info = &_usbh_data.ctrl_xfer_info;
+  if (info->stage != CONTROL_STAGE_IDLE && info->daddr == daddr && info->user_data == token)
+    return tuh_edpt_abort_xfer(daddr, 0);
+  return found;
+}
