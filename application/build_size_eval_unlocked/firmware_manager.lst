 165:Cpp_Core/Src/firmware/firmware_manager.cpp ****     if (metadata->metadata_size != METADATA_STRUCT_SIZE) {
 166:Cpp_Core/Src/firmware/firmware_manager.cpp ****         APP_ERR("FirmwareManager::validate_firmware_metadata: Invalid metadata size");
