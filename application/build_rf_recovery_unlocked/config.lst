  34:Src/config/config.cpp **** /*
  35:Src/config/config.cpp ****  * Power-loss-safe configuration journal.
  36:Src/config/config.cpp ****  *
  37:Src/config/config.cpp ****  * APP_CONFIG and the currently unused LOG_STORAGE regions form two independent
  38:Src/config/config.cpp ****  * 64 KiB banks. A bank only becomes visible after the payload write completes
  39:Src/config/config.cpp ****  * and the commit word is programmed in a separate final page-program
  40:Src/config/config.cpp ****  * operation. Until then the previously committed bank remains authoritative.
  41:Src/config/config.cpp ****  *
  42:Src/config/config.cpp ****  * The payload deliberately remains the native Config image so existing config
  43:Src/config/config.cpp ****  * version migrations still apply after the journal layer selects a bank.
  44:Src/config/config.cpp ****  */
  45:Src/config/config.cpp **** #define CONFIG_BANK_A_ADDR           CONFIG_ADDR_ORIGIN
  46:Src/config/config.cpp **** #define CONFIG_BANK_B_ADDR           LOG_STORAGE_ADDR
  47:Src/config/config.cpp **** #define CONFIG_BANK_SIZE             (64u * 1024u)
  48:Src/config/config.cpp **** #define CONFIG_JOURNAL_MAGIC         0x47464348u /* "HCFG", little endian */
  49:Src/config/config.cpp **** #define CONFIG_JOURNAL_VERSION       1u
  50:Src/config/config.cpp **** #define CONFIG_JOURNAL_COMMIT        0x54494D43u /* "CMIT", little endian */
  51:Src/config/config.cpp **** #define CONFIG_JOURNAL_ERASED_WORD   0xFFFFFFFFu
  52:Src/config/config.cpp **** #define CONFIG_DIGEST_MARKER         0x31435243u /* "CRC1", little endian */
