 209:Cpp_Core/Src/screen_control/spi_screen_manager.cpp **** static uint8_t battery_animated_soc(uint8_t baseSoc, uint32_t nowMs) {
 210:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     if (baseSoc >= 100u || g_battUiChargeState != PowerChargeState::Charging) {
 211:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****         return baseSoc;
 212:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     }
 213:Cpp_Core/Src/screen_control/spi_screen_manager.cpp **** 
 214:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     /* Normal charge fills in 2 s; CH224A-confirmed fast charge fills in 1 s. */
 215:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     static constexpr uint32_t kNormalChargeSweepMs = 2000u;
 216:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     static constexpr uint32_t kFastChargeSweepMs = 1000u;
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccpchWVa.s 			page 6


 217:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     const uint32_t sweepMs = g_battUiFastCharging
 218:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****                                  ? kFastChargeSweepMs
 219:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****                                  : kNormalChargeSweepMs;
 220:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     const uint32_t phaseMs =
 221:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****         (uint32_t)(nowMs - g_battUiChargeAnimStartMs) % sweepMs;
 222:Cpp_Core/Src/screen_control/spi_screen_manager.cpp **** 
 223:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     const uint32_t remaining = 100u - baseSoc;
 224:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****     return (uint8_t)(baseSoc +
 225:Cpp_Core/Src/screen_control/spi_screen_manager.cpp ****                      ((remaining * phaseMs + (sweepMs / 2u)) / sweepMs));
 226:Cpp_Core/Src/screen_control/spi_screen_manager.cpp **** }
