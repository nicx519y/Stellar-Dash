   5:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** /* WS2812B-Mini-V3J data protocol (datasheet):
   6:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** |-------------------------------------------|
   7:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** |T0H | 220ns ~ 380ns
   8:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** |T1H | 580ns ~ 1us
   9:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** |T0L | 580ns ~ 1us
  10:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** |T1L | 580ns ~ 1us
  11:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** |RES | above 280us |
  12:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** |-------------------------------------------
  13:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** */
  14:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** 
  15:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** /* 240MHz timer clock, period=308 ticks -> 1.283us (779.22kHz).
  16:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  *
  17:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  * Both key-module schematics populate WS2812B-MINI-V3J.  Keep the high and
  18:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  * low portions away from the datasheet limits; 160 ticks previously left
  19:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  * only about 3ns of T1L margin.  The centered values also leave more time for
  20:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  * the next CCR DMA write before the following PWM period (TIM4 now requests
  21:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  * CC DMA on update via CCDS, giving a full period independent of duty):
  22:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  *   T1H = 150/240MHz = 625ns, T1L = 658ns
  23:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  *   T0H =  72/240MHz = 300ns, T0L = 983ns
  24:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  *
  25:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  * The ambient path already uses and has verified the same centered timing.
  26:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  */
  27:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** #define KEYS_HIGH_CCR_CODE       150u
  28:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** #define KEYS_LOW_CCR_CODE         72u
  29:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** #define AMBIENT_HIGH_CCR_CODE    150u
  30:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** #define AMBIENT_LOW_CCR_CODE      72u
  31:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** 
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\cckkyesf.s 			page 2


  32:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** /* One reset slot is 24 zero-duty PWM periods, about 30.8us at 779.22kHz.
  33:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  * Ten slots produce about 308us, the shortest whole-slot value that remains
  34:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****  * above the WS2812B-MINI-V3J datasheet reset/latch minimum of 280us. */
  35:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** #define WS2812B_KEYS_RESET_SLOT_COUNT       10u
  36:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** #define WS2812B_AMBIENT_RESET_SLOT_COUNT    10u
  37:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** #define WS2812B_FRAME_BUFFER_LEN_FOR(count, resetSlots) \
  38:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****     ((((uint32_t)(count) + (uint32_t)(resetSlots)) * 24u) * \
  39:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****      (uint32_t)NUM_LEDs_PER_ADC_BUTTON)
  40:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** 
  41:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** #define LED_DEFAULT_BRIGHTNESS 128
  42:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** 
  43:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** enum {
  44:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****     WS2812B_KEYS_LED_COUNT = (NUM_ADC_BUTTONS + NUM_GPIO_BUTTONS),
  45:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****     WS2812B_AMBIENT_LED_COUNT = NUM_LED_AROUND
  46:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** };
  47:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** 
  48:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** enum {
  49:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****     WS2812B_KEYS_DMA_BUFFER_LEN = (int)WS2812B_FRAME_BUFFER_LEN_FOR(
  50:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****         WS2812B_KEYS_LED_COUNT, WS2812B_KEYS_RESET_SLOT_COUNT),
  51:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****     WS2812B_AMBIENT_DMA_BUFFER_LEN = (int)WS2812B_FRAME_BUFFER_LEN_FOR(
  52:Src/leds/drivers/ws2812b/pwm-ws2812b.c ****         WS2812B_AMBIENT_LED_COUNT, WS2812B_AMBIENT_RESET_SLOT_COUNT)
  53:Src/leds/drivers/ws2812b/pwm-ws2812b.c **** };
