1924:Libs/mbedtls/library/bignum.c **** void mbedtls_mpi_montmul(mbedtls_mpi *A,
1925:Libs/mbedtls/library/bignum.c ****                          const mbedtls_mpi *B,
1926:Libs/mbedtls/library/bignum.c ****                          const mbedtls_mpi *N,
1927:Libs/mbedtls/library/bignum.c ****                          mbedtls_mpi_uint mm,
1928:Libs/mbedtls/library/bignum.c ****                          const mbedtls_mpi *T)
1929:Libs/mbedtls/library/bignum.c **** {
1930:Libs/mbedtls/library/bignum.c ****     size_t i, n, m;
