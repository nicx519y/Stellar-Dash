  56:../common/usb_board_link_protocol.h **** static inline uint8_t usb_board_input_rate_flags(uint16_t rate_hz)
  57:../common/usb_board_link_protocol.h **** {
  58:../common/usb_board_link_protocol.h ****     switch(rate_hz)
  59:../common/usb_board_link_protocol.h ****     {
  60:../common/usb_board_link_protocol.h ****     case 2000u:
  61:../common/usb_board_link_protocol.h ****         return USB_BOARD_INPUT_RATE_2K;
  62:../common/usb_board_link_protocol.h ****     case 4000u:
  63:../common/usb_board_link_protocol.h ****         return USB_BOARD_INPUT_RATE_4K;
  64:../common/usb_board_link_protocol.h ****     case 8000u:
  65:../common/usb_board_link_protocol.h ****         return USB_BOARD_INPUT_RATE_8K;
  66:../common/usb_board_link_protocol.h ****     default:
  67:../common/usb_board_link_protocol.h ****         return USB_BOARD_INPUT_RATE_1K;
  68:../common/usb_board_link_protocol.h ****     }
  69:../common/usb_board_link_protocol.h **** }
  70:../common/usb_board_link_protocol.h **** 
  71:../common/usb_board_link_protocol.h **** static inline uint16_t usb_board_input_rate_hz(uint8_t flags)
