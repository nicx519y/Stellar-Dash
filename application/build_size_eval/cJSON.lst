 162:Libs/cJSON/cJSON.c **** 
 163:Libs/cJSON/cJSON.c **** #if defined(_MSC_VER)
 164:Libs/cJSON/cJSON.c **** /* work around MSVC error C2322: '...' address of dllimport '...' is not static */
 165:Libs/cJSON/cJSON.c **** static void * CJSON_CDECL internal_malloc(size_t size)
 166:Libs/cJSON/cJSON.c **** {
