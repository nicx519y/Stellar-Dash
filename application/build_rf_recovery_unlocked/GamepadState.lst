  71:Src/input/gamepad/GamepadState.cpp ****  * @brief Filter diagonals out of the dpad, making the device work as a 4-way lever.
  72:Src/input/gamepad/GamepadState.cpp ****  *
  73:Src/input/gamepad/GamepadState.cpp ****  * The most recent cardinal direction wins.
  74:Src/input/gamepad/GamepadState.cpp ****  *
  75:Src/input/gamepad/GamepadState.cpp ****  * @param dpad The GameState.dpad value.
  76:Src/input/gamepad/GamepadState.cpp ****  * @return uint8_t The new dpad value.
  77:Src/input/gamepad/GamepadState.cpp ****  */
  78:Src/input/gamepad/GamepadState.cpp **** uint8_t filterToFourWayMode(uint8_t dpad)
  79:Src/input/gamepad/GamepadState.cpp **** {
  80:Src/input/gamepad/GamepadState.cpp **** 	updateDpad(dpad, DIRECTION_UP);
  81:Src/input/gamepad/GamepadState.cpp **** 	updateDpad(dpad, DIRECTION_DOWN);
  82:Src/input/gamepad/GamepadState.cpp **** 	updateDpad(dpad, DIRECTION_LEFT);
  83:Src/input/gamepad/GamepadState.cpp **** 	return updateDpad(dpad, DIRECTION_RIGHT);
  84:Src/input/gamepad/GamepadState.cpp **** }
