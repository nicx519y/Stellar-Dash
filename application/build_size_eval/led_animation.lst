 309:Cpp_Core/Src/leds/led_animation.cpp ****     // 获取动态边界
 310:Cpp_Core/Src/leds/led_animation.cpp ****     float minX, maxX;
 311:Cpp_Core/Src/leds/led_animation.cpp ****     getBoundaries(params, minX, maxX);
 312:Cpp_Core/Src/leds/led_animation.cpp ****     
 313:Cpp_Core/Src/leds/led_animation.cpp ****     // 流光参数
 314:Cpp_Core/Src/leds/led_animation.cpp ****     float bandWidth = 140.0f; // 光带宽度，与TypeScript版本保持一致
 315:Cpp_Core/Src/leds/led_animation.cpp ****     
 316:Cpp_Core/Src/leds/led_animation.cpp ****     // 当前流光中心位置
 317:Cpp_Core/Src/leds/led_animation.cpp ****     float centerX = minX + (maxX - minX) * params.progress * 1.6f;
 318:Cpp_Core/Src/leds/led_animation.cpp ****     
 319:Cpp_Core/Src/leds/led_animation.cpp ****     // 获取当前LED的X坐标
 320:Cpp_Core/Src/leds/led_animation.cpp ****     float btnX;
 321:Cpp_Core/Src/leds/led_animation.cpp ****     uint8_t mainLedsCount = NUM_ADC_BUTTONS + NUM_GPIO_BUTTONS;
 322:Cpp_Core/Src/leds/led_animation.cpp ****     if (params.index < mainLedsCount) {
 323:Cpp_Core/Src/leds/led_animation.cpp ****         btnX = MAIN_LED_POS_LIST[params.index].x;
 324:Cpp_Core/Src/leds/led_animation.cpp ****     } else {
 325:Cpp_Core/Src/leds/led_animation.cpp ****         btnX = AROUND_LED_POS_LIST[params.index - mainLedsCount].x;
 326:Cpp_Core/Src/leds/led_animation.cpp ****     }
 327:Cpp_Core/Src/leds/led_animation.cpp ****     
 328:Cpp_Core/Src/leds/led_animation.cpp ****     // 计算距离中心的归一化距离
 329:Cpp_Core/Src/leds/led_animation.cpp ****     float dist = fabsf(btnX - centerX);
 330:Cpp_Core/Src/leds/led_animation.cpp ****     
 331:Cpp_Core/Src/leds/led_animation.cpp ****     // 使用更平滑的渐变算法，避免闪烁
 332:Cpp_Core/Src/leds/led_animation.cpp ****     float t = 0.0f;
 333:Cpp_Core/Src/leds/led_animation.cpp ****     if (dist <= bandWidth) {
 334:Cpp_Core/Src/leds/led_animation.cpp ****         // 使用平滑的渐变函数，确保在边界处没有突变
 335:Cpp_Core/Src/leds/led_animation.cpp ****         float normalizedDist = dist / bandWidth; // 0~1
 336:Cpp_Core/Src/leds/led_animation.cpp ****         // 使用 smoothstep 函数创建更平滑的过渡
 337:Cpp_Core/Src/leds/led_animation.cpp ****         t = 1.0f - (normalizedDist * normalizedDist * (3.0f - 2.0f * normalizedDist));
 338:Cpp_Core/Src/leds/led_animation.cpp ****     }
 339:Cpp_Core/Src/leds/led_animation.cpp ****     
