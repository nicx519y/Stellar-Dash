 235:Src/webconfig/configs/common_command_handler.cpp ****         return handleGetHitboxLayout(request);
 236:Src/webconfig/configs/common_command_handler.cpp ****     } else if (command == "get_button_states") {
 237:Src/webconfig/configs/common_command_handler.cpp ****         return handleGetButtonStates(request);
 238:Src/webconfig/configs/common_command_handler.cpp ****     }
 239:Src/webconfig/configs/common_command_handler.cpp ****     
 240:Src/webconfig/configs/common_command_handler.cpp ****     return create_error_response(request.getCid(), command, -1, "Unknown common command");
