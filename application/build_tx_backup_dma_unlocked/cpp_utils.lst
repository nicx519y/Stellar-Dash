  17:Src/support/cpp_utils.cpp ****             str += 2;
  18:Src/support/cpp_utils.cpp ****         } else if ((c & 0xF0) == 0xE0) {
  19:Src/support/cpp_utils.cpp ****             if ((str[1] & 0xC0) != 0x80 || (str[2] & 0xC0) != 0x80) return false;
  20:Src/support/cpp_utils.cpp ****             str += 3;
  21:Src/support/cpp_utils.cpp ****         } else if ((c & 0xF8) == 0xF0) {
  22:Src/support/cpp_utils.cpp ****             if ((str[1] & 0xC0) != 0x80 || (str[2] & 0xC0) != 0x80 || (str[3] & 0xC0) != 0x80) retu
  23:Src/support/cpp_utils.cpp ****             str += 4;
  24:Src/support/cpp_utils.cpp ****         } else {
  25:Src/support/cpp_utils.cpp ****             return false;
  26:Src/support/cpp_utils.cpp ****         }
  27:Src/support/cpp_utils.cpp ****     }
  28:Src/support/cpp_utils.cpp ****     return true;
  29:Src/support/cpp_utils.cpp **** }
