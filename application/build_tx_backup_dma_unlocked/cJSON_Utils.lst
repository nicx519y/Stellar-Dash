 491:Libs/cJSON/cJSON_Utils.c **** 
 492:Libs/cJSON/cJSON_Utils.c ****     if ((list == NULL) || (list->next == NULL))
 493:Libs/cJSON/cJSON_Utils.c ****     {
 494:Libs/cJSON/cJSON_Utils.c ****         /* One entry is sorted already. */
 495:Libs/cJSON/cJSON_Utils.c ****         return result;
 496:Libs/cJSON/cJSON_Utils.c ****     }
 497:Libs/cJSON/cJSON_Utils.c **** 
 498:Libs/cJSON/cJSON_Utils.c ****     while ((current_item != NULL) && (current_item->next != NULL) && (compare_strings((unsigned cha
 499:Libs/cJSON/cJSON_Utils.c ****     {
 500:Libs/cJSON/cJSON_Utils.c ****         /* Test for list sorted. */
 501:Libs/cJSON/cJSON_Utils.c ****         current_item = current_item->next;
 502:Libs/cJSON/cJSON_Utils.c ****     }
 503:Libs/cJSON/cJSON_Utils.c ****     if ((current_item == NULL) || (current_item->next == NULL))
 504:Libs/cJSON/cJSON_Utils.c ****     {
 505:Libs/cJSON/cJSON_Utils.c ****         /* Leave sorted lists unmodified. */
 506:Libs/cJSON/cJSON_Utils.c ****         return result;
 507:Libs/cJSON/cJSON_Utils.c ****     }
 508:Libs/cJSON/cJSON_Utils.c **** 
 509:Libs/cJSON/cJSON_Utils.c ****     /* reset pointer to the beginning */
 510:Libs/cJSON/cJSON_Utils.c ****     current_item = list;
 511:Libs/cJSON/cJSON_Utils.c ****     while (current_item != NULL)
 512:Libs/cJSON/cJSON_Utils.c ****     {
 513:Libs/cJSON/cJSON_Utils.c ****         /* Walk two pointers to find the middle. */
 514:Libs/cJSON/cJSON_Utils.c ****         second = second->next;
 515:Libs/cJSON/cJSON_Utils.c ****         current_item = current_item->next;
 516:Libs/cJSON/cJSON_Utils.c ****         /* advances current_item two steps at a time */
