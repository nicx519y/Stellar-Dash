 594:Src/leds/leds_manager.cpp ****     /* The first preview owns LED runtime startup.  Subsequent WebConfig
 595:Src/leds/leds_manager.cpp ****      * changes stay in-place: deinit() blocks the control loop for 50 ms and
 596:Src/leds/leds_manager.cpp ****      * unnecessarily stops both TIM4 DMA channels when only one strip changed.
 597:Src/leds/leds_manager.cpp ****      * WebHID is physically owned by CH585 and is not directly coupled to
 598:Src/leds/leds_manager.cpp ****      * TIM4; keeping the update local avoids perturbing the other LED strip. */
 599:Src/leds/leds_manager.cpp ****     if (!runtimeWasEnabled) {
