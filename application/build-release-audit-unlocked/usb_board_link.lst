  80:../common/usb_board_link_protocol.h ****         return 8000u;
  81:../common/usb_board_link_protocol.h ****     default:
  82:../common/usb_board_link_protocol.h ****         return 1000u;
  83:../common/usb_board_link_protocol.h ****     }
  84:../common/usb_board_link_protocol.h **** }
