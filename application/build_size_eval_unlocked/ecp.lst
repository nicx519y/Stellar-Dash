2167:Libs/mbedtls/library/ecp.c ****     int have_rng = 1;
2168:Libs/mbedtls/library/ecp.c **** 
2169:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_ECP_RESTARTABLE)
2170:Libs/mbedtls/library/ecp.c ****     if (rs_ctx != NULL && rs_ctx->rsm != NULL) {
