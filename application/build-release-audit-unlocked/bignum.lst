1374:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_sub_int(mbedtls_mpi *X, const mbedtls_mpi *A, mbedtls_mpi_sint b)
1375:Libs/mbedtls/library/bignum.c **** {
1376:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi B;
