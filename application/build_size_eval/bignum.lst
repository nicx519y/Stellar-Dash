1245:Libs/mbedtls/library/bignum.c ****  * Unsigned subtraction: X = |A| - |B|  (HAC 14.9, 14.10)
1246:Libs/mbedtls/library/bignum.c ****  */
1247:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_sub_abs(mbedtls_mpi *X, const mbedtls_mpi *A, const mbedtls_mpi *B)
1248:Libs/mbedtls/library/bignum.c **** {
