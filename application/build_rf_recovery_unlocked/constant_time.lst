  37:Libs/mbedtls/library/constant_time.c **** int mbedtls_ct_memcmp(const void *a,
  38:Libs/mbedtls/library/constant_time.c ****                       const void *b,
  39:Libs/mbedtls/library/constant_time.c ****                       size_t n)
  40:Libs/mbedtls/library/constant_time.c **** {
  41:Libs/mbedtls/library/constant_time.c ****     size_t i;
  42:Libs/mbedtls/library/constant_time.c ****     volatile const unsigned char *A = (volatile const unsigned char *) a;
  43:Libs/mbedtls/library/constant_time.c ****     volatile const unsigned char *B = (volatile const unsigned char *) b;
  44:Libs/mbedtls/library/constant_time.c ****     volatile unsigned char diff = 0;
  45:Libs/mbedtls/library/constant_time.c **** 
  46:Libs/mbedtls/library/constant_time.c ****     for (i = 0; i < n; i++) {
  47:Libs/mbedtls/library/constant_time.c ****         /* Read volatile data in order before computing diff.
  48:Libs/mbedtls/library/constant_time.c ****          * This avoids IAR compiler warning:
  49:Libs/mbedtls/library/constant_time.c ****          * 'the order of volatile accesses is undefined ..' */
  50:Libs/mbedtls/library/constant_time.c ****         unsigned char x = A[i], y = B[i];
  51:Libs/mbedtls/library/constant_time.c ****         diff |= x ^ y;
  52:Libs/mbedtls/library/constant_time.c ****     }
  53:Libs/mbedtls/library/constant_time.c **** 
  54:Libs/mbedtls/library/constant_time.c ****     return (int) diff;
  55:Libs/mbedtls/library/constant_time.c **** }
