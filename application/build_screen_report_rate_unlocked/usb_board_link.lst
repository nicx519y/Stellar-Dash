 228:Src/transport/usb/usb_board_link.cpp ****     for (;;) {
 229:Src/transport/usb/usb_board_link.cpp ****         // A high-speed response is delivered before the peer releases W_INT.
 230:Src/transport/usb/usb_board_link.cpp ****         // In particular HS_COMMIT follows the probe immediately. Wait within
 231:Src/transport/usb/usb_board_link.cpp ****         // this transaction's budget, then drain any newly asserted event;
 232:Src/transport/usb/usb_board_link.cpp ****         // never mistake "still releasing" for an empty, writable bus.
