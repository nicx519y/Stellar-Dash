 125:Cpp_Core/Src/firmware/firmware_manager.cpp **** // 验证固件元数据完整性
 126:Cpp_Core/Src/firmware/firmware_manager.cpp **** static FirmwareValidationResult validate_firmware_metadata(const FirmwareMetadata* metadata) {
 127:Cpp_Core/Src/firmware/firmware_manager.cpp ****     if (!metadata) {
