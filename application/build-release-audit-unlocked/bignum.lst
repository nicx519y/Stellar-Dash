1366:Libs/mbedtls/library/bignum.c ****     B.p = p;
1367:Libs/mbedtls/library/bignum.c **** 
1368:Libs/mbedtls/library/bignum.c ****     return mbedtls_mpi_add_mpi(X, A, &B);
1369:Libs/mbedtls/library/bignum.c **** }
