1020:Libs/mbedtls/library/aes.c **** /* VIA Padlock and our intrinsics-based implementation of AESNI require
1021:Libs/mbedtls/library/aes.c ****  * the round keys to be aligned on a 16-byte boundary. We take care of this
1022:Libs/mbedtls/library/aes.c ****  * before creating them, but the AES context may have moved (this can happen
1023:Libs/mbedtls/library/aes.c ****  * if the library is called from a language with managed memory), and in later
1024:Libs/mbedtls/library/aes.c ****  * calls it might have a different alignment with respect to 16-byte memory.
1025:Libs/mbedtls/library/aes.c ****  * So we may need to realign.
1026:Libs/mbedtls/library/aes.c ****  * NOTE: In the LTS branch, the context contains a pointer to within itself,
1027:Libs/mbedtls/library/aes.c ****  * so if it has been moved, things will probably go pear-shaped. We keep this
1028:Libs/mbedtls/library/aes.c ****  * code for compatibility with the development branch, in case of future changes.
1029:Libs/mbedtls/library/aes.c ****  */
1030:Libs/mbedtls/library/aes.c **** static void aes_maybe_realign(mbedtls_aes_context *ctx)
1031:Libs/mbedtls/library/aes.c **** {
1032:Libs/mbedtls/library/aes.c ****     unsigned current_offset = (unsigned) (ctx->rk - ctx->buf);
1033:Libs/mbedtls/library/aes.c ****     unsigned new_offset = mbedtls_aes_rk_offset(ctx->buf);
1034:Libs/mbedtls/library/aes.c ****     if (new_offset != current_offset) {
1035:Libs/mbedtls/library/aes.c ****         memmove(ctx->buf + new_offset,     // new address
1036:Libs/mbedtls/library/aes.c ****                 ctx->buf + current_offset, // current address
1037:Libs/mbedtls/library/aes.c ****                 (ctx->nr + 1) * 16);       // number of round keys * bytes per rk
1038:Libs/mbedtls/library/aes.c ****         ctx->rk = ctx->buf + new_offset;
1039:Libs/mbedtls/library/aes.c ****     }
1040:Libs/mbedtls/library/aes.c **** }
1041:Libs/mbedtls/library/aes.c **** #endif
1042:Libs/mbedtls/library/aes.c **** 
