 408:Libs/mbedtls/library/ecp.c **** /*
 409:Libs/mbedtls/library/ecp.c ****  * Check if we can do the next step
 410:Libs/mbedtls/library/ecp.c ****  */
 411:Libs/mbedtls/library/ecp.c **** int mbedtls_ecp_check_budget(const mbedtls_ecp_group *grp,
 412:Libs/mbedtls/library/ecp.c ****                              mbedtls_ecp_restart_ctx *rs_ctx,
 413:Libs/mbedtls/library/ecp.c ****                              unsigned ops)
 414:Libs/mbedtls/library/ecp.c **** {
 415:Libs/mbedtls/library/ecp.c ****     ECP_VALIDATE_RET(grp != NULL);
 416:Libs/mbedtls/library/ecp.c **** 
 417:Libs/mbedtls/library/ecp.c ****     if (rs_ctx != NULL && ecp_max_ops != 0) {
 418:Libs/mbedtls/library/ecp.c ****         /* scale depending on curve size: the chosen reference is 256-bit,
 419:Libs/mbedtls/library/ecp.c ****          * and multiplication is quadratic. Round to the closest integer. */
 420:Libs/mbedtls/library/ecp.c ****         if (grp->pbits >= 512) {
 421:Libs/mbedtls/library/ecp.c ****             ops *= 4;
 422:Libs/mbedtls/library/ecp.c ****         } else if (grp->pbits >= 384) {
 423:Libs/mbedtls/library/ecp.c ****             ops *= 2;
 424:Libs/mbedtls/library/ecp.c ****         }
 425:Libs/mbedtls/library/ecp.c **** 
 426:Libs/mbedtls/library/ecp.c ****         /* Avoid infinite loops: always allow first step.
 427:Libs/mbedtls/library/ecp.c ****          * Because of that, however, it's not generally true
 428:Libs/mbedtls/library/ecp.c ****          * that ops_done <= ecp_max_ops, so the check
 429:Libs/mbedtls/library/ecp.c ****          * ops_done > ecp_max_ops below is mandatory. */
 430:Libs/mbedtls/library/ecp.c ****         if ((rs_ctx->ops_done != 0) &&
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccosdxRQ.s 			page 9


 431:Libs/mbedtls/library/ecp.c ****             (rs_ctx->ops_done > ecp_max_ops ||
 432:Libs/mbedtls/library/ecp.c ****              ops > ecp_max_ops - rs_ctx->ops_done)) {
 433:Libs/mbedtls/library/ecp.c ****             return MBEDTLS_ERR_ECP_IN_PROGRESS;
 434:Libs/mbedtls/library/ecp.c ****         }
 435:Libs/mbedtls/library/ecp.c **** 
 436:Libs/mbedtls/library/ecp.c ****         /* update running count */
 437:Libs/mbedtls/library/ecp.c ****         rs_ctx->ops_done += ops;
 438:Libs/mbedtls/library/ecp.c ****     }
 439:Libs/mbedtls/library/ecp.c **** 
 440:Libs/mbedtls/library/ecp.c ****     return 0;
 441:Libs/mbedtls/library/ecp.c **** }
