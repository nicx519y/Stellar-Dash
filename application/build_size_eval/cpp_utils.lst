  80:Cpp_Core/Src/cpp_utils.cpp ****         if (!is_valid_utf8(str_value.c_str())) {
  81:Cpp_Core/Src/cpp_utils.cpp ****             LOG_ERROR("UTILS", "Failed to fix UTF-8 encoding, using fallback");
  82:Cpp_Core/Src/cpp_utils.cpp ****             std::string fallback;
