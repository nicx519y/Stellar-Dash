1301:Libs/mbedtls/library/bignum.c **** /* Common function for signed addition and subtraction.
1302:Libs/mbedtls/library/bignum.c ****  * Calculate A + B * flip_B where flip_B is 1 or -1.
1303:Libs/mbedtls/library/bignum.c ****  */
1304:Libs/mbedtls/library/bignum.c **** static int add_sub_mpi(mbedtls_mpi *X,
1305:Libs/mbedtls/library/bignum.c ****                        const mbedtls_mpi *A, const mbedtls_mpi *B,
1306:Libs/mbedtls/library/bignum.c ****                        int flip_B)
1307:Libs/mbedtls/library/bignum.c **** {
1308:Libs/mbedtls/library/bignum.c ****     int ret, s;
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccFcTTHc.s 			page 28


1309:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(X != NULL);
1310:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(A != NULL);
1311:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(B != NULL);
1312:Libs/mbedtls/library/bignum.c **** 
1313:Libs/mbedtls/library/bignum.c ****     s = A->s;
1314:Libs/mbedtls/library/bignum.c ****     if (A->s * B->s * flip_B < 0) {
1315:Libs/mbedtls/library/bignum.c ****         int cmp = mbedtls_mpi_cmp_abs(A, B);
1316:Libs/mbedtls/library/bignum.c ****         if (cmp >= 0) {
1317:Libs/mbedtls/library/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(X, A, B));
1318:Libs/mbedtls/library/bignum.c ****             /* If |A| = |B|, the result is 0 and we must set the sign bit
1319:Libs/mbedtls/library/bignum.c ****              * to +1 regardless of which of A or B was negative. Otherwise,
1320:Libs/mbedtls/library/bignum.c ****              * since |A| > |B|, the sign is the sign of A. */
1321:Libs/mbedtls/library/bignum.c ****             X->s = cmp == 0 ? 1 : s;
1322:Libs/mbedtls/library/bignum.c ****         } else {
1323:Libs/mbedtls/library/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(X, B, A));
1324:Libs/mbedtls/library/bignum.c ****             /* Since |A| < |B|, the sign is the opposite of A. */
1325:Libs/mbedtls/library/bignum.c ****             X->s = -s;
1326:Libs/mbedtls/library/bignum.c ****         }
1327:Libs/mbedtls/library/bignum.c ****     } else {
1328:Libs/mbedtls/library/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_add_abs(X, A, B));
1329:Libs/mbedtls/library/bignum.c ****         X->s = s;
1330:Libs/mbedtls/library/bignum.c ****     }
1331:Libs/mbedtls/library/bignum.c **** 
1332:Libs/mbedtls/library/bignum.c **** cleanup:
1333:Libs/mbedtls/library/bignum.c **** 
1334:Libs/mbedtls/library/bignum.c ****     return ret;
1335:Libs/mbedtls/library/bignum.c **** }
1336:Libs/mbedtls/library/bignum.c **** 
1337:Libs/mbedtls/library/bignum.c **** /*
1338:Libs/mbedtls/library/bignum.c ****  * Signed addition: X = A + B
1339:Libs/mbedtls/library/bignum.c ****  */
1340:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_add_mpi(mbedtls_mpi *X, const mbedtls_mpi *A, const mbedtls_mpi *B)
1341:Libs/mbedtls/library/bignum.c **** {
1342:Libs/mbedtls/library/bignum.c ****     return add_sub_mpi(X, A, B, 1);
1343:Libs/mbedtls/library/bignum.c **** }
1344:Libs/mbedtls/library/bignum.c **** 
1345:Libs/mbedtls/library/bignum.c **** /*
1346:Libs/mbedtls/library/bignum.c ****  * Signed subtraction: X = A - B
1347:Libs/mbedtls/library/bignum.c ****  */
1348:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_sub_mpi(mbedtls_mpi *X, const mbedtls_mpi *A, const mbedtls_mpi *B)
1349:Libs/mbedtls/library/bignum.c **** {
1350:Libs/mbedtls/library/bignum.c ****     return add_sub_mpi(X, A, B, -1);
1351:Libs/mbedtls/library/bignum.c **** }
1352:Libs/mbedtls/library/bignum.c **** 
1353:Libs/mbedtls/library/bignum.c **** /*
1354:Libs/mbedtls/library/bignum.c ****  * Signed addition: X = A + b
1355:Libs/mbedtls/library/bignum.c ****  */
1356:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_add_int(mbedtls_mpi *X, const mbedtls_mpi *A, mbedtls_mpi_sint b)
1357:Libs/mbedtls/library/bignum.c **** {
1358:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi B;
1359:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint p[1];
1360:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(X != NULL);
1361:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(A != NULL);
