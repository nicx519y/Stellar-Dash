  95:Libs/mbedtls/library/bignum.c **** /*
  96:Libs/mbedtls/library/bignum.c ****  * Enlarge to the specified number of limbs
  97:Libs/mbedtls/library/bignum.c ****  */
  98:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_grow(mbedtls_mpi *X, size_t nblimbs)
  99:Libs/mbedtls/library/bignum.c **** {
 100:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint *p;
 101:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(X != NULL);
 102:Libs/mbedtls/library/bignum.c **** 
 103:Libs/mbedtls/library/bignum.c ****     if (nblimbs > MBEDTLS_MPI_MAX_LIMBS) {
 104:Libs/mbedtls/library/bignum.c ****         return MBEDTLS_ERR_MPI_ALLOC_FAILED;
 105:Libs/mbedtls/library/bignum.c ****     }
 106:Libs/mbedtls/library/bignum.c **** 
 107:Libs/mbedtls/library/bignum.c ****     if (X->n < nblimbs) {
 108:Libs/mbedtls/library/bignum.c ****         if ((p = (mbedtls_mpi_uint *) mbedtls_calloc(nblimbs, ciL)) == NULL) {
 109:Libs/mbedtls/library/bignum.c ****             return MBEDTLS_ERR_MPI_ALLOC_FAILED;
 110:Libs/mbedtls/library/bignum.c ****         }
 111:Libs/mbedtls/library/bignum.c **** 
 112:Libs/mbedtls/library/bignum.c ****         if (X->p != NULL) {
 113:Libs/mbedtls/library/bignum.c ****             memcpy(p, X->p, X->n * ciL);
 114:Libs/mbedtls/library/bignum.c ****             mbedtls_mpi_zeroize(X->p, X->n);
 115:Libs/mbedtls/library/bignum.c ****             mbedtls_free(X->p);
 116:Libs/mbedtls/library/bignum.c ****         }
 117:Libs/mbedtls/library/bignum.c **** 
 118:Libs/mbedtls/library/bignum.c ****         X->n = nblimbs;
 119:Libs/mbedtls/library/bignum.c ****         X->p = p;
 120:Libs/mbedtls/library/bignum.c ****     }
 121:Libs/mbedtls/library/bignum.c **** 
 122:Libs/mbedtls/library/bignum.c ****     return 0;
 123:Libs/mbedtls/library/bignum.c **** }
