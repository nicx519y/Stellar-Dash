 364:../common/usb_board_link_protocol.h **** /*
 365:../common/usb_board_link_protocol.h ****  * Credits are receiver-owned absolute values, not deltas:
 366:../common/usb_board_link_protocol.h ****  * - CMD_BULK_CREDIT grants CH585 permission to emit 0x86 fragments.
 367:../common/usb_board_link_protocol.h ****  * - EVT_BULK_CREDIT grants STM32 permission to emit 0x06 traffic on non-
 368:../common/usb_board_link_protocol.h ****  *   WebConfig channels.
 369:../common/usb_board_link_protocol.h ****  * - WEBCONFIG never publishes EVT_BULK_CREDIT. STM32 pulls its current
 370:../common/usb_board_link_protocol.h ****  *   complete-report capacity through GET_WEBCONFIG_CREDIT and consumes that
 371:../common/usb_board_link_protocol.h ****  *   one slot across all BoardLink fragments. The slot is returned only after
 372:../common/usb_board_link_protocol.h ****  *   the report has completed USB EP1 IN, or after an explicit transport reset.
 373:../common/usb_board_link_protocol.h ****  * - Other channels retain one-credit-per-fragment behavior.
 374:../common/usb_board_link_protocol.h ****  */
