1936:Libs/mbedtls/library/bignum.c ****     n = N->n;
1937:Libs/mbedtls/library/bignum.c ****     m = (B->n < n) ? B->n : n;
1938:Libs/mbedtls/library/bignum.c **** 
1939:Libs/mbedtls/library/bignum.c ****     for (i = 0; i < n; i++) {
1940:Libs/mbedtls/library/bignum.c ****         /*
1941:Libs/mbedtls/library/bignum.c ****          * T = (T + u0*B + u1*N) / 2^biL
1942:Libs/mbedtls/library/bignum.c ****          */
1943:Libs/mbedtls/library/bignum.c ****         u0 = A->p[i];
1944:Libs/mbedtls/library/bignum.c ****         u1 = (d[0] + u0 * B->p[0]) * mm;
