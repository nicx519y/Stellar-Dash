 290:Cpp_Core/Src/configs/calibration_command_handler.cpp **** DeviceCommandResponse CalibrationCommandHandler::handle(const DeviceCommandRequest& request) {
 291:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     const std::string& command = request.getCommand();
 292:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     
 293:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     // 校准相关命令
 294:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     if (command == "start_manual_calibration") {
 295:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         return handleStartManualCalibration(request);
 296:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     } else if (command == "stop_manual_calibration") {
 297:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         return handleStopManualCalibration(request);
 298:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     } else if (command == "get_calibration_status") {
 299:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         return handleGetCalibrationStatus(request);
 300:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     } else if (command == "clear_manual_calibration_data") {
 301:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         return handleClearManualCalibrationData(request);
 302:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     } else if (command == "check_is_manual_calibration_completed") {
 303:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         return handleCheckIsManualCalibrationCompleted(request);
 304:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     }
 305:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     
 306:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     return create_error_response(request.getCid(), command, -1, "Unknown calibration command");
 307:Cpp_Core/Src/configs/calibration_command_handler.cpp **** }
