 125:Cpp_Core/Src/cpp_utils.cpp **** // 简单的哈希函数
 126:Cpp_Core/Src/cpp_utils.cpp **** static uint32_t simple_hash(const char* str) {
 127:Cpp_Core/Src/cpp_utils.cpp ****     uint32_t hash = 5381;
 128:Cpp_Core/Src/cpp_utils.cpp ****     int c;
 129:Cpp_Core/Src/cpp_utils.cpp ****     while ((c = *str++)) {
 130:Cpp_Core/Src/cpp_utils.cpp ****         hash = ((hash << 5) + hash) + c; // hash * 33 + c
 131:Cpp_Core/Src/cpp_utils.cpp ****     }
 132:Cpp_Core/Src/cpp_utils.cpp ****     return hash;
 133:Cpp_Core/Src/cpp_utils.cpp **** }
 134:Cpp_Core/Src/cpp_utils.cpp **** 
 135:Cpp_Core/Src/cpp_utils.cpp **** // 手动将32位整数转换为16进制字符串
 136:Cpp_Core/Src/cpp_utils.cpp **** static void uint32_to_hex(uint32_t value, char* hex_str, size_t size) {
 137:Cpp_Core/Src/cpp_utils.cpp ****     if (size < 9) return; // 需要至少9个字符（8个hex + null）
 138:Cpp_Core/Src/cpp_utils.cpp ****     
 139:Cpp_Core/Src/cpp_utils.cpp ****     const char hex_chars[] = "0123456789abcdef";
 140:Cpp_Core/Src/cpp_utils.cpp ****     for (int i = 7; i >= 0; i--) {
 141:Cpp_Core/Src/cpp_utils.cpp ****         hex_str[i] = hex_chars[value & 0xF];
 142:Cpp_Core/Src/cpp_utils.cpp ****         value >>= 4;
 143:Cpp_Core/Src/cpp_utils.cpp ****     }
 144:Cpp_Core/Src/cpp_utils.cpp ****     hex_str[8] = '\0';
 145:Cpp_Core/Src/cpp_utils.cpp **** }
 146:Cpp_Core/Src/cpp_utils.cpp **** 
 147:Cpp_Core/Src/cpp_utils.cpp **** std::string generate_unique_id(const char* name) {
 148:Cpp_Core/Src/cpp_utils.cpp ****     if (!name) {
 149:Cpp_Core/Src/cpp_utils.cpp ****         return "unknown-0";
 150:Cpp_Core/Src/cpp_utils.cpp ****     }
 151:Cpp_Core/Src/cpp_utils.cpp ****     
 152:Cpp_Core/Src/cpp_utils.cpp ****     // 获取当前时间戳（毫秒）
 153:Cpp_Core/Src/cpp_utils.cpp ****     uint32_t timestamp = HAL_GetTick();
 154:Cpp_Core/Src/cpp_utils.cpp ****     
 155:Cpp_Core/Src/cpp_utils.cpp ****     // 使用递增计数器确保同一毫秒内的唯一性
 156:Cpp_Core/Src/cpp_utils.cpp ****     static uint32_t counter = 0;
 157:Cpp_Core/Src/cpp_utils.cpp ****     counter++;
 158:Cpp_Core/Src/cpp_utils.cpp ****     
 159:Cpp_Core/Src/cpp_utils.cpp ****     // 使用简单的伪随机数生成
 160:Cpp_Core/Src/cpp_utils.cpp ****     static uint32_t seed = 0;
 161:Cpp_Core/Src/cpp_utils.cpp ****     seed = seed * 1103515245 + 12345;
 162:Cpp_Core/Src/cpp_utils.cpp ****     uint32_t random_num = (seed >> 16) & 0x7FFF; // 15位随机数
 163:Cpp_Core/Src/cpp_utils.cpp ****     
 164:Cpp_Core/Src/cpp_utils.cpp ****     // 计算name的哈希值
 165:Cpp_Core/Src/cpp_utils.cpp ****     uint32_t name_hash = simple_hash(name);
 166:Cpp_Core/Src/cpp_utils.cpp ****     
 167:Cpp_Core/Src/cpp_utils.cpp ****     // 组合所有元素生成最终哈希，确保不为0
 168:Cpp_Core/Src/cpp_utils.cpp ****     // 使用更复杂的组合方式：timestamp + counter + random_num + name_hash
 169:Cpp_Core/Src/cpp_utils.cpp ****     uint32_t combined_hash = timestamp + (counter << 16) + random_num + name_hash;
 170:Cpp_Core/Src/cpp_utils.cpp ****     if (combined_hash == 0) {
 171:Cpp_Core/Src/cpp_utils.cpp ****         combined_hash = timestamp ^ counter ^ random_num ^ name_hash; // 备用组合方式
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccE0Gu7g.s 			page 79


 172:Cpp_Core/Src/cpp_utils.cpp ****     }
 173:Cpp_Core/Src/cpp_utils.cpp ****     
 174:Cpp_Core/Src/cpp_utils.cpp ****     // 手动转换为16进制字符串
 175:Cpp_Core/Src/cpp_utils.cpp ****     char hex_str[9];
 176:Cpp_Core/Src/cpp_utils.cpp ****     uint32_to_hex(combined_hash, hex_str, sizeof(hex_str));
 177:Cpp_Core/Src/cpp_utils.cpp ****     
 178:Cpp_Core/Src/cpp_utils.cpp ****     // 只返回16进制后缀作为ID
 179:Cpp_Core/Src/cpp_utils.cpp ****     return std::string(hex_str);
 180:Cpp_Core/Src/cpp_utils.cpp **** }
