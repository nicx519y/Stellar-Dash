 158:Libs/mbedtls/library/ecdsa.c **** /* Call this when entering a function that needs its own sub-context */
 159:Libs/mbedtls/library/ecdsa.c **** #define ECDSA_RS_ENTER(SUB)   do {                                 \
 160:Libs/mbedtls/library/ecdsa.c ****         /* reset ops count for this call if top-level */                 \
 161:Libs/mbedtls/library/ecdsa.c ****         if (rs_ctx != NULL && rs_ctx->ecp.depth++ == 0)                 \
 162:Libs/mbedtls/library/ecdsa.c ****         rs_ctx->ecp.ops_done = 0;                                    \
 163:Libs/mbedtls/library/ecdsa.c ****                                                                      \
 164:Libs/mbedtls/library/ecdsa.c ****         /* set up our own sub-context if needed */                       \
 165:Libs/mbedtls/library/ecdsa.c ****         if (mbedtls_ecp_restart_is_enabled() &&                          \
 166:Libs/mbedtls/library/ecdsa.c ****             rs_ctx != NULL && rs_ctx->SUB == NULL)                      \
 167:Libs/mbedtls/library/ecdsa.c ****         {                                                                \
 168:Libs/mbedtls/library/ecdsa.c ****             rs_ctx->SUB = mbedtls_calloc(1, sizeof(*rs_ctx->SUB));   \
 169:Libs/mbedtls/library/ecdsa.c ****             if (rs_ctx->SUB == NULL)                                    \
 170:Libs/mbedtls/library/ecdsa.c ****             return MBEDTLS_ERR_ECP_ALLOC_FAILED;                  \
 171:Libs/mbedtls/library/ecdsa.c ****                                                                    \
 172:Libs/mbedtls/library/ecdsa.c ****             ecdsa_restart_## SUB ##_init(rs_ctx->SUB);                 \
 173:Libs/mbedtls/library/ecdsa.c ****         }                                                                \
 174:Libs/mbedtls/library/ecdsa.c **** } while (0)
 175:Libs/mbedtls/library/ecdsa.c **** 
 176:Libs/mbedtls/library/ecdsa.c **** /* Call this when leaving a function that needs its own sub-context */
 177:Libs/mbedtls/library/ecdsa.c **** #define ECDSA_RS_LEAVE(SUB)   do {                                 \
 178:Libs/mbedtls/library/ecdsa.c ****         /* clear our sub-context when not in progress (done or error) */ \
 179:Libs/mbedtls/library/ecdsa.c ****         if (rs_ctx != NULL && rs_ctx->SUB != NULL &&                     \
 180:Libs/mbedtls/library/ecdsa.c ****             ret != MBEDTLS_ERR_ECP_IN_PROGRESS)                         \
 181:Libs/mbedtls/library/ecdsa.c ****         {                                                                \
 182:Libs/mbedtls/library/ecdsa.c ****             ecdsa_restart_## SUB ##_free(rs_ctx->SUB);                 \
 183:Libs/mbedtls/library/ecdsa.c ****             mbedtls_free(rs_ctx->SUB);                                 \
 184:Libs/mbedtls/library/ecdsa.c ****             rs_ctx->SUB = NULL;                                          \
 185:Libs/mbedtls/library/ecdsa.c ****         }                                                                \
 186:Libs/mbedtls/library/ecdsa.c ****                                                                      \
 187:Libs/mbedtls/library/ecdsa.c ****         if (rs_ctx != NULL)                                             \
 188:Libs/mbedtls/library/ecdsa.c ****         rs_ctx->ecp.depth--;                                         \
 189:Libs/mbedtls/library/ecdsa.c **** } while (0)
