  47:Src/webconfig/configs/ms_mark_command_handler.cpp ****     char* json_string = cJSON_PrintUnformatted(json);
  48:Src/webconfig/configs/ms_mark_command_handler.cpp ****     if (json_string) {
  49:Src/webconfig/configs/ms_mark_command_handler.cpp ****         ConfigTransport_PublishJson(json_string, strlen(json_string));
  50:Src/webconfig/configs/ms_mark_command_handler.cpp ****         // APP_DBG("sendMarkingStatusNotification: Marking status notification sent - %s", json_str
  51:Src/webconfig/configs/ms_mark_command_handler.cpp ****         free(json_string);
  52:Src/webconfig/configs/ms_mark_command_handler.cpp ****     } else {
  53:Src/webconfig/configs/ms_mark_command_handler.cpp ****         LOG_ERROR("DeviceCommand", "Failed to serialize notification JSON");
  54:Src/webconfig/configs/ms_mark_command_handler.cpp ****     }
  55:Src/webconfig/configs/ms_mark_command_handler.cpp ****     
  56:Src/webconfig/configs/ms_mark_command_handler.cpp ****     cJSON_Delete(json);
  57:Src/webconfig/configs/ms_mark_command_handler.cpp **** }
