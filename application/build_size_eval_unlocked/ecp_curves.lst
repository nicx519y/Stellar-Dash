 564:Libs/mbedtls/library/ecp_curves.c ****     ecp_mpi_set1(&grp->G.Z);
 565:Libs/mbedtls/library/ecp_curves.c **** 
 566:Libs/mbedtls/library/ecp_curves.c ****     grp->pbits = mbedtls_mpi_bitlen(&grp->P);
 567:Libs/mbedtls/library/ecp_curves.c ****     grp->nbits = mbedtls_mpi_bitlen(&grp->N);
 568:Libs/mbedtls/library/ecp_curves.c **** 
 569:Libs/mbedtls/library/ecp_curves.c ****     grp->h = 1;
 570:Libs/mbedtls/library/ecp_curves.c **** 
 571:Libs/mbedtls/library/ecp_curves.c ****     return 0;
 572:Libs/mbedtls/library/ecp_curves.c **** }
