 604:Src/transport/usb/usb_board_link_port.cpp ****                     start = at;
 605:Src/transport/usb/usb_board_link_port.cpp ****                     total = 4u + sizeof(usb_board_role_selected_v1_t);
 606:Src/transport/usb/usb_board_link_port.cpp ****                 }
 607:Src/transport/usb/usb_board_link_port.cpp ****             }
 608:Src/transport/usb/usb_board_link_port.cpp ****             if (total && count == start + total) {
 609:Src/transport/usb/usb_board_link_port.cpp ****                 usb_board_link_frame_t reply = {};
