 838:Src/input/adc_btns/adc_manager.cpp **** 
 839:Src/input/adc_btns/adc_manager.cpp ****     store.num--;
 840:Src/input/adc_btns/adc_manager.cpp **** 
 841:Src/input/adc_btns/adc_manager.cpp ****     // 保存更新后的存储结构
 842:Src/input/adc_btns/adc_manager.cpp ****     if (saveStore() != QSPI_W25Qxx_OK)
 843:Src/input/adc_btns/adc_manager.cpp ****     {
 844:Src/input/adc_btns/adc_manager.cpp ****         if (targetIdx < store.num)
 845:Src/input/adc_btns/adc_manager.cpp ****         {
 846:Src/input/adc_btns/adc_manager.cpp ****             memmove(&store.mapping[targetIdx + 1],
 847:Src/input/adc_btns/adc_manager.cpp ****                     &store.mapping[targetIdx],
 848:Src/input/adc_btns/adc_manager.cpp ****                     (store.num - targetIdx) * sizeof(ADCValuesMapping));
 849:Src/input/adc_btns/adc_manager.cpp ****         }
