  34:Libs/mbedtls/library/ecp.c **** /**
  35:Libs/mbedtls/library/ecp.c ****  * \brief Function level alternative implementation.
  36:Libs/mbedtls/library/ecp.c ****  *
  37:Libs/mbedtls/library/ecp.c ****  * The MBEDTLS_ECP_INTERNAL_ALT macro enables alternative implementations to
  38:Libs/mbedtls/library/ecp.c ****  * replace certain functions in this module. The alternative implementations are
  39:Libs/mbedtls/library/ecp.c ****  * typically hardware accelerators and need to activate the hardware before the
  40:Libs/mbedtls/library/ecp.c ****  * computation starts and deactivate it after it finishes. The
  41:Libs/mbedtls/library/ecp.c ****  * mbedtls_internal_ecp_init() and mbedtls_internal_ecp_free() functions serve
  42:Libs/mbedtls/library/ecp.c ****  * this purpose.
  43:Libs/mbedtls/library/ecp.c ****  *
  44:Libs/mbedtls/library/ecp.c ****  * To preserve the correct functionality the following conditions must hold:
  45:Libs/mbedtls/library/ecp.c ****  *
  46:Libs/mbedtls/library/ecp.c ****  * - The alternative implementation must be activated by
  47:Libs/mbedtls/library/ecp.c ****  *   mbedtls_internal_ecp_init() before any of the replaceable functions is
  48:Libs/mbedtls/library/ecp.c ****  *   called.
  49:Libs/mbedtls/library/ecp.c ****  * - mbedtls_internal_ecp_free() must \b only be called when the alternative
  50:Libs/mbedtls/library/ecp.c ****  *   implementation is activated.
  51:Libs/mbedtls/library/ecp.c ****  * - mbedtls_internal_ecp_init() must \b not be called when the alternative
  52:Libs/mbedtls/library/ecp.c ****  *   implementation is activated.
  53:Libs/mbedtls/library/ecp.c ****  * - Public functions must not return while the alternative implementation is
  54:Libs/mbedtls/library/ecp.c ****  *   activated.
  55:Libs/mbedtls/library/ecp.c ****  * - Replaceable functions are guarded by \c MBEDTLS_ECP_XXX_ALT macros and
  56:Libs/mbedtls/library/ecp.c ****  *   before calling them an \code if( mbedtls_internal_ecp_grp_capable( grp ) )
  57:Libs/mbedtls/library/ecp.c ****  *   \endcode ensures that the alternative implementation supports the current
  58:Libs/mbedtls/library/ecp.c ****  *   group.
  59:Libs/mbedtls/library/ecp.c ****  */
  60:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_ECP_INTERNAL_ALT)
  61:Libs/mbedtls/library/ecp.c **** #endif
  62:Libs/mbedtls/library/ecp.c **** 
