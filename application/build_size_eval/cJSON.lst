 185:Libs/cJSON/cJSON.c **** 
 186:Libs/cJSON/cJSON.c **** static internal_hooks global_hooks = { internal_malloc, internal_free, internal_realloc };
 187:Libs/cJSON/cJSON.c **** 
 188:Libs/cJSON/cJSON.c **** static unsigned char* cJSON_strdup(const unsigned char* string, const internal_hooks * const hooks)
 189:Libs/cJSON/cJSON.c **** {
 190:Libs/cJSON/cJSON.c ****     size_t length = 0;
 191:Libs/cJSON/cJSON.c ****     unsigned char *copy = NULL;
 192:Libs/cJSON/cJSON.c **** 
 193:Libs/cJSON/cJSON.c ****     if (string == NULL)
 194:Libs/cJSON/cJSON.c ****     {
 195:Libs/cJSON/cJSON.c ****         return NULL;
 196:Libs/cJSON/cJSON.c ****     }
 197:Libs/cJSON/cJSON.c **** 
 198:Libs/cJSON/cJSON.c ****     length = strlen((const char*)string) + sizeof("");
 199:Libs/cJSON/cJSON.c ****     copy = (unsigned char*)hooks->allocate(length);
 200:Libs/cJSON/cJSON.c ****     if (copy == NULL)
 201:Libs/cJSON/cJSON.c ****     {
 202:Libs/cJSON/cJSON.c ****         return NULL;
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccWtILFT.s 			page 5


 203:Libs/cJSON/cJSON.c ****     }
 204:Libs/cJSON/cJSON.c ****     memcpy(copy, string, length);
 205:Libs/cJSON/cJSON.c **** 
 206:Libs/cJSON/cJSON.c ****     return copy;
 207:Libs/cJSON/cJSON.c **** }
