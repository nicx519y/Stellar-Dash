 533:Cpp_Core/Src/adc_btns/adc_calibration.cpp **** void ADCCalibrationManager::checkCalibrationCompletion() {
 534:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     // 检查是否所有按键都已校准完成或出错
 535:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     bool allCompleted = true;
 536:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     for (uint8_t i = 0; i < NUM_ADC_BUTTONS; i++) {
 537:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 检查按键是否启用
 538:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         if (!(enabledKeysMask & (1 << i))) {
 539:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             continue; // 跳过未启用的按键
 540:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         }
 541:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 542:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         CalibrationPhase phase = buttonStates[i].phase;
 543:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         if (phase == CalibrationPhase::BOTTOM_SAMPLING || 
 544:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             phase == CalibrationPhase::TOP_SAMPLING) {
 545:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             allCompleted = false;
 546:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             break;
 547:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         }
 548:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     }
 549:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
 550:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     // 只有在状态发生变化时才执行昂贵的操作
 551:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     if (allCompleted && calibrationActive && !completionCheckExecuted) {
 552:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         completionCheckExecuted = true; // 标记已执行，防止重复执行
 553:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 554:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         APP_DBG("All buttons calibration completed, executing completion check once");
 555:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 556:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 不自动退出校准状态，只做数据保存和LED更新
 557:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // calibrationActive = false; // 注释掉或删除
