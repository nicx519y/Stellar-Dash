 443:Libs/mbedtls/library/ecp.c **** /* Call this when entering a function that needs its own sub-context */
 444:Libs/mbedtls/library/ecp.c **** #define ECP_RS_ENTER(SUB)   do {                                      \
 445:Libs/mbedtls/library/ecp.c ****         /* reset ops count for this call if top-level */                    \
 446:Libs/mbedtls/library/ecp.c ****         if (rs_ctx != NULL && rs_ctx->depth++ == 0)                        \
 447:Libs/mbedtls/library/ecp.c ****         rs_ctx->ops_done = 0;                                           \
 448:Libs/mbedtls/library/ecp.c ****                                                                         \
 449:Libs/mbedtls/library/ecp.c ****         /* set up our own sub-context if needed */                          \
 450:Libs/mbedtls/library/ecp.c ****         if (mbedtls_ecp_restart_is_enabled() &&                             \
 451:Libs/mbedtls/library/ecp.c ****             rs_ctx != NULL && rs_ctx->SUB == NULL)                         \
 452:Libs/mbedtls/library/ecp.c ****         {                                                                   \
 453:Libs/mbedtls/library/ecp.c ****             rs_ctx->SUB = mbedtls_calloc(1, sizeof(*rs_ctx->SUB));      \
 454:Libs/mbedtls/library/ecp.c ****             if (rs_ctx->SUB == NULL)                                       \
 455:Libs/mbedtls/library/ecp.c ****             return MBEDTLS_ERR_ECP_ALLOC_FAILED;                     \
 456:Libs/mbedtls/library/ecp.c ****                                                                       \
 457:Libs/mbedtls/library/ecp.c ****             ecp_restart_## SUB ##_init(rs_ctx->SUB);                      \
 458:Libs/mbedtls/library/ecp.c ****         }                                                                   \
 459:Libs/mbedtls/library/ecp.c **** } while (0)
 460:Libs/mbedtls/library/ecp.c **** 
 461:Libs/mbedtls/library/ecp.c **** /* Call this when leaving a function that needs its own sub-context */
 462:Libs/mbedtls/library/ecp.c **** #define ECP_RS_LEAVE(SUB)   do {                                      \
 463:Libs/mbedtls/library/ecp.c ****         /* clear our sub-context when not in progress (done or error) */    \
 464:Libs/mbedtls/library/ecp.c ****         if (rs_ctx != NULL && rs_ctx->SUB != NULL &&                        \
 465:Libs/mbedtls/library/ecp.c ****             ret != MBEDTLS_ERR_ECP_IN_PROGRESS)                            \
 466:Libs/mbedtls/library/ecp.c ****         {                                                                   \
 467:Libs/mbedtls/library/ecp.c ****             ecp_restart_## SUB ##_free(rs_ctx->SUB);                      \
 468:Libs/mbedtls/library/ecp.c ****             mbedtls_free(rs_ctx->SUB);                                    \
 469:Libs/mbedtls/library/ecp.c ****             rs_ctx->SUB = NULL;                                             \
 470:Libs/mbedtls/library/ecp.c ****         }                                                                   \
 471:Libs/mbedtls/library/ecp.c ****                                                                         \
 472:Libs/mbedtls/library/ecp.c ****         if (rs_ctx != NULL)                                                \
 473:Libs/mbedtls/library/ecp.c ****         rs_ctx->depth--;                                                \
 474:Libs/mbedtls/library/ecp.c **** } while (0)
 475:Libs/mbedtls/library/ecp.c **** 
 476:Libs/mbedtls/library/ecp.c **** #else /* MBEDTLS_ECP_RESTARTABLE */
 477:Libs/mbedtls/library/ecp.c **** 
