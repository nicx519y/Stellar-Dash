 522:Libs/mbedtls/library/ecp_curves.c **** /*
 523:Libs/mbedtls/library/ecp_curves.c ****  * Create an MPI from embedded constants
 524:Libs/mbedtls/library/ecp_curves.c ****  * (assumes len is an exact multiple of sizeof(mbedtls_mpi_uint))
 525:Libs/mbedtls/library/ecp_curves.c ****  */
 526:Libs/mbedtls/library/ecp_curves.c **** static inline void ecp_mpi_load(mbedtls_mpi *X, const mbedtls_mpi_uint *p, size_t len)
 527:Libs/mbedtls/library/ecp_curves.c **** {
 528:Libs/mbedtls/library/ecp_curves.c ****     X->s = 1;
 529:Libs/mbedtls/library/ecp_curves.c ****     X->n = len / sizeof(mbedtls_mpi_uint);
 530:Libs/mbedtls/library/ecp_curves.c ****     X->p = (mbedtls_mpi_uint *) p;
 531:Libs/mbedtls/library/ecp_curves.c **** }
 532:Libs/mbedtls/library/ecp_curves.c **** 
 533:Libs/mbedtls/library/ecp_curves.c **** /*
 534:Libs/mbedtls/library/ecp_curves.c ****  * Set an MPI to static value 1
 535:Libs/mbedtls/library/ecp_curves.c ****  */
 536:Libs/mbedtls/library/ecp_curves.c **** static inline void ecp_mpi_set1(mbedtls_mpi *X)
 537:Libs/mbedtls/library/ecp_curves.c **** {
 538:Libs/mbedtls/library/ecp_curves.c ****     static const mbedtls_mpi_uint one[] = { 1 };
 539:Libs/mbedtls/library/ecp_curves.c ****     X->s = 1;
 540:Libs/mbedtls/library/ecp_curves.c ****     X->n = 1;
 541:Libs/mbedtls/library/ecp_curves.c ****     X->p = (mbedtls_mpi_uint *) one; /* X->p will not be modified so the cast is safe */
 542:Libs/mbedtls/library/ecp_curves.c **** }
 543:Libs/mbedtls/library/ecp_curves.c **** 
