   8:Cpp_Core/Inc/configs/firmware_command_handler.hpp **** #define BINARY_CMD_UPLOAD_FIRMWARE_CHUNK 0x01
   9:Cpp_Core/Inc/configs/firmware_command_handler.hpp **** 
  10:Cpp_Core/Inc/configs/firmware_command_handler.hpp **** // 二进制固件分片头部结构（106字节固定大小）
  11:Cpp_Core/Inc/configs/firmware_command_handler.hpp **** #pragma pack(push, 1)
  12:Cpp_Core/Inc/configs/firmware_command_handler.hpp **** struct BinaryFirmwareChunkHeader {
  13:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint8_t command;                    // 命令类型 (BINARY_CMD_UPLOAD_FIRMWARE_CHUNK)
  14:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint8_t reserved1;                  // 保留字节，用于对齐
  15:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint16_t session_id_len;            // session_id字符串长度
  16:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     char session_id[32];                // session_id字符串（固定32字节，不足补0）
  17:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint16_t component_name_len;        // component_name字符串长度  
  18:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     char component_name[16];            // component_name字符串（固定16字节，不足补0）
  19:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint32_t chunk_index;               // 分片索引
  20:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint32_t total_chunks;              // 总分片数
  21:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint32_t chunk_size;                // 分片大小
  22:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint32_t chunk_offset;              // 分片偏移
  23:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint32_t target_address;            // 目标地址
  24:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****     uint8_t checksum[32];               // 完整SHA256校验和
  25:Cpp_Core/Inc/configs/firmware_command_handler.hpp **** };
  26:Cpp_Core/Inc/configs/firmware_command_handler.hpp **** #pragma pack(pop)
  27:Cpp_Core/Inc/configs/firmware_command_handler.hpp **** static_assert(sizeof(BinaryFirmwareChunkHeader) == 106,
  28:Cpp_Core/Inc/configs/firmware_command_handler.hpp ****               "BinaryFirmwareChunkHeader ABI mismatch");
