 116:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****   // 24.4.1 Reverse iterators
 117:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****   /**
 118:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  Bidirectional and random access iterators have corresponding reverse
 119:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  %iterator adaptors that iterate through the data structure in the
 120:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  opposite direction.  They have the same signatures as the corresponding
 121:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  iterators.  The fundamental relation between a reverse %iterator and its
 122:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  corresponding %iterator @c i is established by the identity:
 123:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  @code
 124:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *      &*(reverse_iterator(i)) == &*(i - 1)
 125:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  @endcode
 126:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *
 127:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  <em>This mapping is dictated by the fact that while there is always a
 128:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  pointer past the end of an array, there might not be a valid pointer
 129:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  before the beginning of an array.</em> [24.4.1]/1,2
 130:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *
 131:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  Reverse iterators can be tricky and surprising at first.  Their
 132:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  semantics make sense, however, and the trickiness is a side effect of
 133:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****    *  the requirement that the iterators must be safe.
 134:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****   */
 135:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****   template<typename _Iterator>
 136:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****     class reverse_iterator
 137:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****     : public iterator<typename iterator_traits<_Iterator>::iterator_category,
 138:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h **** 		      typename iterator_traits<_Iterator>::value_type,
 139:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h **** 		      typename iterator_traits<_Iterator>::difference_type,
 140:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h **** 		      typename iterator_traits<_Iterator>::pointer,
 141:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****                       typename iterator_traits<_Iterator>::reference>
 142:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****     {
 143:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h ****       template<typename _Iter>
 144:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_iterator.h **** 	friend class reverse_iterator;
