 186:Libs/mbedtls/library/ecp.c **** 
 187:Libs/mbedtls/library/ecp.c **** /* DRBG context free */
 188:Libs/mbedtls/library/ecp.c **** static inline void ecp_drbg_free(ecp_drbg_context *ctx)
 189:Libs/mbedtls/library/ecp.c **** {
 190:Libs/mbedtls/library/ecp.c ****     mbedtls_ctr_drbg_free(ctx);
 191:Libs/mbedtls/library/ecp.c **** }
 192:Libs/mbedtls/library/ecp.c **** 
 193:Libs/mbedtls/library/ecp.c **** /* DRBG function */
 194:Libs/mbedtls/library/ecp.c **** static inline int ecp_drbg_random(void *p_rng,
 195:Libs/mbedtls/library/ecp.c ****                                   unsigned char *output, size_t output_len)
 196:Libs/mbedtls/library/ecp.c **** {
 197:Libs/mbedtls/library/ecp.c ****     return mbedtls_ctr_drbg_random(p_rng, output, output_len);
 198:Libs/mbedtls/library/ecp.c **** }
 199:Libs/mbedtls/library/ecp.c **** 
 200:Libs/mbedtls/library/ecp.c **** /*
 201:Libs/mbedtls/library/ecp.c ****  * Since CTR_DRBG doesn't have a seed_buf() function the way HMAC_DRBG does,
 202:Libs/mbedtls/library/ecp.c ****  * we need to pass an entropy function when seeding. So we use a dummy
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccQL5QWa.s 			page 5


 203:Libs/mbedtls/library/ecp.c ****  * function for that, and pass the actual entropy as customisation string.
 204:Libs/mbedtls/library/ecp.c ****  * (During seeding of CTR_DRBG the entropy input and customisation string are
 205:Libs/mbedtls/library/ecp.c ****  * concatenated before being used to update the secret state.)
 206:Libs/mbedtls/library/ecp.c ****  */
 207:Libs/mbedtls/library/ecp.c **** static int ecp_ctr_drbg_null_entropy(void *ctx, unsigned char *out, size_t len)
 208:Libs/mbedtls/library/ecp.c **** {
 209:Libs/mbedtls/library/ecp.c ****     (void) ctx;
 210:Libs/mbedtls/library/ecp.c ****     memset(out, 0, len);
 211:Libs/mbedtls/library/ecp.c ****     return 0;
 212:Libs/mbedtls/library/ecp.c **** }
 213:Libs/mbedtls/library/ecp.c **** 
 214:Libs/mbedtls/library/ecp.c **** /* DRBG context seeding */
 215:Libs/mbedtls/library/ecp.c **** static int ecp_drbg_seed(ecp_drbg_context *ctx,
 216:Libs/mbedtls/library/ecp.c ****                          const mbedtls_mpi *secret, size_t secret_len)
 217:Libs/mbedtls/library/ecp.c **** {
 218:Libs/mbedtls/library/ecp.c ****     int ret;
