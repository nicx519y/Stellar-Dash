 172:Libs/mbedtls/library/gcm.c ****  * Sets output to x times H using the precomputed tables.
 173:Libs/mbedtls/library/gcm.c ****  * x and output are seen as elements of GF(2^128) as in [MGV].
 174:Libs/mbedtls/library/gcm.c ****  */
 175:Libs/mbedtls/library/gcm.c **** static void gcm_mult(mbedtls_gcm_context *ctx, const unsigned char x[16],
 176:Libs/mbedtls/library/gcm.c ****                      unsigned char output[16])
