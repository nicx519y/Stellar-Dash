 112:Libs/mbedtls/library/constant_time.c **** /** Constant-flow mask generation for "less than" comparison:
 113:Libs/mbedtls/library/constant_time.c ****  * - if \p x < \p y, return all-bits 1, that is (size_t) -1
 114:Libs/mbedtls/library/constant_time.c ****  * - otherwise, return all bits 0, that is 0
 115:Libs/mbedtls/library/constant_time.c ****  *
 116:Libs/mbedtls/library/constant_time.c ****  * This function can be used to write constant-time code by replacing branches
 117:Libs/mbedtls/library/constant_time.c ****  * with bit operations using masks.
 118:Libs/mbedtls/library/constant_time.c ****  *
 119:Libs/mbedtls/library/constant_time.c ****  * \param x     The first value to analyze.
 120:Libs/mbedtls/library/constant_time.c ****  * \param y     The second value to analyze.
 121:Libs/mbedtls/library/constant_time.c ****  *
 122:Libs/mbedtls/library/constant_time.c ****  * \return      All-bits-one if \p x is less than \p y, otherwise zero.
 123:Libs/mbedtls/library/constant_time.c ****  */
 124:Libs/mbedtls/library/constant_time.c **** static size_t mbedtls_ct_size_mask_lt(size_t x,
 125:Libs/mbedtls/library/constant_time.c ****                                       size_t y)
 126:Libs/mbedtls/library/constant_time.c **** {
 127:Libs/mbedtls/library/constant_time.c ****     /* This has the most significant bit set if and only if x < y */
 128:Libs/mbedtls/library/constant_time.c ****     const size_t sub = x - y;
 129:Libs/mbedtls/library/constant_time.c **** 
 130:Libs/mbedtls/library/constant_time.c ****     /* sub1 = (x < y) ? 1 : 0 */
 131:Libs/mbedtls/library/constant_time.c ****     const size_t sub1 = sub >> (sizeof(sub) * 8 - 1);
 132:Libs/mbedtls/library/constant_time.c **** 
 133:Libs/mbedtls/library/constant_time.c ****     /* mask = (x < y) ? 0xff... : 0x00... */
 134:Libs/mbedtls/library/constant_time.c ****     const size_t mask = mbedtls_ct_size_mask(sub1);
 135:Libs/mbedtls/library/constant_time.c **** 
 136:Libs/mbedtls/library/constant_time.c ****     return mask;
 137:Libs/mbedtls/library/constant_time.c **** }
 138:Libs/mbedtls/library/constant_time.c **** 
 139:Libs/mbedtls/library/constant_time.c **** size_t mbedtls_ct_size_mask_ge(size_t x,
 140:Libs/mbedtls/library/constant_time.c ****                                size_t y)
 141:Libs/mbedtls/library/constant_time.c **** {
 142:Libs/mbedtls/library/constant_time.c ****     return ~mbedtls_ct_size_mask_lt(x, y);
 143:Libs/mbedtls/library/constant_time.c **** }
 144:Libs/mbedtls/library/constant_time.c **** 
 145:Libs/mbedtls/library/constant_time.c **** #endif /* defined(MBEDTLS_SSL_SOME_SUITES_USE_TLS_CBC) || defined(MBEDTLS_NIST_KW_C) ||
