 408:../common/usb_board_link_protocol.h **** /*
 409:../common/usb_board_link_protocol.h ****  * Credits are receiver-owned absolute values, not deltas:
 410:../common/usb_board_link_protocol.h ****  * - CMD_BULK_CREDIT grants CH585 permission to emit 0x86 fragments.
 411:../common/usb_board_link_protocol.h ****  * - EVT_BULK_CREDIT grants STM32 permission to emit 0x06 traffic on non-
 412:../common/usb_board_link_protocol.h ****  *   WebConfig channels.
 413:../common/usb_board_link_protocol.h ****  * - WEBCONFIG never publishes EVT_BULK_CREDIT. STM32 pulls its current
 414:../common/usb_board_link_protocol.h ****  *   complete-report capacity through GET_WEBCONFIG_CREDIT and consumes that
 415:../common/usb_board_link_protocol.h ****  *   one slot across all BoardLink fragments. The slot is returned only after
 416:../common/usb_board_link_protocol.h ****  *   the report has completed USB EP1 IN, or after an explicit transport reset.
 417:../common/usb_board_link_protocol.h ****  * - Other channels retain one-credit-per-fragment behavior.
 418:../common/usb_board_link_protocol.h ****  */
