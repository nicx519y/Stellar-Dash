 699:Drivers/PWM-WS2812B/pwm-ws2812b.c **** void WS2812B_RefreshStrip(WS2812B_Strip strip, const uint16_t start, const uint16_t length)
 700:Drivers/PWM-WS2812B/pwm-ws2812b.c **** {
 701:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     /* A direct refresh is only safe before circular DMA starts.  Runtime
 702:Drivers/PWM-WS2812B/pwm-ws2812b.c ****      * callers are routed through the HT/TC inactive-half transaction. */
 703:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     if (WS2812B_GetStateStrip(strip) == WS2812B_RUNNING) {
 704:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         (void)WS2812B_SubmitStrip(strip);
 705:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         return;
 706:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     }
 707:Drivers/PWM-WS2812B/pwm-ws2812b.c **** 
 708:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     const uint16_t led_count = strip_led_count(strip);
 709:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     memcpy(strip_submitted_colors(strip), strip_colors(strip),
 710:Drivers/PWM-WS2812B/pwm-ws2812b.c ****            (uint32_t)led_count * 3u);
 711:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     memcpy(strip_submitted_brightness(strip), strip_brightness(strip),
 712:Drivers/PWM-WS2812B/pwm-ws2812b.c ****            (uint32_t)led_count);
 713:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     encode_submitted_to_staging(strip);
 714:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     /* Keep both circular-DMA halves identical while stopped.  Each half is
 715:Drivers/PWM-WS2812B/pwm-ws2812b.c ****      * one complete frame, including its own reset/latch tail. */
 716:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     led_data_to_dma_frame(strip, 0u, start, length);
 717:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     led_data_to_dma_frame(strip, 1u, start, length);
 718:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     if (start == 0u && length == led_count) {
 719:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         *strip_dirty_flag(strip) = false;
 720:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         uint32_t next = *strip_published_generation(strip) + 1u;
 721:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         if (next == 0u) {
