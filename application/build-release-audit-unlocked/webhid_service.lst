 703:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****   /**
 704:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  @brief  A standard container using fixed-size memory allocation and
 705:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  constant-time manipulation of elements at either end.
 706:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 707:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  @ingroup sequences
 708:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 709:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  @tparam _Tp  Type of element.
 710:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  @tparam _Alloc  Allocator type, defaults to allocator<_Tp>.
 711:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 712:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  Meets the requirements of a <a href="tables.html#65">container</a>, a
 713:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  <a href="tables.html#66">reversible container</a>, and a
 714:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  <a href="tables.html#67">sequence</a>, including the
 715:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  <a href="tables.html#68">optional sequence requirements</a>.
 716:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 717:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  In previous HP/SGI versions of deque, there was an extra template
 718:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  parameter so users could control the node size.  This extension turned
 719:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  out to violate the C++ standard (it can be detected using template
 720:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  template parameters), and it was removed.
 721:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 722:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  Here's how a deque<Tp> manages memory.  Each deque has 4 members:
 723:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 724:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  - Tp**        _M_map
 725:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  - size_t      _M_map_size
 726:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  - iterator    _M_start, _M_finish
 727:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 728:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  map_size is at least 8.  %map is an array of map_size
 729:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  pointers-to-@a nodes.  (The name %map has nothing to do with the
 730:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  std::map class, and @b nodes should not be confused with
 731:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  std::list's usage of @a node.)
 732:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 733:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  A @a node has no specific type name as such, but it is referred
 734:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  to as @a node in this file.  It is a simple array-of-Tp.  If Tp
 735:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  is very large, there will be one Tp element per node (i.e., an
 736:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  @a array of one).  For non-huge Tp's, node size is inversely
 737:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  related to Tp size: the larger the Tp, the fewer Tp's will fit
 738:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  in a node.  The goal here is to keep the total size of a node
 739:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  relatively small and constant over different Tp's, to improve
 740:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  allocator efficiency.
 741:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 742:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  Not every pointer in the %map array will point to a node.  If
 743:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  the initial number of elements in the deque is small, the
 744:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  /middle/ %map pointers will be valid, and the ones at the edges
 745:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  will be unused.  This same situation will arise as the %map
 746:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  grows: available %map pointers, if any, will be on the ends.  As
 747:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  new nodes are created, only a subset of the %map's pointers need
 748:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  to be copied @a outward.
 749:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 750:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  Class invariants:
 751:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * - For any nonsingular iterator i:
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccYoUrkL.s 			page 487


 752:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *    - i.node points to a member of the %map array.  (Yes, you read that
 753:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *      correctly:  i.node does not actually point to a node.)  The member of
 754:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *      the %map array is what actually points to the node.
 755:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *    - i.first == *(i.node)    (This points to the node (first Tp element).)
 756:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *    - i.last  == i.first + node_size
 757:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *    - i.cur is a pointer in the range [i.first, i.last).  NOTE:
 758:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *      the implication of this is that i.cur is always a dereferenceable
 759:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *      pointer, even if i is a past-the-end iterator.
 760:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * - Start and Finish are always nonsingular iterators.  NOTE: this
 761:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * means that an empty deque must have one node, a deque with <N
 762:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * elements (where N is the node buffer size) must have one node, a
 763:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * deque with N through (2N-1) elements must have two nodes, etc.
 764:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * - For every node other than start.node and finish.node, every
 765:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * element in the node is an initialized object.  If start.node ==
 766:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * finish.node, then [start.cur, finish.cur) are initialized
 767:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * objects, and the elements outside that range are uninitialized
 768:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * storage.  Otherwise, [start.cur, start.last) and [finish.first,
 769:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * finish.cur) are initialized objects, and [start.first, start.cur)
 770:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * and [finish.cur, finish.last) are uninitialized storage.
 771:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * - [%map, %map + map_size) is a valid, non-empty range.
 772:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * - [start.node, finish.node] is a valid range contained within
 773:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *   [%map, %map + map_size).
 774:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    * - A pointer in the range [%map, %map + map_size) points to an allocated
 775:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *   node if and only if the pointer is in the range
 776:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *   [start.node, finish.node].
 777:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 778:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  Here's the magic:  nothing in deque is @b aware of the discontiguous
 779:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  storage!
 780:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *
 781:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  The memory setup and layout occurs in the parent, _Base, and the iterator
 782:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  class is entirely responsible for @a leaping from one node to the next.
 783:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  All the implementation routines for deque itself work only through the
 784:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  start and finish iterators.  This keeps the routines simple and sane,
 785:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****    *  and we can use other standard algorithms as well.
 786:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****   */
 787:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****   template<typename _Tp, typename _Alloc = std::allocator<_Tp> >
 788:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****     class deque : protected _Deque_base<_Tp, _Alloc>
 789:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****     {
 790:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** #ifdef _GLIBCXX_CONCEPT_CHECKS
 791:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****       // concept requirements
 792:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****       typedef typename _Alloc::value_type	_Alloc_value_type;
 793:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** # if __cplusplus < 201103L
 794:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****       __glibcxx_class_requires(_Tp, _SGIAssignableConcept)
 795:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** # endif
 796:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****       __glibcxx_class_requires2(_Tp, _Alloc_value_type, _SameTypeConcept)
 797:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** #endif
 798:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** 
 799:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** #if __cplusplus >= 201103L
 800:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****       static_assert(is_same<typename remove_cv<_Tp>::type, _Tp>::value,
 801:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** 	  "std::deque must have a non-const, non-volatile value_type");
 802:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** # if __cplusplus > 201703L || defined __STRICT_ANSI__
 803:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h ****       static_assert(is_same<typename _Alloc::value_type, _Tp>::value,
 804:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_deque.h **** 	  "std::deque must have the same value_type as its allocator");
