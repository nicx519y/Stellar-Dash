 585:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****   /**
 586:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  @brief A standard container with linear time access to elements,
 587:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  and fixed time insertion/deletion at any point in the sequence.
 588:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *
 589:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  @ingroup sequences
 590:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *
 591:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  @tparam _Tp  Type of element.
 592:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  @tparam _Alloc  Allocator type, defaults to allocator<_Tp>.
 593:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *
 594:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  Meets the requirements of a <a href="tables.html#65">container</a>, a
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccLKnSLh.s 			page 36


 595:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  <a href="tables.html#66">reversible container</a>, and a
 596:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  <a href="tables.html#67">sequence</a>, including the
 597:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  <a href="tables.html#68">optional sequence requirements</a> with the
 598:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  %exception of @c at and @c operator[].
 599:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *
 600:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  This is a @e doubly @e linked %list.  Traversal up and down the
 601:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  %list requires linear time, but adding and removing elements (or
 602:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  @e nodes) is done in constant time, regardless of where the
 603:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  change takes place.  Unlike std::vector and std::deque,
 604:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  random-access iterators are not provided, so subscripting ( @c
 605:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  [] ) access is not allowed.  For algorithms which only need
 606:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  sequential access, this lack makes no difference.
 607:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *
 608:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  Also unlike the other standard containers, std::list provides
 609:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  specialized algorithms %unique to linked lists, such as
 610:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  splicing, sorting, and in-place reversal.
 611:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *
 612:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  A couple points on memory allocation for list<Tp>:
 613:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *
 614:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  First, we never actually allocate a Tp, we allocate
 615:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  List_node<Tp>'s and trust [20.1.5]/4 to DTRT.  This is to ensure
 616:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  that after elements from %list<X,Alloc1> are spliced into
 617:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  %list<X,Alloc2>, destroying the memory of the second %list is a
 618:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  valid operation, i.e., Alloc1 giveth and Alloc2 taketh away.
 619:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *
 620:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  Second, a %list conceptually represented as
 621:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  @code
 622:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *    A <---> B <---> C <---> D
 623:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  @endcode
 624:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  is actually circular; a link exists between A and D.  The %list
 625:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  class holds (as its only data member) a private list::iterator
 626:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  pointing to @e D, not to @e A!  To get to the head of the %list,
 627:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  we start at the tail and move forward by one.  When this member
 628:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  iterator's next/previous pointers refer to itself, the %list is
 629:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****    *  %empty.
 630:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****   */
 631:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****   template<typename _Tp, typename _Alloc = std::allocator<_Tp> >
 632:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****     class list : protected _List_base<_Tp, _Alloc>
 633:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****     {
 634:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** #ifdef _GLIBCXX_CONCEPT_CHECKS
 635:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****       // concept requirements
 636:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****       typedef typename _Alloc::value_type		_Alloc_value_type;
 637:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** # if __cplusplus < 201103L
 638:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****       __glibcxx_class_requires(_Tp, _SGIAssignableConcept)
 639:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** # endif
 640:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****       __glibcxx_class_requires2(_Tp, _Alloc_value_type, _SameTypeConcept)
 641:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** #endif
 642:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** 
 643:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** #if __cplusplus >= 201103L
 644:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****       static_assert(is_same<typename remove_cv<_Tp>::type, _Tp>::value,
 645:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** 	  "std::list must have a non-const, non-volatile value_type");
 646:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** # if __cplusplus > 201703L || defined __STRICT_ANSI__
 647:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h ****       static_assert(is_same<typename _Alloc::value_type, _Tp>::value,
 648:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** 	  "std::list must have the same value_type as its allocator");
 649:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** # endif
 650:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_list.h **** #endif
