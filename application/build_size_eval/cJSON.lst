 587:Libs/cJSON/cJSON.c ****     }
 588:Libs/cJSON/cJSON.c ****     else
 589:Libs/cJSON/cJSON.c ****     {
 590:Libs/cJSON/cJSON.c ****         /* Try 15 decimal places of precision to avoid nonsignificant nonzero digits */
 591:Libs/cJSON/cJSON.c ****         length = sprintf((char*)number_buffer, "%1.15g", d);
 592:Libs/cJSON/cJSON.c **** 
 593:Libs/cJSON/cJSON.c ****         /* Check whether the original double can be recovered */
 594:Libs/cJSON/cJSON.c ****         if ((sscanf((char*)number_buffer, "%lg", &test) != 1) || !compare_double((double)test, d))
 595:Libs/cJSON/cJSON.c ****         {
 596:Libs/cJSON/cJSON.c ****             /* If not, print with 17 decimal places of precision */
 597:Libs/cJSON/cJSON.c ****             length = sprintf((char*)number_buffer, "%1.17g", d);
 598:Libs/cJSON/cJSON.c ****         }
 599:Libs/cJSON/cJSON.c ****     }
 600:Libs/cJSON/cJSON.c **** 
 601:Libs/cJSON/cJSON.c ****     /* sprintf failed or buffer overrun occurred */
