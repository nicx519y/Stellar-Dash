 444:Libs/mbedtls/library/bignum.c ****         return 0;
 445:Libs/mbedtls/library/bignum.c ****     }
 446:Libs/mbedtls/library/bignum.c **** 
 447:Libs/mbedtls/library/bignum.c ****     if (s[0] == '-') {
 448:Libs/mbedtls/library/bignum.c ****         ++s;
 449:Libs/mbedtls/library/bignum.c ****         sign = -1;
 450:Libs/mbedtls/library/bignum.c ****     }
 451:Libs/mbedtls/library/bignum.c **** 
 452:Libs/mbedtls/library/bignum.c ****     slen = strlen(s);
 453:Libs/mbedtls/library/bignum.c **** 
 454:Libs/mbedtls/library/bignum.c ****     if (radix == 16) {
 455:Libs/mbedtls/library/bignum.c ****         if (slen > MPI_SIZE_T_MAX >> 2) {
