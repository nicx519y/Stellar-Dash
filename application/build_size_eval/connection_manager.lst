 259:Cpp_Core/Src/connection_manager.cpp **** bool ConnectionManager::tryRfBringup(bool isRetry) {
 260:Cpp_Core/Src/connection_manager.cpp ****     (void)isRetry;
 261:Cpp_Core/Src/connection_manager.cpp ****     bool ok = rfTransport.begin();
 262:Cpp_Core/Src/connection_manager.cpp **** 
 263:Cpp_Core/Src/connection_manager.cpp ****     /*
 264:Cpp_Core/Src/connection_manager.cpp ****      * SPI bring-up mode:
 265:Cpp_Core/Src/connection_manager.cpp ****      * keep only GET_STATUS path to validate transport stability first.
 266:Cpp_Core/Src/connection_manager.cpp ****      * Rate/pair commands are re-enabled after SPI link is proven stable.
 267:Cpp_Core/Src/connection_manager.cpp ****      */
 268:Cpp_Core/Src/connection_manager.cpp **** 
 269:Cpp_Core/Src/connection_manager.cpp ****     if (ok) {
 270:Cpp_Core/Src/connection_manager.cpp ****         updateRfLinkStateFromStatus();
