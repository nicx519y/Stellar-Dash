 595:Libs/cJSON/cJSON.c ****         {
 596:Libs/cJSON/cJSON.c ****             /* If not, print with 17 decimal places of precision */
 597:Libs/cJSON/cJSON.c ****             length = sprintf((char*)number_buffer, "%1.17g", d);
 598:Libs/cJSON/cJSON.c ****         }
 599:Libs/cJSON/cJSON.c ****     }
 600:Libs/cJSON/cJSON.c **** 
 601:Libs/cJSON/cJSON.c ****     /* sprintf failed or buffer overrun occurred */
 602:Libs/cJSON/cJSON.c ****     if ((length < 0) || (length > (int)(sizeof(number_buffer) - 1)))
 603:Libs/cJSON/cJSON.c ****     {
 604:Libs/cJSON/cJSON.c ****         return false;
 605:Libs/cJSON/cJSON.c ****     }
 606:Libs/cJSON/cJSON.c **** 
 607:Libs/cJSON/cJSON.c ****     /* reserve appropriate space in the output */
 608:Libs/cJSON/cJSON.c ****     output_pointer = ensure(output_buffer, (size_t)length + sizeof(""));
 609:Libs/cJSON/cJSON.c ****     if (output_pointer == NULL)
 610:Libs/cJSON/cJSON.c ****     {
