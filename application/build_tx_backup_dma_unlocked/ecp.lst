1679:Libs/mbedtls/library/ecp.c **** /*
1680:Libs/mbedtls/library/ecp.c ****  * Randomize jacobian coordinates:
1681:Libs/mbedtls/library/ecp.c ****  * (X, Y, Z) -> (l^2 X, l^3 Y, l Z) for random l
1682:Libs/mbedtls/library/ecp.c ****  * This is sort of the reverse operation of ecp_normalize_jac().
1683:Libs/mbedtls/library/ecp.c ****  *
1684:Libs/mbedtls/library/ecp.c ****  * This countermeasure was first suggested in [2].
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccosdxRQ.s 			page 31


1685:Libs/mbedtls/library/ecp.c ****  */
1686:Libs/mbedtls/library/ecp.c **** static int ecp_randomize_jac(const mbedtls_ecp_group *grp, mbedtls_ecp_point *pt,
1687:Libs/mbedtls/library/ecp.c ****                              int (*f_rng)(void *, unsigned char *, size_t), void *p_rng)
1688:Libs/mbedtls/library/ecp.c **** {
1689:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_ECP_RANDOMIZE_JAC_ALT)
1690:Libs/mbedtls/library/ecp.c ****     if (mbedtls_internal_ecp_grp_capable(grp)) {
1691:Libs/mbedtls/library/ecp.c ****         return mbedtls_internal_ecp_randomize_jac(grp, pt, f_rng, p_rng);
1692:Libs/mbedtls/library/ecp.c ****     }
1693:Libs/mbedtls/library/ecp.c **** #endif /* MBEDTLS_ECP_RANDOMIZE_JAC_ALT */
1694:Libs/mbedtls/library/ecp.c **** 
1695:Libs/mbedtls/library/ecp.c **** #if defined(MBEDTLS_ECP_NO_FALLBACK) && defined(MBEDTLS_ECP_RANDOMIZE_JAC_ALT)
1696:Libs/mbedtls/library/ecp.c ****     return MBEDTLS_ERR_ECP_FEATURE_UNAVAILABLE;
1697:Libs/mbedtls/library/ecp.c **** #else
1698:Libs/mbedtls/library/ecp.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
1699:Libs/mbedtls/library/ecp.c ****     mbedtls_mpi l, ll;
1700:Libs/mbedtls/library/ecp.c **** 
1701:Libs/mbedtls/library/ecp.c ****     mbedtls_mpi_init(&l); mbedtls_mpi_init(&ll);
1702:Libs/mbedtls/library/ecp.c **** 
1703:Libs/mbedtls/library/ecp.c ****     /* Generate l such that 1 < l < p */
1704:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_random(&l, 2, &grp->P, f_rng, p_rng));
1705:Libs/mbedtls/library/ecp.c **** 
1706:Libs/mbedtls/library/ecp.c ****     /* Z = l * Z */
1707:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mod(grp, &pt->Z,   &pt->Z,     &l));
1708:Libs/mbedtls/library/ecp.c **** 
1709:Libs/mbedtls/library/ecp.c ****     /* X = l^2 * X */
1710:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mod(grp, &ll,      &l,         &l));
1711:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mod(grp, &pt->X,   &pt->X,     &ll));
1712:Libs/mbedtls/library/ecp.c **** 
1713:Libs/mbedtls/library/ecp.c ****     /* Y = l^3 * Y */
1714:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mod(grp, &ll,      &ll,        &l));
1715:Libs/mbedtls/library/ecp.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_mul_mod(grp, &pt->Y,   &pt->Y,     &ll));
1716:Libs/mbedtls/library/ecp.c **** 
1717:Libs/mbedtls/library/ecp.c **** cleanup:
1718:Libs/mbedtls/library/ecp.c ****     mbedtls_mpi_free(&l); mbedtls_mpi_free(&ll);
1719:Libs/mbedtls/library/ecp.c **** 
1720:Libs/mbedtls/library/ecp.c ****     if (ret == MBEDTLS_ERR_MPI_NOT_ACCEPTABLE) {
1721:Libs/mbedtls/library/ecp.c ****         ret = MBEDTLS_ERR_ECP_RANDOM_FAILED;
1722:Libs/mbedtls/library/ecp.c ****     }
1723:Libs/mbedtls/library/ecp.c ****     return ret;
1724:Libs/mbedtls/library/ecp.c **** #endif /* !defined(MBEDTLS_ECP_NO_FALLBACK) || !defined(MBEDTLS_ECP_RANDOMIZE_JAC_ALT) */
1725:Libs/mbedtls/library/ecp.c **** }
