  83:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // Red-black tree class, designed for use in implementing STL
  84:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // associative containers (set, multiset, map, and multimap). The
  85:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // insertion and deletion algorithms are based on those in Cormen,
  86:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // Leiserson, and Rivest, Introduction to Algorithms (MIT Press,
  87:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // 1990), except that
  88:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   //
  89:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // (1) the header cell is maintained with links not only to the root
  90:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // but also to the leftmost node of the tree, to enable constant
  91:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // time begin(), and to the rightmost node of the tree, to enable
  92:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // linear time performance when used with the generic set algorithms
  93:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // (set_union, etc.)
  94:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   //
  95:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // (2) when a node being deleted has two children its successor node
  96:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // is relinked into its place, rather than copied, so that the only
  97:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   // iterators invalidated are those referring to the deleted node.
  98:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h **** 
  99:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_tree.h ****   enum _Rb_tree_color { _S_red = false, _S_black = true };
