 830:Libs/mbedtls/library/ecp_curves.c **** #if defined(MBEDTLS_ECP_NIST_OPTIM)
 831:Libs/mbedtls/library/ecp_curves.c **** /*
 832:Libs/mbedtls/library/ecp_curves.c ****  * Fast reduction modulo the primes used by the NIST curves.
 833:Libs/mbedtls/library/ecp_curves.c ****  *
 834:Libs/mbedtls/library/ecp_curves.c ****  * These functions are critical for speed, but not needed for correct
 835:Libs/mbedtls/library/ecp_curves.c ****  * operations. So, we make the choice to heavily rely on the internals of our
 836:Libs/mbedtls/library/ecp_curves.c ****  * bignum library, which creates a tight coupling between these functions and
 837:Libs/mbedtls/library/ecp_curves.c ****  * our MPI implementation.  However, the coupling between the ECP module and
 838:Libs/mbedtls/library/ecp_curves.c ****  * MPI remains loose, since these functions can be deactivated at will.
 839:Libs/mbedtls/library/ecp_curves.c ****  */
 840:Libs/mbedtls/library/ecp_curves.c **** 
 841:Libs/mbedtls/library/ecp_curves.c **** #if defined(MBEDTLS_ECP_DP_SECP192R1_ENABLED)
 842:Libs/mbedtls/library/ecp_curves.c **** /*
 843:Libs/mbedtls/library/ecp_curves.c ****  * Compared to the way things are presented in FIPS 186-3 D.2,
 844:Libs/mbedtls/library/ecp_curves.c ****  * we proceed in columns, from right (least significant chunk) to left,
 845:Libs/mbedtls/library/ecp_curves.c ****  * adding chunks to N in place, and keeping a carry for the next chunk.
 846:Libs/mbedtls/library/ecp_curves.c ****  * This avoids moving things around in memory, and uselessly adding zeros,
 847:Libs/mbedtls/library/ecp_curves.c ****  * compared to the more straightforward, line-oriented approach.
 848:Libs/mbedtls/library/ecp_curves.c ****  *
 849:Libs/mbedtls/library/ecp_curves.c ****  * For this prime we need to handle data in chunks of 64 bits.
 850:Libs/mbedtls/library/ecp_curves.c ****  * Since this is always a multiple of our basic mbedtls_mpi_uint, we can
 851:Libs/mbedtls/library/ecp_curves.c ****  * use a mbedtls_mpi_uint * to designate such a chunk, and small loops to handle it.
 852:Libs/mbedtls/library/ecp_curves.c ****  */
 853:Libs/mbedtls/library/ecp_curves.c **** 
 854:Libs/mbedtls/library/ecp_curves.c **** /* Add 64-bit chunks (dst += src) and update carry */
 855:Libs/mbedtls/library/ecp_curves.c **** static inline void add64(mbedtls_mpi_uint *dst, mbedtls_mpi_uint *src, mbedtls_mpi_uint *carry)
 856:Libs/mbedtls/library/ecp_curves.c **** {
 857:Libs/mbedtls/library/ecp_curves.c ****     unsigned char i;
 858:Libs/mbedtls/library/ecp_curves.c ****     mbedtls_mpi_uint c = 0;
 859:Libs/mbedtls/library/ecp_curves.c ****     for (i = 0; i < 8 / sizeof(mbedtls_mpi_uint); i++, dst++, src++) {
 860:Libs/mbedtls/library/ecp_curves.c ****         *dst += c;      c  = (*dst < c);
 861:Libs/mbedtls/library/ecp_curves.c ****         *dst += *src;   c += (*dst < *src);
 862:Libs/mbedtls/library/ecp_curves.c ****     }
 863:Libs/mbedtls/library/ecp_curves.c ****     *carry += c;
 864:Libs/mbedtls/library/ecp_curves.c **** }
 865:Libs/mbedtls/library/ecp_curves.c **** 
 866:Libs/mbedtls/library/ecp_curves.c **** /* Add carry to a 64-bit chunk and update carry */
 867:Libs/mbedtls/library/ecp_curves.c **** static inline void carry64(mbedtls_mpi_uint *dst, mbedtls_mpi_uint *carry)
 868:Libs/mbedtls/library/ecp_curves.c **** {
 869:Libs/mbedtls/library/ecp_curves.c ****     unsigned char i;
 870:Libs/mbedtls/library/ecp_curves.c ****     for (i = 0; i < 8 / sizeof(mbedtls_mpi_uint); i++, dst++) {
 871:Libs/mbedtls/library/ecp_curves.c ****         *dst += *carry;
 872:Libs/mbedtls/library/ecp_curves.c ****         *carry  = (*dst < *carry);
 873:Libs/mbedtls/library/ecp_curves.c ****     }
 874:Libs/mbedtls/library/ecp_curves.c **** }
 875:Libs/mbedtls/library/ecp_curves.c **** 
 876:Libs/mbedtls/library/ecp_curves.c **** #define WIDTH       8 / sizeof(mbedtls_mpi_uint)
 877:Libs/mbedtls/library/ecp_curves.c **** #define A(i)      N->p + (i) * WIDTH
