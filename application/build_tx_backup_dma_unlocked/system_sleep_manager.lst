   4:Inc/power/auto_sleep_policy.hpp **** // Pure runtime policy. No retained state, storage, clocks or peripheral access.
   5:Inc/power/auto_sleep_policy.hpp **** class AutoSleepPolicy {
   6:Inc/power/auto_sleep_policy.hpp **** public:
   7:Inc/power/auto_sleep_policy.hpp ****     enum class State { Active, Preparing, Sleeping, RestoringLocal };
   8:Inc/power/auto_sleep_policy.hpp ****     static constexpr uint32_t bootGuardMs = 30000u;
   9:Inc/power/auto_sleep_policy.hpp ****     static constexpr uint32_t prepareLimitMs = 500u;
  10:Inc/power/auto_sleep_policy.hpp ****     static constexpr uint32_t restoreLimitMs = 100u;
  11:Inc/power/auto_sleep_policy.hpp **** 
  12:Inc/power/auto_sleep_policy.hpp ****     void initialize(uint32_t now, bool enabled) {
  13:Inc/power/auto_sleep_policy.hpp ****         *this = AutoSleepPolicy{};
  14:Inc/power/auto_sleep_policy.hpp ****         enabled_ = enabled;
  15:Inc/power/auto_sleep_policy.hpp ****         boot_ = lastActivity_ = since_ = now;
  16:Inc/power/auto_sleep_policy.hpp ****     }
  17:Inc/power/auto_sleep_policy.hpp ****     void inhibit() { enabled_ = false; }
  18:Inc/power/auto_sleep_policy.hpp ****     bool enabled() const { return enabled_; }
  19:Inc/power/auto_sleep_policy.hpp ****     State state() const { return state_; }
  20:Inc/power/auto_sleep_policy.hpp ****     uint32_t elapsed(uint32_t now) const { return now - since_; }
  21:Inc/power/auto_sleep_policy.hpp ****     void activity(uint32_t now) { lastActivity_ = now; }
  22:Inc/power/auto_sleep_policy.hpp ****     bool shouldPrepare(uint32_t now, uint32_t timeout, bool eligible) {
  23:Inc/power/auto_sleep_policy.hpp ****         if (!eligible || !wasEligible_) lastActivity_ = now;
  24:Inc/power/auto_sleep_policy.hpp ****         wasEligible_ = eligible;
  25:Inc/power/auto_sleep_policy.hpp ****         return enabled_ && eligible && state_ == State::Active && timeout != 0u &&
  26:Inc/power/auto_sleep_policy.hpp ****                now - boot_ >= bootGuardMs && now - lastActivity_ >= timeout;
  27:Inc/power/auto_sleep_policy.hpp ****     }
  28:Inc/power/auto_sleep_policy.hpp ****     void transition(State next, uint32_t now) { state_ = next; since_ = now; }
  29:Inc/power/auto_sleep_policy.hpp ****     bool timedOut(uint32_t now) const {
  30:Inc/power/auto_sleep_policy.hpp ****         return (state_ == State::Preparing && elapsed(now) >= prepareLimitMs) ||
  31:Inc/power/auto_sleep_policy.hpp ****                (state_ == State::RestoringLocal && elapsed(now) >= restoreLimitMs);
  32:Inc/power/auto_sleep_policy.hpp ****     }
  33:Inc/power/auto_sleep_policy.hpp ****     void active(uint32_t now) { transition(State::Active, now); activity(now); }
  34:Inc/power/auto_sleep_policy.hpp **** private:
  35:Inc/power/auto_sleep_policy.hpp ****     bool enabled_ = false;
  36:Inc/power/auto_sleep_policy.hpp ****     bool wasEligible_ = false;
  37:Inc/power/auto_sleep_policy.hpp ****     State state_ = State::Active;
  38:Inc/power/auto_sleep_policy.hpp ****     uint32_t boot_ = 0, lastActivity_ = 0, since_ = 0;
  39:Inc/power/auto_sleep_policy.hpp **** };
