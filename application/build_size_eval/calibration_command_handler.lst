  38:Cpp_Core/Src/configs/calibration_command_handler.cpp **** /**
  39:Cpp_Core/Src/configs/calibration_command_handler.cpp ****  * @brief 推送校准状态变化通知
  40:Cpp_Core/Src/configs/calibration_command_handler.cpp ****  */
  41:Cpp_Core/Src/configs/calibration_command_handler.cpp **** void CalibrationCommandHandler::sendCalibrationStatusNotification() {
  42:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     // 构建校准状态数据
  43:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON* notificationData = cJSON_CreateObject();
  44:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON* statusJSON = buildCalibrationStatusJSON();
  45:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     
  46:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON_AddItemToObject(notificationData, "calibrationStatus", statusJSON);
  47:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON_AddStringToObject(notificationData, "type", "calibration_update");
  48:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON_AddNumberToObject(notificationData, "timestamp", HAL_GetTick());
  49:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     
  50:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     // 创建通知消息（无CID的消息表示这是服务器主动推送）
  51:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON* notification = cJSON_CreateObject();
  52:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON_AddStringToObject(notification, "command", "calibration_update");
  53:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON_AddNumberToObject(notification, "errNo", 0);
  54:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON_AddItemToObject(notification, "data", notificationData);
  55:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     
  56:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     // 转换为JSON字符串
  57:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     char* notificationString = cJSON_PrintUnformatted(notification);
  58:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     if (notificationString) {
  59:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         ConfigTransport_PublishJson(
  60:Cpp_Core/Src/configs/calibration_command_handler.cpp ****             notificationString, strlen(notificationString));
  61:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         
  62:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         // LOG_INFO("DeviceCommand", "Calibration status notification sent to all clients");
  63:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         
  64:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         // 释放JSON字符串内存
  65:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         free(notificationString);
  66:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     } else {
  67:Cpp_Core/Src/configs/calibration_command_handler.cpp ****         LOG_ERROR("DeviceCommand", "Failed to serialize calibration notification");
  68:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     }
  69:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     
  70:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     // 清理JSON对象
  71:Cpp_Core/Src/configs/calibration_command_handler.cpp ****     cJSON_Delete(notification);
  72:Cpp_Core/Src/configs/calibration_command_handler.cpp **** }
  73:Cpp_Core/Src/configs/calibration_command_handler.cpp **** 
  74:Cpp_Core/Src/configs/calibration_command_handler.cpp **** // ============================================================================
  75:Cpp_Core/Src/configs/calibration_command_handler.cpp **** // 校准相关命令实现
