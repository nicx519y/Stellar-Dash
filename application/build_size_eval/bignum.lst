1219:Libs/mbedtls/library/bignum.c ****  *
1220:Libs/mbedtls/library/bignum.c ****  * \param n             Number of limbs of \p d, \p l and \p r.
1221:Libs/mbedtls/library/bignum.c ****  * \param[out] d        The result of the subtraction.
1222:Libs/mbedtls/library/bignum.c ****  * \param[in] l         The left operand.
1223:Libs/mbedtls/library/bignum.c ****  * \param[in] r         The right operand.
1224:Libs/mbedtls/library/bignum.c ****  *
1225:Libs/mbedtls/library/bignum.c ****  * \return              1 if `l < r`.
1226:Libs/mbedtls/library/bignum.c ****  *                      0 if `l >= r`.
1227:Libs/mbedtls/library/bignum.c ****  */
1228:Libs/mbedtls/library/bignum.c **** static mbedtls_mpi_uint mpi_sub_hlp(size_t n,
1229:Libs/mbedtls/library/bignum.c ****                                     mbedtls_mpi_uint *d,
1230:Libs/mbedtls/library/bignum.c ****                                     const mbedtls_mpi_uint *l,
1231:Libs/mbedtls/library/bignum.c ****                                     const mbedtls_mpi_uint *r)
1232:Libs/mbedtls/library/bignum.c **** {
1233:Libs/mbedtls/library/bignum.c ****     size_t i;
1234:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint c = 0, t, z;
1235:Libs/mbedtls/library/bignum.c **** 
1236:Libs/mbedtls/library/bignum.c ****     for (i = 0; i < n; i++) {
1237:Libs/mbedtls/library/bignum.c ****         z = (l[i] <  c);    t = l[i] - c;
1238:Libs/mbedtls/library/bignum.c ****         c = (t < r[i]) + z; d[i] = t - r[i];
1239:Libs/mbedtls/library/bignum.c ****     }
1240:Libs/mbedtls/library/bignum.c **** 
1241:Libs/mbedtls/library/bignum.c ****     return c;
1242:Libs/mbedtls/library/bignum.c **** }
