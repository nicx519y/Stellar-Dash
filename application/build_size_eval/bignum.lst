 172:Libs/mbedtls/library/bignum.c **** /* Resize X to have exactly n limbs and set it to 0. */
 173:Libs/mbedtls/library/bignum.c **** static int mbedtls_mpi_resize_clear(mbedtls_mpi *X, size_t limbs)
 174:Libs/mbedtls/library/bignum.c **** {
 175:Libs/mbedtls/library/bignum.c ****     if (limbs == 0) {
 176:Libs/mbedtls/library/bignum.c ****         mbedtls_mpi_free(X);
 177:Libs/mbedtls/library/bignum.c ****         return 0;
 178:Libs/mbedtls/library/bignum.c ****     } else if (X->n == limbs) {
 179:Libs/mbedtls/library/bignum.c ****         memset(X->p, 0, limbs * ciL);
 180:Libs/mbedtls/library/bignum.c ****         X->s = 1;
 181:Libs/mbedtls/library/bignum.c ****         return 0;
 182:Libs/mbedtls/library/bignum.c ****     } else {
 183:Libs/mbedtls/library/bignum.c ****         mbedtls_mpi_free(X);
 184:Libs/mbedtls/library/bignum.c ****         return mbedtls_mpi_grow(X, limbs);
 185:Libs/mbedtls/library/bignum.c ****     }
 186:Libs/mbedtls/library/bignum.c **** }
