  43:Cpp_Core/Src/config.cpp **** #define CONFIG_JOURNAL_VERSION       1u
  44:Cpp_Core/Src/config.cpp **** #define CONFIG_JOURNAL_COMMIT        0x54494D43u /* "CMIT", little endian */
  45:Cpp_Core/Src/config.cpp **** #define CONFIG_JOURNAL_ERASED_WORD   0xFFFFFFFFu
  46:Cpp_Core/Src/config.cpp **** #define CONFIG_DIGEST_MARKER         0x31435243u /* "CRC1", little endian */
  47:Cpp_Core/Src/config.cpp **** 
  48:Cpp_Core/Src/config.cpp **** #pragma pack(push, 1)
  49:Cpp_Core/Src/config.cpp **** typedef struct {
  50:Cpp_Core/Src/config.cpp ****     uint32_t magic;
