1278:Libs/mbedtls/library/bignum.c **** 
1279:Libs/mbedtls/library/bignum.c ****     carry = mpi_sub_hlp(n, X->p, A->p, B->p);
1280:Libs/mbedtls/library/bignum.c ****     if (carry != 0) {
