 196:Libs/mbedtls/library/constant_time.c **** /** Constant-flow "greater than" comparison:
 197:Libs/mbedtls/library/constant_time.c ****  * return x > y
 198:Libs/mbedtls/library/constant_time.c ****  *
 199:Libs/mbedtls/library/constant_time.c ****  * This is equivalent to \p x > \p y, but is likely to be compiled
 200:Libs/mbedtls/library/constant_time.c ****  * to code using bitwise operation rather than a branch.
 201:Libs/mbedtls/library/constant_time.c ****  *
 202:Libs/mbedtls/library/constant_time.c ****  * \param x     The first value to analyze.
 203:Libs/mbedtls/library/constant_time.c ****  * \param y     The second value to analyze.
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccvCVS6d.s 			page 9


 204:Libs/mbedtls/library/constant_time.c ****  *
 205:Libs/mbedtls/library/constant_time.c ****  * \return      1 if \p x greater than \p y, otherwise 0.
 206:Libs/mbedtls/library/constant_time.c ****  */
 207:Libs/mbedtls/library/constant_time.c **** static unsigned mbedtls_ct_size_gt(size_t x,
 208:Libs/mbedtls/library/constant_time.c ****                                    size_t y)
 209:Libs/mbedtls/library/constant_time.c **** {
 210:Libs/mbedtls/library/constant_time.c ****     /* Return the sign bit (1 for negative) of (y - x). */
 211:Libs/mbedtls/library/constant_time.c ****     return (y - x) >> (sizeof(size_t) * 8 - 1);
 212:Libs/mbedtls/library/constant_time.c **** }
