 787:Libs/mbedtls/library/bignum.c ****          cur_limb_left <= cur_limb_right;
 788:Libs/mbedtls/library/bignum.c ****          cur_limb_left++, cur_limb_right--) {
 789:Libs/mbedtls/library/bignum.c ****         mbedtls_mpi_uint tmp;
 790:Libs/mbedtls/library/bignum.c ****         /* Note that if cur_limb_left == cur_limb_right,
 791:Libs/mbedtls/library/bignum.c ****          * this code effectively swaps the bytes only once. */
 792:Libs/mbedtls/library/bignum.c ****         tmp             = mpi_uint_bigendian_to_host(*cur_limb_left);
 793:Libs/mbedtls/library/bignum.c ****         *cur_limb_left  = mpi_uint_bigendian_to_host(*cur_limb_right);
 794:Libs/mbedtls/library/bignum.c ****         *cur_limb_right = tmp;
 795:Libs/mbedtls/library/bignum.c ****     }
 796:Libs/mbedtls/library/bignum.c **** }
