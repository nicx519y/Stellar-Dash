 349:Cpp_Core/Src/configs/common_command_handler.cpp ****     uint32_t collected = 0;
 350:Cpp_Core/Src/configs/common_command_handler.cpp ****     // 从最新的扇区开始向前收集，按条目倒序以保证整体新→旧
 351:Cpp_Core/Src/configs/common_command_handler.cpp ****     for (int i = static_cast<int>(sectorCount) - 1; i >= 0 && collected < limit; --i) {
 352:Cpp_Core/Src/configs/common_command_handler.cpp ****         uint32_t sectorIndex = sectorArray[i];
 353:Cpp_Core/Src/configs/common_command_handler.cpp ****         // 改为使用堆内存，避免因大数组导致的栈溢出
 354:Cpp_Core/Src/configs/common_command_handler.cpp ****         LogEntry* entries = (LogEntry*)malloc(LOG_ENTRIES_PER_SECTOR * sizeof(LogEntry));
 355:Cpp_Core/Src/configs/common_command_handler.cpp ****         if (!entries) {
 356:Cpp_Core/Src/configs/common_command_handler.cpp ****             // 无法分配足够内存，直接跳过该扇区
 357:Cpp_Core/Src/configs/common_command_handler.cpp ****             continue;
 358:Cpp_Core/Src/configs/common_command_handler.cpp ****         }
 359:Cpp_Core/Src/configs/common_command_handler.cpp ****         uint32_t entryCount = 0;
 360:Cpp_Core/Src/configs/common_command_handler.cpp ****         LogResult lr = Logger_GetSectorLogs(sectorIndex, entries, &entryCount);
 361:Cpp_Core/Src/configs/common_command_handler.cpp ****         if (lr != LOG_RESULT_SUCCESS) {
 362:Cpp_Core/Src/configs/common_command_handler.cpp ****             free(entries);
 363:Cpp_Core/Src/configs/common_command_handler.cpp ****             continue; // 跳过异常扇区
 364:Cpp_Core/Src/configs/common_command_handler.cpp ****         }
 365:Cpp_Core/Src/configs/common_command_handler.cpp ****         for (int j = static_cast<int>(entryCount) - 1; j >= 0 && collected < limit; --j) {
 366:Cpp_Core/Src/configs/common_command_handler.cpp ****             // 仅返回 WARN 和 ERROR 级别的日志
