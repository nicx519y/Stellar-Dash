 447:Cpp_Core/Src/adc_btns/adc_calibration.cpp **** ADCBtnsError ADCCalibrationManager::finalizeSampling(uint8_t buttonIndex) {
 448:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     ButtonCalibrationState& state = buttonStates[buttonIndex];
 449:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
 450:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     // 计算平均值（使用最后100个样本）
 451:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     uint32_t sum = 0;
 452:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     uint8_t samplesToUse = (state.sampleCount < MAX_SAMPLES) ? state.sampleCount : MAX_SAMPLES;
 453:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
