 156:Libs/cJSON/cJSON.c **** typedef struct internal_hooks
 157:Libs/cJSON/cJSON.c **** {
 158:Libs/cJSON/cJSON.c ****     void *(CJSON_CDECL *allocate)(size_t size);
 159:Libs/cJSON/cJSON.c ****     void (CJSON_CDECL *deallocate)(void *pointer);
 160:Libs/cJSON/cJSON.c ****     void *(CJSON_CDECL *reallocate)(void *pointer, size_t size);
