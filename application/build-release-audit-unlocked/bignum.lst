 125:Libs/mbedtls/library/bignum.c **** /*
 126:Libs/mbedtls/library/bignum.c ****  * Resize down as much as possible,
 127:Libs/mbedtls/library/bignum.c ****  * while keeping at least the specified number of limbs
 128:Libs/mbedtls/library/bignum.c ****  */
 129:Libs/mbedtls/library/bignum.c **** int mbedtls_mpi_shrink(mbedtls_mpi *X, size_t nblimbs)
 130:Libs/mbedtls/library/bignum.c **** {
 131:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint *p;
 132:Libs/mbedtls/library/bignum.c ****     size_t i;
 133:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(X != NULL);
 134:Libs/mbedtls/library/bignum.c **** 
 135:Libs/mbedtls/library/bignum.c ****     if (nblimbs > MBEDTLS_MPI_MAX_LIMBS) {
 136:Libs/mbedtls/library/bignum.c ****         return MBEDTLS_ERR_MPI_ALLOC_FAILED;
 137:Libs/mbedtls/library/bignum.c ****     }
 138:Libs/mbedtls/library/bignum.c **** 
 139:Libs/mbedtls/library/bignum.c ****     /* Actually resize up if there are currently fewer than nblimbs limbs. */
 140:Libs/mbedtls/library/bignum.c ****     if (X->n <= nblimbs) {
 141:Libs/mbedtls/library/bignum.c ****         return mbedtls_mpi_grow(X, nblimbs);
 142:Libs/mbedtls/library/bignum.c ****     }
 143:Libs/mbedtls/library/bignum.c ****     /* After this point, then X->n > nblimbs and in particular X->n > 0. */
 144:Libs/mbedtls/library/bignum.c **** 
 145:Libs/mbedtls/library/bignum.c ****     for (i = X->n - 1; i > 0; i--) {
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccFcTTHc.s 			page 4


 146:Libs/mbedtls/library/bignum.c ****         if (X->p[i] != 0) {
 147:Libs/mbedtls/library/bignum.c ****             break;
 148:Libs/mbedtls/library/bignum.c ****         }
 149:Libs/mbedtls/library/bignum.c ****     }
 150:Libs/mbedtls/library/bignum.c ****     i++;
 151:Libs/mbedtls/library/bignum.c **** 
 152:Libs/mbedtls/library/bignum.c ****     if (i < nblimbs) {
 153:Libs/mbedtls/library/bignum.c ****         i = nblimbs;
 154:Libs/mbedtls/library/bignum.c ****     }
 155:Libs/mbedtls/library/bignum.c **** 
 156:Libs/mbedtls/library/bignum.c ****     if ((p = (mbedtls_mpi_uint *) mbedtls_calloc(i, ciL)) == NULL) {
 157:Libs/mbedtls/library/bignum.c ****         return MBEDTLS_ERR_MPI_ALLOC_FAILED;
 158:Libs/mbedtls/library/bignum.c ****     }
 159:Libs/mbedtls/library/bignum.c **** 
 160:Libs/mbedtls/library/bignum.c ****     if (X->p != NULL) {
 161:Libs/mbedtls/library/bignum.c ****         memcpy(p, X->p, i * ciL);
 162:Libs/mbedtls/library/bignum.c ****         mbedtls_mpi_zeroize(X->p, X->n);
 163:Libs/mbedtls/library/bignum.c ****         mbedtls_free(X->p);
 164:Libs/mbedtls/library/bignum.c ****     }
 165:Libs/mbedtls/library/bignum.c **** 
 166:Libs/mbedtls/library/bignum.c ****     X->n = i;
 167:Libs/mbedtls/library/bignum.c ****     X->p = p;
 168:Libs/mbedtls/library/bignum.c **** 
 169:Libs/mbedtls/library/bignum.c ****     return 0;
 170:Libs/mbedtls/library/bignum.c **** }
