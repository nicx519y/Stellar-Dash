 518:Libs/cJSON/cJSON.c ****             return NULL;
 519:Libs/cJSON/cJSON.c ****         }
 520:Libs/cJSON/cJSON.c ****     }
 521:Libs/cJSON/cJSON.c ****     else
 522:Libs/cJSON/cJSON.c ****     {
 523:Libs/cJSON/cJSON.c ****         /* otherwise reallocate manually */
 524:Libs/cJSON/cJSON.c ****         newbuffer = (unsigned char*)p->hooks.allocate(newsize);
 525:Libs/cJSON/cJSON.c ****         if (!newbuffer)
 526:Libs/cJSON/cJSON.c ****         {
 527:Libs/cJSON/cJSON.c ****             p->hooks.deallocate(p->buffer);
 528:Libs/cJSON/cJSON.c ****             p->length = 0;
 529:Libs/cJSON/cJSON.c ****             p->buffer = NULL;
 530:Libs/cJSON/cJSON.c **** 
