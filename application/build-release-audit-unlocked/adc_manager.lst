 832:Src/input/adc_btns/adc_manager.cpp ****     if (targetIdx < store.num - 1)
 833:Src/input/adc_btns/adc_manager.cpp ****     {
 834:Src/input/adc_btns/adc_manager.cpp ****         memmove(&store.mapping[targetIdx],
