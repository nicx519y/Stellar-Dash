1965:Libs/mbedtls/library/bignum.c ****      * so d[n] == 0 and we want to keep A as it is.
1966:Libs/mbedtls/library/bignum.c ****      * If d0 >= N then d >= (2^biL)^n, and d <= (2^biL)^n + N < 2 * (2^biL)^n
1967:Libs/mbedtls/library/bignum.c ****      * so d[n] == 1 and we want to set A to the result of the subtraction
1968:Libs/mbedtls/library/bignum.c ****      * which is d - (2^biL)^n, i.e. the n least significant limbs of d.
1969:Libs/mbedtls/library/bignum.c ****      * This exactly corresponds to a conditional assignment. */
1970:Libs/mbedtls/library/bignum.c ****     mbedtls_ct_mpi_uint_cond_assign(n, A->p, d, (unsigned char) d[n]);
1971:Libs/mbedtls/library/bignum.c **** }
