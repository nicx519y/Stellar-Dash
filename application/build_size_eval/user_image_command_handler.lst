 186:Cpp_Core/Src/configs/user_image_command_handler.cpp **** static int8_t qspi_write_bytes(uint32_t address, const uint8_t* data, uint32_t length) {
 187:Cpp_Core/Src/configs/user_image_command_handler.cpp ****     uint32_t offset = 0;
 188:Cpp_Core/Src/configs/user_image_command_handler.cpp ****     while (offset < length) {
 189:Cpp_Core/Src/configs/user_image_command_handler.cpp ****         uint32_t remaining = length - offset;
 190:Cpp_Core/Src/configs/user_image_command_handler.cpp ****         uint32_t page_offset = (address + offset) & (W25Qxx_PageSize - 1);
 191:Cpp_Core/Src/configs/user_image_command_handler.cpp ****         uint32_t to_write = W25Qxx_PageSize - page_offset;
 192:Cpp_Core/Src/configs/user_image_command_handler.cpp ****         if (to_write > remaining) to_write = remaining;
 193:Cpp_Core/Src/configs/user_image_command_handler.cpp ****         int8_t r = QSPI_W25Qxx_WritePage((uint8_t*)(data + offset), (address + offset) & 0x00FFFFFF
 194:Cpp_Core/Src/configs/user_image_command_handler.cpp ****         if (r != QSPI_W25Qxx_OK) return r;
 195:Cpp_Core/Src/configs/user_image_command_handler.cpp ****         offset += to_write;
 196:Cpp_Core/Src/configs/user_image_command_handler.cpp ****     }
 197:Cpp_Core/Src/configs/user_image_command_handler.cpp ****     return QSPI_W25Qxx_OK;
 198:Cpp_Core/Src/configs/user_image_command_handler.cpp **** }
