1004:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_function.h ****    *  {
1005:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_function.h ****    *      bool operator() (int x) const { return x > 3; }
1006:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_function.h ****    *  };
1007:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_function.h ****    *
1008:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_function.h ****    *  std::find_if (v.begin(), v.end(), not1(IntGreaterThanThree()));
1009:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_function.h ****    *  \endcode
1010:D:/Program Files/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/bits\stl_function.h ****    *  The call to `find_if` will locate the first index (i) of `v` for which
