HBOX_INTERNAL_FLASH_PROVIDER_SELECTED := $(filter 1,$(HBOX_SECURITY_VERSION_INTERNAL_FLASH_PROVIDER) $(HBOX_DEVICE_IDENTITY_INTERNAL_FLASH_PROVIDER))
ifneq ($(strip $(HBOX_INTERNAL_FLASH_PROVIDER_SELECTED)),)
