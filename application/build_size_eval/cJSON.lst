 289:Libs/cJSON/cJSON.c **** typedef struct
 290:Libs/cJSON/cJSON.c **** {
 291:Libs/cJSON/cJSON.c ****     const unsigned char *content;
 292:Libs/cJSON/cJSON.c ****     size_t length;
 293:Libs/cJSON/cJSON.c ****     size_t offset;
 294:Libs/cJSON/cJSON.c ****     size_t depth; /* How deeply nested (in arrays/objects) is the input at the current offset. */
 295:Libs/cJSON/cJSON.c ****     internal_hooks hooks;
