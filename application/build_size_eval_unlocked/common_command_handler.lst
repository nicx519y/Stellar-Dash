 217:Cpp_Core/Src/configs/common_command_handler.cpp **** 
 218:Cpp_Core/Src/configs/common_command_handler.cpp **** DeviceCommandResponse CommonCommandHandler::handle(const DeviceCommandRequest& request) {
 219:Cpp_Core/Src/configs/common_command_handler.cpp ****     const std::string& command = request.getCommand();
 220:Cpp_Core/Src/configs/common_command_handler.cpp ****     
 221:Cpp_Core/Src/configs/common_command_handler.cpp ****     APP_DBG("CommonCommandHandler::handle command: %s", command.c_str());
 222:Cpp_Core/Src/configs/common_command_handler.cpp **** 
 223:Cpp_Core/Src/configs/common_command_handler.cpp ****     // 按键监控相关命令
 224:Cpp_Core/Src/configs/common_command_handler.cpp ****     if (command == "start_button_monitoring") {
 225:Cpp_Core/Src/configs/common_command_handler.cpp ****         return handleStartButtonMonitoring(request);
 226:Cpp_Core/Src/configs/common_command_handler.cpp ****     } else if (command == "stop_button_monitoring") {
 227:Cpp_Core/Src/configs/common_command_handler.cpp ****         return handleStopButtonMonitoring(request);
 228:Cpp_Core/Src/configs/common_command_handler.cpp ****     } else if (command == "start_button_performance_monitoring") {
 229:Cpp_Core/Src/configs/common_command_handler.cpp ****         return handleStartButtonPerformanceMonitoring(request);
 230:Cpp_Core/Src/configs/common_command_handler.cpp ****     } else if (command == "stop_button_performance_monitoring") {
 231:Cpp_Core/Src/configs/common_command_handler.cpp ****         return handleStopButtonPerformanceMonitoring(request);
 232:Cpp_Core/Src/configs/common_command_handler.cpp ****     } else if (command == "get_device_logs_list") {
 233:Cpp_Core/Src/configs/common_command_handler.cpp ****         return handleGetDeviceLogsList(request);
 234:Cpp_Core/Src/configs/common_command_handler.cpp ****     } else if (command == "get_hitbox_layout") {
 235:Cpp_Core/Src/configs/common_command_handler.cpp ****         return handleGetHitboxLayout(request);
 236:Cpp_Core/Src/configs/common_command_handler.cpp ****     } else if (command == "get_button_states") {
 237:Cpp_Core/Src/configs/common_command_handler.cpp ****         return handleGetButtonStates(request);
 238:Cpp_Core/Src/configs/common_command_handler.cpp ****     }
 239:Cpp_Core/Src/configs/common_command_handler.cpp ****     
 240:Cpp_Core/Src/configs/common_command_handler.cpp ****     return create_error_response(request.getCid(), command, -1, "Unknown common command");
 241:Cpp_Core/Src/configs/common_command_handler.cpp **** }
 242:Cpp_Core/Src/configs/common_command_handler.cpp **** 
