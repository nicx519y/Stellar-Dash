  56:Drivers/ROTARY-ENCODER/rotary-encoder.c **** /*
  57:Drivers/ROTARY-ENCODER/rotary-encoder.c ****  * Index is (previous AB << 2) | current AB. A valid quadrature edge changes
  58:Drivers/ROTARY-ENCODER/rotary-encoder.c ****  * exactly one bit; two-bit jumps are rejected instead of guessing a direction.
  59:Drivers/ROTARY-ENCODER/rotary-encoder.c ****  * The sign matches the legacy decoder's 00->10->11->01->00 direction.
  60:Drivers/ROTARY-ENCODER/rotary-encoder.c ****  */
  61:Drivers/ROTARY-ENCODER/rotary-encoder.c **** static const int8_t kQuadratureTransition[16] = {
  62:Drivers/ROTARY-ENCODER/rotary-encoder.c ****      0, -1,  1,  0,
  63:Drivers/ROTARY-ENCODER/rotary-encoder.c ****      1,  0,  0, -1,
  64:Drivers/ROTARY-ENCODER/rotary-encoder.c ****     -1,  0,  0,  1,
  65:Drivers/ROTARY-ENCODER/rotary-encoder.c ****      0,  1, -1,  0,
  66:Drivers/ROTARY-ENCODER/rotary-encoder.c **** };
