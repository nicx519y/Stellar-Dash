2358:Libs/mbedtls/library/bignum.c ****     }
2359:Libs/mbedtls/library/bignum.c **** 
2360:Libs/mbedtls/library/bignum.c ****     if (lzt < lz) {
2361:Libs/mbedtls/library/bignum.c ****         lz = lzt;
2362:Libs/mbedtls/library/bignum.c ****     }
2363:Libs/mbedtls/library/bignum.c **** 
2364:Libs/mbedtls/library/bignum.c ****     TA.s = TB.s = 1;
2365:Libs/mbedtls/library/bignum.c **** 
2366:Libs/mbedtls/library/bignum.c ****     /* We mostly follow the procedure described in HAC 14.54, but with some
2367:Libs/mbedtls/library/bignum.c ****      * minor differences:
2368:Libs/mbedtls/library/bignum.c ****      * - Sequences of multiplications or divisions by 2 are grouped into a
2369:Libs/mbedtls/library/bignum.c ****      *   single shift operation.
2370:Libs/mbedtls/library/bignum.c ****      * - The procedure in HAC assumes that 0 < TB <= TA.
2371:Libs/mbedtls/library/bignum.c ****      *     - The condition TB <= TA is not actually necessary for correctness.
2372:Libs/mbedtls/library/bignum.c ****      *       TA and TB have symmetric roles except for the loop termination
2373:Libs/mbedtls/library/bignum.c ****      *       condition, and the shifts at the beginning of the loop body
2374:Libs/mbedtls/library/bignum.c ****      *       remove any significance from the ordering of TA vs TB before
2375:Libs/mbedtls/library/bignum.c ****      *       the shifts.
2376:Libs/mbedtls/library/bignum.c ****      *     - If TA = 0, the loop goes through 0 iterations and the result is
2377:Libs/mbedtls/library/bignum.c ****      *       correctly TB.
2378:Libs/mbedtls/library/bignum.c ****      *     - The case TB = 0 was short-circuited above.
2379:Libs/mbedtls/library/bignum.c ****      *
2380:Libs/mbedtls/library/bignum.c ****      * For the correctness proof below, decompose the original values of
2381:Libs/mbedtls/library/bignum.c ****      * A and B as
2382:Libs/mbedtls/library/bignum.c ****      *   A = sa * 2^a * A' with A'=0 or A' odd, and sa = +-1
2383:Libs/mbedtls/library/bignum.c ****      *   B = sb * 2^b * B' with B'=0 or B' odd, and sb = +-1
2384:Libs/mbedtls/library/bignum.c ****      * Then gcd(A, B) = 2^{min(a,b)} * gcd(A',B'),
2385:Libs/mbedtls/library/bignum.c ****      * and gcd(A',B') is odd or 0.
2386:Libs/mbedtls/library/bignum.c ****      *
2387:Libs/mbedtls/library/bignum.c ****      * At the beginning, we have TA = |A| and TB = |B| so gcd(A,B) = gcd(TA,TB).
2388:Libs/mbedtls/library/bignum.c ****      * The code maintains the following invariant:
2389:Libs/mbedtls/library/bignum.c ****      *     gcd(A,B) = 2^k * gcd(TA,TB) for some k   (I)
2390:Libs/mbedtls/library/bignum.c ****      */
2391:Libs/mbedtls/library/bignum.c **** 
2392:Libs/mbedtls/library/bignum.c ****     /* Proof that the loop terminates:
2393:Libs/mbedtls/library/bignum.c ****      * At each iteration, either the right-shift by 1 is made on a nonzero
2394:Libs/mbedtls/library/bignum.c ****      * value and the nonnegative integer bitlen(TA) + bitlen(TB) decreases
2395:Libs/mbedtls/library/bignum.c ****      * by at least 1, or the right-shift by 1 is made on zero and then
2396:Libs/mbedtls/library/bignum.c ****      * TA becomes 0 which ends the loop (TB cannot be 0 if it is right-shifted
2397:Libs/mbedtls/library/bignum.c ****      * since in that case TB is calculated from TB-TA with the condition TB>TA).
2398:Libs/mbedtls/library/bignum.c ****      */
2399:Libs/mbedtls/library/bignum.c ****     while (mbedtls_mpi_cmp_int(&TA, 0) != 0) {
2400:Libs/mbedtls/library/bignum.c ****         /* Divisions by 2 preserve the invariant (I). */
2401:Libs/mbedtls/library/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TA, mbedtls_mpi_lsb(&TA)));
2402:Libs/mbedtls/library/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TB, mbedtls_mpi_lsb(&TB)));
2403:Libs/mbedtls/library/bignum.c **** 
2404:Libs/mbedtls/library/bignum.c ****         /* Set either TA or TB to |TA-TB|/2. Since TA and TB are both odd,
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccFcTTHc.s 			page 56


2405:Libs/mbedtls/library/bignum.c ****          * TA-TB is even so the division by 2 has an integer result.
2406:Libs/mbedtls/library/bignum.c ****          * Invariant (I) is preserved since any odd divisor of both TA and TB
2407:Libs/mbedtls/library/bignum.c ****          * also divides |TA-TB|/2, and any odd divisor of both TA and |TA-TB|/2
2408:Libs/mbedtls/library/bignum.c ****          * also divides TB, and any odd divisor of both TB and |TA-TB|/2 also
2409:Libs/mbedtls/library/bignum.c ****          * divides TA.
2410:Libs/mbedtls/library/bignum.c ****          */
2411:Libs/mbedtls/library/bignum.c ****         if (mbedtls_mpi_cmp_mpi(&TA, &TB) >= 0) {
2412:Libs/mbedtls/library/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(&TA, &TA, &TB));
2413:Libs/mbedtls/library/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TA, 1));
2414:Libs/mbedtls/library/bignum.c ****         } else {
2415:Libs/mbedtls/library/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_sub_abs(&TB, &TB, &TA));
2416:Libs/mbedtls/library/bignum.c ****             MBEDTLS_MPI_CHK(mbedtls_mpi_shift_r(&TB, 1));
2417:Libs/mbedtls/library/bignum.c ****         }
2418:Libs/mbedtls/library/bignum.c ****         /* Note that one of TA or TB is still odd. */
2419:Libs/mbedtls/library/bignum.c ****     }
2420:Libs/mbedtls/library/bignum.c **** 
2421:Libs/mbedtls/library/bignum.c ****     /* By invariant (I), gcd(A,B) = 2^k * gcd(TA,TB) for some k.
2422:Libs/mbedtls/library/bignum.c ****      * At the loop exit, TA = 0, so gcd(TA,TB) = TB.
2423:Libs/mbedtls/library/bignum.c ****      * - If there was at least one loop iteration, then one of TA or TB is odd,
2424:Libs/mbedtls/library/bignum.c ****      *   and TA = 0, so TB is odd and gcd(TA,TB) = gcd(A',B'). In this case,
2425:Libs/mbedtls/library/bignum.c ****      *   lz = min(a,b) so gcd(A,B) = 2^lz * TB.
2426:Libs/mbedtls/library/bignum.c ****      * - If there was no loop iteration, then A was 0, and gcd(A,B) = B.
2427:Libs/mbedtls/library/bignum.c ****      *   In this case, lz = 0 and B = TB so gcd(A,B) = B = 2^lz * TB as well.
2428:Libs/mbedtls/library/bignum.c ****      */
2429:Libs/mbedtls/library/bignum.c **** 
2430:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_shift_l(&TB, lz));
2431:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_copy(G, &TB));
2432:Libs/mbedtls/library/bignum.c **** 
2433:Libs/mbedtls/library/bignum.c **** cleanup:
2434:Libs/mbedtls/library/bignum.c **** 
2435:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_free(&TA); mbedtls_mpi_free(&TB);
2436:Libs/mbedtls/library/bignum.c **** 
2437:Libs/mbedtls/library/bignum.c ****     return ret;
2438:Libs/mbedtls/library/bignum.c **** }
