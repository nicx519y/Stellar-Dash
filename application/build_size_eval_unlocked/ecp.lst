1726:Libs/mbedtls/library/ecp.c **** 
1727:Libs/mbedtls/library/ecp.c **** /*
1728:Libs/mbedtls/library/ecp.c ****  * Check and define parameters used by the comb method (see below for details)
1729:Libs/mbedtls/library/ecp.c ****  */
1730:Libs/mbedtls/library/ecp.c **** #if MBEDTLS_ECP_WINDOW_SIZE < 2 || MBEDTLS_ECP_WINDOW_SIZE > 7
1731:Libs/mbedtls/library/ecp.c **** #error "MBEDTLS_ECP_WINDOW_SIZE out of bounds"
1732:Libs/mbedtls/library/ecp.c **** #endif
1733:Libs/mbedtls/library/ecp.c **** 
1734:Libs/mbedtls/library/ecp.c **** /* d = ceil( n / w ) */
1735:Libs/mbedtls/library/ecp.c **** #define COMB_MAX_D      (MBEDTLS_ECP_MAX_BITS + 1) / 2
1736:Libs/mbedtls/library/ecp.c **** 
1737:Libs/mbedtls/library/ecp.c **** /* number of precomputed points */
1738:Libs/mbedtls/library/ecp.c **** #define COMB_MAX_PRE    (1 << (MBEDTLS_ECP_WINDOW_SIZE - 1))
1739:Libs/mbedtls/library/ecp.c **** 
1740:Libs/mbedtls/library/ecp.c **** /*
1741:Libs/mbedtls/library/ecp.c ****  * Compute the representation of m that will be used with our comb method.
1742:Libs/mbedtls/library/ecp.c ****  *
1743:Libs/mbedtls/library/ecp.c ****  * The basic comb method is described in GECC 3.44 for example. We use a
1744:Libs/mbedtls/library/ecp.c ****  * modified version that provides resistance to SPA by avoiding zero
1745:Libs/mbedtls/library/ecp.c ****  * digits in the representation as in [3]. We modify the method further by
1746:Libs/mbedtls/library/ecp.c ****  * requiring that all K_i be odd, which has the small cost that our
1747:Libs/mbedtls/library/ecp.c ****  * representation uses one more K_i, due to carries, but saves on the size of
1748:Libs/mbedtls/library/ecp.c ****  * the precomputed table.
1749:Libs/mbedtls/library/ecp.c ****  *
1750:Libs/mbedtls/library/ecp.c ****  * Summary of the comb method and its modifications:
1751:Libs/mbedtls/library/ecp.c ****  *
1752:Libs/mbedtls/library/ecp.c ****  * - The goal is to compute m*P for some w*d-bit integer m.
1753:Libs/mbedtls/library/ecp.c ****  *
1754:Libs/mbedtls/library/ecp.c ****  * - The basic comb method splits m into the w-bit integers
1755:Libs/mbedtls/library/ecp.c ****  *   x[0] .. x[d-1] where x[i] consists of the bits in m whose
1756:Libs/mbedtls/library/ecp.c ****  *   index has residue i modulo d, and computes m * P as
1757:Libs/mbedtls/library/ecp.c ****  *   S[x[0]] + 2 * S[x[1]] + .. + 2^(d-1) S[x[d-1]], where
1758:Libs/mbedtls/library/ecp.c ****  *   S[i_{w-1} .. i_0] := i_{w-1} 2^{(w-1)d} P + ... + i_1 2^d P + i_0 P.
1759:Libs/mbedtls/library/ecp.c ****  *
1760:Libs/mbedtls/library/ecp.c ****  * - If it happens that, say, x[i+1]=0 (=> S[x[i+1]]=0), one can replace the sum by
1761:Libs/mbedtls/library/ecp.c ****  *    .. + 2^{i-1} S[x[i-1]] - 2^i S[x[i]] + 2^{i+1} S[x[i]] + 2^{i+2} S[x[i+2]] ..,
1762:Libs/mbedtls/library/ecp.c ****  *   thereby successively converting it into a form where all summands
1763:Libs/mbedtls/library/ecp.c ****  *   are nonzero, at the cost of negative summands. This is the basic idea of [3].
1764:Libs/mbedtls/library/ecp.c ****  *
1765:Libs/mbedtls/library/ecp.c ****  * - More generally, even if x[i+1] != 0, we can first transform the sum as
1766:Libs/mbedtls/library/ecp.c ****  *   .. - 2^i S[x[i]] + 2^{i+1} ( S[x[i]] + S[x[i+1]] ) + 2^{i+2} S[x[i+2]] ..,
1767:Libs/mbedtls/library/ecp.c ****  *   and then replace S[x[i]] + S[x[i+1]] = S[x[i] ^ x[i+1]] + 2 S[x[i] & x[i+1]].
1768:Libs/mbedtls/library/ecp.c ****  *   Performing and iterating this procedure for those x[i] that are even
1769:Libs/mbedtls/library/ecp.c ****  *   (keeping track of carry), we can transform the original sum into one of the form
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccQL5QWa.s 			page 50


1770:Libs/mbedtls/library/ecp.c ****  *   S[x'[0]] +- 2 S[x'[1]] +- .. +- 2^{d-1} S[x'[d-1]] + 2^d S[x'[d]]
1771:Libs/mbedtls/library/ecp.c ****  *   with all x'[i] odd. It is therefore only necessary to know S at odd indices,
1772:Libs/mbedtls/library/ecp.c ****  *   which is why we are only computing half of it in the first place in
1773:Libs/mbedtls/library/ecp.c ****  *   ecp_precompute_comb and accessing it with index abs(i) / 2 in ecp_select_comb.
1774:Libs/mbedtls/library/ecp.c ****  *
1775:Libs/mbedtls/library/ecp.c ****  * - For the sake of compactness, only the seven low-order bits of x[i]
1776:Libs/mbedtls/library/ecp.c ****  *   are used to represent its absolute value (K_i in the paper), and the msb
1777:Libs/mbedtls/library/ecp.c ****  *   of x[i] encodes the sign (s_i in the paper): it is set if and only if
1778:Libs/mbedtls/library/ecp.c ****  *   if s_i == -1;
1779:Libs/mbedtls/library/ecp.c ****  *
1780:Libs/mbedtls/library/ecp.c ****  * Calling conventions:
1781:Libs/mbedtls/library/ecp.c ****  * - x is an array of size d + 1
1782:Libs/mbedtls/library/ecp.c ****  * - w is the size, ie number of teeth, of the comb, and must be between
1783:Libs/mbedtls/library/ecp.c ****  *   2 and 7 (in practice, between 2 and MBEDTLS_ECP_WINDOW_SIZE)
1784:Libs/mbedtls/library/ecp.c ****  * - m is the MPI, expected to be odd and such that bitlength(m) <= w * d
1785:Libs/mbedtls/library/ecp.c ****  *   (the result will be incorrect if these assumptions are not satisfied)
1786:Libs/mbedtls/library/ecp.c ****  */
1787:Libs/mbedtls/library/ecp.c **** static void ecp_comb_recode_core(unsigned char x[], size_t d,
1788:Libs/mbedtls/library/ecp.c ****                                  unsigned char w, const mbedtls_mpi *m)
1789:Libs/mbedtls/library/ecp.c **** {
1790:Libs/mbedtls/library/ecp.c ****     size_t i, j;
1791:Libs/mbedtls/library/ecp.c ****     unsigned char c, cc, adjust;
1792:Libs/mbedtls/library/ecp.c **** 
1793:Libs/mbedtls/library/ecp.c ****     memset(x, 0, d+1);
1794:Libs/mbedtls/library/ecp.c **** 
1795:Libs/mbedtls/library/ecp.c ****     /* First get the classical comb values (except for x_d = 0) */
1796:Libs/mbedtls/library/ecp.c ****     for (i = 0; i < d; i++) {
1797:Libs/mbedtls/library/ecp.c ****         for (j = 0; j < w; j++) {
1798:Libs/mbedtls/library/ecp.c ****             x[i] |= mbedtls_mpi_get_bit(m, i + d * j) << j;
1799:Libs/mbedtls/library/ecp.c ****         }
1800:Libs/mbedtls/library/ecp.c ****     }
1801:Libs/mbedtls/library/ecp.c **** 
1802:Libs/mbedtls/library/ecp.c ****     /* Now make sure x_1 .. x_d are odd */
1803:Libs/mbedtls/library/ecp.c ****     c = 0;
1804:Libs/mbedtls/library/ecp.c ****     for (i = 1; i <= d; i++) {
1805:Libs/mbedtls/library/ecp.c ****         /* Add carry and update it */
1806:Libs/mbedtls/library/ecp.c ****         cc   = x[i] & c;
1807:Libs/mbedtls/library/ecp.c ****         x[i] = x[i] ^ c;
1808:Libs/mbedtls/library/ecp.c ****         c = cc;
1809:Libs/mbedtls/library/ecp.c **** 
1810:Libs/mbedtls/library/ecp.c ****         /* Adjust if needed, avoiding branches */
1811:Libs/mbedtls/library/ecp.c ****         adjust = 1 - (x[i] & 0x01);
1812:Libs/mbedtls/library/ecp.c ****         c   |= x[i] & (x[i-1] * adjust);
1813:Libs/mbedtls/library/ecp.c ****         x[i] = x[i] ^ (x[i-1] * adjust);
1814:Libs/mbedtls/library/ecp.c ****         x[i-1] |= adjust << 7;
1815:Libs/mbedtls/library/ecp.c ****     }
1816:Libs/mbedtls/library/ecp.c **** }
