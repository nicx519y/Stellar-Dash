 624:Drivers/PWM-WS2812B/pwm-ws2812b.c ****     const WS2812B_StateTypeDef otherState =
 625:Drivers/PWM-WS2812B/pwm-ws2812b.c ****         (strip == WS2812B_STRIP_AMBIENT) ? g_keys_state : g_ambient_state;
