 180:Libs/mbedtls/library/ecp.c **** 
 181:Libs/mbedtls/library/ecp.c **** /* DRBG context init */
 182:Libs/mbedtls/library/ecp.c **** static inline void ecp_drbg_init(ecp_drbg_context *ctx)
 183:Libs/mbedtls/library/ecp.c **** {
 184:Libs/mbedtls/library/ecp.c ****     mbedtls_ctr_drbg_init(ctx);
