1250:Libs/mbedtls/library/bignum.c ****     size_t n;
1251:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint carry;
1252:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(X != NULL);
1253:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(A != NULL);
1254:Libs/mbedtls/library/bignum.c ****     MPI_VALIDATE_RET(B != NULL);
1255:Libs/mbedtls/library/bignum.c **** 
1256:Libs/mbedtls/library/bignum.c ****     for (n = B->n; n > 0; n--) {
