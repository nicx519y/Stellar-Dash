 239:Cpp_Core/Src/adc_btns/adc_calibration.cpp **** void ADCCalibrationManager::processCalibration() {
 240:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     if (!calibrationActive) {
 241:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         return;
 242:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     }
 243:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
 244:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     // 记录本轮循环是否有状态变更
 245:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     bool hasStatusChange = false;
 246:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
 247:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     // 获取所有ADC值
 248:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     const std::array<ADCButtonValueInfo, NUM_ADC_BUTTONS>& adcValues = ADC_MANAGER.readADCValues();
 249:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
