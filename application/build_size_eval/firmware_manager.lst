  26:Cpp_Core/Src/firmware/firmware_manager.cpp **** static int decode_hex_digit(char digit) {
  27:Cpp_Core/Src/firmware/firmware_manager.cpp ****     if (digit >= '0' && digit <= '9') return digit - '0';
  28:Cpp_Core/Src/firmware/firmware_manager.cpp ****     if (digit >= 'a' && digit <= 'f') return digit - 'a' + 10;
  29:Cpp_Core/Src/firmware/firmware_manager.cpp ****     if (digit >= 'A' && digit <= 'F') return digit - 'A' + 10;
  30:Cpp_Core/Src/firmware/firmware_manager.cpp ****     return -1;
  31:Cpp_Core/Src/firmware/firmware_manager.cpp **** }
