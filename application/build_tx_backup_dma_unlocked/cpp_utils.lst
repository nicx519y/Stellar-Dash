 147:Src/support/cpp_utils.cpp **** std::string generate_unique_id(const char* name) {
 148:Src/support/cpp_utils.cpp ****     if (!name) {
 149:Src/support/cpp_utils.cpp ****         return "unknown-0";
 150:Src/support/cpp_utils.cpp ****     }
 151:Src/support/cpp_utils.cpp ****     
 152:Src/support/cpp_utils.cpp ****     // 获取当前时间戳（毫秒）
 153:Src/support/cpp_utils.cpp ****     uint32_t timestamp = HAL_GetTick();
 154:Src/support/cpp_utils.cpp ****     
 155:Src/support/cpp_utils.cpp ****     // 使用递增计数器确保同一毫秒内的唯一性
 156:Src/support/cpp_utils.cpp ****     static uint32_t counter = 0;
 157:Src/support/cpp_utils.cpp ****     counter++;
 158:Src/support/cpp_utils.cpp ****     
 159:Src/support/cpp_utils.cpp ****     // 使用简单的伪随机数生成
 160:Src/support/cpp_utils.cpp ****     static uint32_t seed = 0;
 161:Src/support/cpp_utils.cpp ****     seed = seed * 1103515245 + 12345;
 162:Src/support/cpp_utils.cpp ****     uint32_t random_num = (seed >> 16) & 0x7FFF; // 15位随机数
 163:Src/support/cpp_utils.cpp ****     
 164:Src/support/cpp_utils.cpp ****     // 计算name的哈希值
 165:Src/support/cpp_utils.cpp ****     uint32_t name_hash = simple_hash(name);
 166:Src/support/cpp_utils.cpp ****     
 167:Src/support/cpp_utils.cpp ****     // 组合所有元素生成最终哈希，确保不为0
 168:Src/support/cpp_utils.cpp ****     // 使用更复杂的组合方式：timestamp + counter + random_num + name_hash
 169:Src/support/cpp_utils.cpp ****     uint32_t combined_hash = timestamp + (counter << 16) + random_num + name_hash;
 170:Src/support/cpp_utils.cpp ****     if (combined_hash == 0) {
 171:Src/support/cpp_utils.cpp ****         combined_hash = timestamp ^ counter ^ random_num ^ name_hash; // 备用组合方式
 172:Src/support/cpp_utils.cpp ****     }
 173:Src/support/cpp_utils.cpp ****     
 174:Src/support/cpp_utils.cpp ****     // 手动转换为16进制字符串
 175:Src/support/cpp_utils.cpp ****     char hex_str[9];
 176:Src/support/cpp_utils.cpp ****     uint32_to_hex(combined_hash, hex_str, sizeof(hex_str));
 177:Src/support/cpp_utils.cpp ****     
 178:Src/support/cpp_utils.cpp ****     // 只返回16进制后缀作为ID
 179:Src/support/cpp_utils.cpp ****     return std::string(hex_str);
 180:Src/support/cpp_utils.cpp **** }
