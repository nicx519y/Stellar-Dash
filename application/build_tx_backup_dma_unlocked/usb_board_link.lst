  83:../common/webhid_fast_link.h **** /* Prepare does not consume anything. Commit only after the port owns a copy. */
  84:../common/webhid_fast_link.h **** static inline uint16_t whf_prepare(const whf_link_t *s, uint8_t *block) {
  85:../common/webhid_fast_link.h ****     uint32_t available=s->tx_produced-s->tx_sent;
  86:../common/webhid_fast_link.h ****     uint32_t credit=s->peer_limit>s->tx_sent ? s->peer_limit-s->tx_sent : 0u;
  87:../common/webhid_fast_link.h ****     uint8_t count=(uint8_t)(available>WHF_BATCH ? WHF_BATCH : available), i;
  88:../common/webhid_fast_link.h ****     uint16_t size;
  89:../common/webhid_fast_link.h ****     if(s->failed || !s->epoch || s->tx_block>=WHF_COUNTER_LIMIT) return 0u;
  90:../common/webhid_fast_link.h ****     if(count>credit) count=(uint8_t)credit;
  91:../common/webhid_fast_link.h ****     for(i=0u;i<count;++i) {
  92:../common/webhid_fast_link.h ****         if(credit-i==1u && !whf_is_control(s->tx[(s->tx_sent+i)%WHF_CAPACITY])) { count=i; break; }
  93:../common/webhid_fast_link.h ****     }
  94:../common/webhid_fast_link.h ****     if(!count && !s->dirty) return 0u;
  95:../common/webhid_fast_link.h ****     size=(uint16_t)(WHF_HEADER_BYTES + count*WEBHID_REPORT_BYTES);
  96:../common/webhid_fast_link.h ****     memset(block,0,WHF_HEADER_BYTES);
  97:../common/webhid_fast_link.h ****     block[0]=WHF_SYNC; block[1]=2u; whf_put16(block+2,size);
  98:../common/webhid_fast_link.h ****     whf_put32(block+4,s->epoch); whf_put32(block+8,s->tx_block+1u);
  99:../common/webhid_fast_link.h ****     whf_put32(block+12,s->tx_sent); whf_put32(block+16,s->rx_accepted);
 100:../common/webhid_fast_link.h ****     whf_put32(block+20,s->rx_released+WHF_CAPACITY); block[24]=count;
 101:../common/webhid_fast_link.h ****     for(i=0u;i<count;++i) WHF_COPY(block+WHF_HEADER_BYTES+i*WEBHID_REPORT_BYTES,
 102:../common/webhid_fast_link.h ****         s->tx[(s->tx_sent+i)%WHF_CAPACITY],WEBHID_REPORT_BYTES);
 103:../common/webhid_fast_link.h ****     whf_put32(block+28,whf_crc(block,size)); return size;
 104:../common/webhid_fast_link.h **** }
