 483:Libs/cJSON/cJSON_Utils.c **** /* sort lists using mergesort */
 484:Libs/cJSON/cJSON_Utils.c **** static cJSON *sort_list(cJSON *list, const cJSON_bool case_sensitive)
 485:Libs/cJSON/cJSON_Utils.c **** {
 486:Libs/cJSON/cJSON_Utils.c ****     cJSON *first = list;
 487:Libs/cJSON/cJSON_Utils.c ****     cJSON *second = list;
 488:Libs/cJSON/cJSON_Utils.c ****     cJSON *current_item = list;
 489:Libs/cJSON/cJSON_Utils.c ****     cJSON *result = list;
 490:Libs/cJSON/cJSON_Utils.c ****     cJSON *result_tail = NULL;
 491:Libs/cJSON/cJSON_Utils.c **** 
 492:Libs/cJSON/cJSON_Utils.c ****     if ((list == NULL) || (list->next == NULL))
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccwotn7V.s 			page 14


 493:Libs/cJSON/cJSON_Utils.c ****     {
 494:Libs/cJSON/cJSON_Utils.c ****         /* One entry is sorted already. */
 495:Libs/cJSON/cJSON_Utils.c ****         return result;
 496:Libs/cJSON/cJSON_Utils.c ****     }
 497:Libs/cJSON/cJSON_Utils.c **** 
 498:Libs/cJSON/cJSON_Utils.c ****     while ((current_item != NULL) && (current_item->next != NULL) && (compare_strings((unsigned cha
 499:Libs/cJSON/cJSON_Utils.c ****     {
 500:Libs/cJSON/cJSON_Utils.c ****         /* Test for list sorted. */
 501:Libs/cJSON/cJSON_Utils.c ****         current_item = current_item->next;
 502:Libs/cJSON/cJSON_Utils.c ****     }
 503:Libs/cJSON/cJSON_Utils.c ****     if ((current_item == NULL) || (current_item->next == NULL))
 504:Libs/cJSON/cJSON_Utils.c ****     {
 505:Libs/cJSON/cJSON_Utils.c ****         /* Leave sorted lists unmodified. */
 506:Libs/cJSON/cJSON_Utils.c ****         return result;
 507:Libs/cJSON/cJSON_Utils.c ****     }
 508:Libs/cJSON/cJSON_Utils.c **** 
 509:Libs/cJSON/cJSON_Utils.c ****     /* reset pointer to the beginning */
 510:Libs/cJSON/cJSON_Utils.c ****     current_item = list;
 511:Libs/cJSON/cJSON_Utils.c ****     while (current_item != NULL)
 512:Libs/cJSON/cJSON_Utils.c ****     {
 513:Libs/cJSON/cJSON_Utils.c ****         /* Walk two pointers to find the middle. */
 514:Libs/cJSON/cJSON_Utils.c ****         second = second->next;
 515:Libs/cJSON/cJSON_Utils.c ****         current_item = current_item->next;
 516:Libs/cJSON/cJSON_Utils.c ****         /* advances current_item two steps at a time */
 517:Libs/cJSON/cJSON_Utils.c ****         if (current_item != NULL)
 518:Libs/cJSON/cJSON_Utils.c ****         {
 519:Libs/cJSON/cJSON_Utils.c ****             current_item = current_item->next;
 520:Libs/cJSON/cJSON_Utils.c ****         }
 521:Libs/cJSON/cJSON_Utils.c ****     }
 522:Libs/cJSON/cJSON_Utils.c ****     if ((second != NULL) && (second->prev != NULL))
 523:Libs/cJSON/cJSON_Utils.c ****     {
 524:Libs/cJSON/cJSON_Utils.c ****         /* Split the lists */
 525:Libs/cJSON/cJSON_Utils.c ****         second->prev->next = NULL;
 526:Libs/cJSON/cJSON_Utils.c ****         second->prev = NULL;
 527:Libs/cJSON/cJSON_Utils.c ****     }
 528:Libs/cJSON/cJSON_Utils.c **** 
 529:Libs/cJSON/cJSON_Utils.c ****     /* Recursively sort the sub-lists. */
 530:Libs/cJSON/cJSON_Utils.c ****     first = sort_list(first, case_sensitive);
 531:Libs/cJSON/cJSON_Utils.c ****     second = sort_list(second, case_sensitive);
 532:Libs/cJSON/cJSON_Utils.c ****     result = NULL;
 533:Libs/cJSON/cJSON_Utils.c **** 
 534:Libs/cJSON/cJSON_Utils.c ****     /* Merge the sub-lists */
 535:Libs/cJSON/cJSON_Utils.c ****     while ((first != NULL) && (second != NULL))
 536:Libs/cJSON/cJSON_Utils.c ****     {
 537:Libs/cJSON/cJSON_Utils.c ****         cJSON *smaller = NULL;
 538:Libs/cJSON/cJSON_Utils.c ****         if (compare_strings((unsigned char*)first->string, (unsigned char*)second->string, case_sen
 539:Libs/cJSON/cJSON_Utils.c ****         {
 540:Libs/cJSON/cJSON_Utils.c ****             smaller = first;
 541:Libs/cJSON/cJSON_Utils.c ****         }
 542:Libs/cJSON/cJSON_Utils.c ****         else
 543:Libs/cJSON/cJSON_Utils.c ****         {
 544:Libs/cJSON/cJSON_Utils.c ****             smaller = second;
 545:Libs/cJSON/cJSON_Utils.c ****         }
 546:Libs/cJSON/cJSON_Utils.c **** 
 547:Libs/cJSON/cJSON_Utils.c ****         if (result == NULL)
 548:Libs/cJSON/cJSON_Utils.c ****         {
 549:Libs/cJSON/cJSON_Utils.c ****             /* start merged list with the smaller element */
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccwotn7V.s 			page 15


 550:Libs/cJSON/cJSON_Utils.c ****             result_tail = smaller;
 551:Libs/cJSON/cJSON_Utils.c ****             result = smaller;
 552:Libs/cJSON/cJSON_Utils.c ****         }
 553:Libs/cJSON/cJSON_Utils.c ****         else
 554:Libs/cJSON/cJSON_Utils.c ****         {
 555:Libs/cJSON/cJSON_Utils.c ****             /* add smaller element to the list */
 556:Libs/cJSON/cJSON_Utils.c ****             result_tail->next = smaller;
 557:Libs/cJSON/cJSON_Utils.c ****             smaller->prev = result_tail;
 558:Libs/cJSON/cJSON_Utils.c ****             result_tail = smaller;
 559:Libs/cJSON/cJSON_Utils.c ****         }
 560:Libs/cJSON/cJSON_Utils.c **** 
 561:Libs/cJSON/cJSON_Utils.c ****         if (first == smaller)
 562:Libs/cJSON/cJSON_Utils.c ****         {
 563:Libs/cJSON/cJSON_Utils.c ****             first = first->next;
 564:Libs/cJSON/cJSON_Utils.c ****         }
 565:Libs/cJSON/cJSON_Utils.c ****         else
 566:Libs/cJSON/cJSON_Utils.c ****         {
 567:Libs/cJSON/cJSON_Utils.c ****             second = second->next;
 568:Libs/cJSON/cJSON_Utils.c ****         }
 569:Libs/cJSON/cJSON_Utils.c ****     }
 570:Libs/cJSON/cJSON_Utils.c **** 
 571:Libs/cJSON/cJSON_Utils.c ****     if (first != NULL)
 572:Libs/cJSON/cJSON_Utils.c ****     {
 573:Libs/cJSON/cJSON_Utils.c ****         /* Append rest of first list. */
 574:Libs/cJSON/cJSON_Utils.c ****         if (result == NULL)
 575:Libs/cJSON/cJSON_Utils.c ****         {
 576:Libs/cJSON/cJSON_Utils.c ****             return first;
 577:Libs/cJSON/cJSON_Utils.c ****         }
 578:Libs/cJSON/cJSON_Utils.c ****         result_tail->next = first;
 579:Libs/cJSON/cJSON_Utils.c ****         first->prev = result_tail;
 580:Libs/cJSON/cJSON_Utils.c ****     }
 581:Libs/cJSON/cJSON_Utils.c ****     if (second != NULL)
 582:Libs/cJSON/cJSON_Utils.c ****     {
 583:Libs/cJSON/cJSON_Utils.c ****         /* Append rest of second list */
 584:Libs/cJSON/cJSON_Utils.c ****         if (result == NULL)
 585:Libs/cJSON/cJSON_Utils.c ****         {
 586:Libs/cJSON/cJSON_Utils.c ****             return second;
 587:Libs/cJSON/cJSON_Utils.c ****         }
 588:Libs/cJSON/cJSON_Utils.c ****         result_tail->next = second;
 589:Libs/cJSON/cJSON_Utils.c ****         second->prev = result_tail;
 590:Libs/cJSON/cJSON_Utils.c ****     }
 591:Libs/cJSON/cJSON_Utils.c **** 
 592:Libs/cJSON/cJSON_Utils.c ****     return result;
 593:Libs/cJSON/cJSON_Utils.c **** }
