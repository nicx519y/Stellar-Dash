 456:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     }
 457:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     uint16_t averageValue = sum / samplesToUse;
 458:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
 459:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     // 计算采样时间
 460:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     uint32_t samplingDuration = HAL_GetTick() - state.samplingStartTime;
 461:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     
 462:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     if (state.phase == CalibrationPhase::TOP_SAMPLING) {
 463:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 完成顶部值采样（按键释放状态）
 464:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         state.topValue = averageValue;
 465:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         APP_DBG("Button %d top value calibrated (RELEASED): %d (samples: %d, duration: %lums, range
 466:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****                 buttonIndex, averageValue, samplesToUse, samplingDuration, state.minSample, state.m
 467:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 468:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 进入底部值采样阶段（按键按下状态）
 469:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         setButtonPhase(buttonIndex, CalibrationPhase::BOTTOM_SAMPLING);
 470:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         setButtonLEDColor(buttonIndex, CalibrationLEDColor::DARK_BLUE);
 471:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         updateButtonLED(buttonIndex, CalibrationLEDColor::DARK_BLUE);
 472:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 473:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         clearSampleBuffer(buttonIndex);
 474:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 475:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****     } else if (state.phase == CalibrationPhase::BOTTOM_SAMPLING) {
 476:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // 完成底部值采样（按键按下状态）
 477:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         state.bottomValue = averageValue;
 478:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         APP_DBG("Button %d bottom value calibrated (PRESSED): %d (samples: %d, duration: %lums, ran
 479:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****                 buttonIndex, averageValue, samplesToUse, samplingDuration, state.minSample, state.m
 480:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         
 481:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         // Only publish COMPLETED after the calibration values are durable.
 482:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         const ADCBtnsError saveResult = saveCalibrationValues(buttonIndex);
 483:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         if (saveResult != ADCBtnsError::SUCCESS) {
 484:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             state.isCalibrated = false;
 485:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             setButtonPhase(buttonIndex, CalibrationPhase::ERROR);
 486:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             setButtonLEDColor(buttonIndex, CalibrationLEDColor::YELLOW);
 487:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             updateButtonLED(buttonIndex, CalibrationLEDColor::YELLOW);
 488:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             APP_ERR("Failed to persist calibration for button %u: %d",
 489:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****                     buttonIndex, static_cast<int>(saveResult));
 490:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****             return saveResult;
 491:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         }
 492:Cpp_Core/Src/adc_btns/adc_calibration.cpp ****         state.isCalibrated = true;
