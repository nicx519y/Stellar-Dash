  28:Src/webconfig/configs/ms_mark_command_handler.cpp **** void MSMarkCommandHandler::sendMarkingStatusNotification() {
  29:Src/webconfig/configs/ms_mark_command_handler.cpp ****     // 创建通知消息（不带CID的消息）
  30:Src/webconfig/configs/ms_mark_command_handler.cpp ****     cJSON* json = cJSON_CreateObject();
  31:Src/webconfig/configs/ms_mark_command_handler.cpp ****     if (!json) {
  32:Src/webconfig/configs/ms_mark_command_handler.cpp ****         LOG_ERROR("DeviceCommand", "Failed to create notification JSON");
  33:Src/webconfig/configs/ms_mark_command_handler.cpp ****         return;
  34:Src/webconfig/configs/ms_mark_command_handler.cpp ****     }
  35:Src/webconfig/configs/ms_mark_command_handler.cpp ****     
  36:Src/webconfig/configs/ms_mark_command_handler.cpp ****     // 设置通知消息格式：{"command": "marking_status_update", "errNo": 0, "data": {...}}
  37:Src/webconfig/configs/ms_mark_command_handler.cpp ****     cJSON_AddStringToObject(json, "command", "marking_status_update");
  38:Src/webconfig/configs/ms_mark_command_handler.cpp ****     cJSON_AddNumberToObject(json, "errNo", 0);
  39:Src/webconfig/configs/ms_mark_command_handler.cpp ****     
  40:Src/webconfig/configs/ms_mark_command_handler.cpp ****     // 添加状态数据
