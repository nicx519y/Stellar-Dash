 489:Libs/mbedtls/library/bignum.c **** /*
 490:Libs/mbedtls/library/bignum.c ****  * Helper to write the digits high-order first.
 491:Libs/mbedtls/library/bignum.c ****  */
 492:Libs/mbedtls/library/bignum.c **** static int mpi_write_hlp(mbedtls_mpi *X, int radix,
 493:Libs/mbedtls/library/bignum.c ****                          char **p, const size_t buflen)
 494:Libs/mbedtls/library/bignum.c **** {
 495:Libs/mbedtls/library/bignum.c ****     int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
 496:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint r;
 497:Libs/mbedtls/library/bignum.c ****     size_t length = 0;
 498:Libs/mbedtls/library/bignum.c ****     char *p_end = *p + buflen;
 499:Libs/mbedtls/library/bignum.c **** 
 500:Libs/mbedtls/library/bignum.c ****     do {
 501:Libs/mbedtls/library/bignum.c ****         if (length >= buflen) {
 502:Libs/mbedtls/library/bignum.c ****             return MBEDTLS_ERR_MPI_BUFFER_TOO_SMALL;
 503:Libs/mbedtls/library/bignum.c ****         }
 504:Libs/mbedtls/library/bignum.c **** 
 505:Libs/mbedtls/library/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_mod_int(&r, X, radix));
 506:Libs/mbedtls/library/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_div_int(X, NULL, X, radix));
 507:Libs/mbedtls/library/bignum.c ****         /*
 508:Libs/mbedtls/library/bignum.c ****          * Write the residue in the current position, as an ASCII character.
 509:Libs/mbedtls/library/bignum.c ****          */
 510:Libs/mbedtls/library/bignum.c ****         if (r < 0xA) {
 511:Libs/mbedtls/library/bignum.c ****             *(--p_end) = (char) ('0' + r);
 512:Libs/mbedtls/library/bignum.c ****         } else {
 513:Libs/mbedtls/library/bignum.c ****             *(--p_end) = (char) ('A' + (r - 0xA));
 514:Libs/mbedtls/library/bignum.c ****         }
 515:Libs/mbedtls/library/bignum.c **** 
 516:Libs/mbedtls/library/bignum.c ****         length++;
 517:Libs/mbedtls/library/bignum.c ****     } while (mbedtls_mpi_cmp_int(X, 0) != 0);
 518:Libs/mbedtls/library/bignum.c **** 
 519:Libs/mbedtls/library/bignum.c ****     memmove(*p, p_end, length);
 520:Libs/mbedtls/library/bignum.c ****     *p += length;
 521:Libs/mbedtls/library/bignum.c **** 
 522:Libs/mbedtls/library/bignum.c **** cleanup:
