  64:Drivers/QSPI-W25Q64/qspi-w25q64.c **** #define W25Qxx_READY_POLL_SPIN_DIVISOR 100000UL
  65:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 
  66:Drivers/QSPI-W25Q64/qspi-w25q64.c **** static void QSPI_W25Qxx_ReadyPollPause(void)
  67:Drivers/QSPI-W25Q64/qspi-w25q64.c **** {
  68:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 	volatile uint32_t spins = SystemCoreClock / W25Qxx_READY_POLL_SPIN_DIVISOR;
  69:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 	if (spins == 0U)
  70:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 	{
  71:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 		spins = 1U;
  72:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 	}
  73:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 	while (spins-- > 0U)
  74:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 	{
  75:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 		__NOP();
  76:Drivers/QSPI-W25Q64/qspi-w25q64.c **** 	}
  77:Drivers/QSPI-W25Q64/qspi-w25q64.c **** }
