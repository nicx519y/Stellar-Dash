1487:Libs/mbedtls/library/bignum.c ****     }
1488:Libs/mbedtls/library/bignum.c ****     if (X == B) {
1489:Libs/mbedtls/library/bignum.c ****         MBEDTLS_MPI_CHK(mbedtls_mpi_copy(&TB, B)); B = &TB;
1490:Libs/mbedtls/library/bignum.c ****     }
1491:Libs/mbedtls/library/bignum.c **** 
1492:Libs/mbedtls/library/bignum.c ****     for (i = A->n; i > 0; i--) {
1493:Libs/mbedtls/library/bignum.c ****         if (A->p[i - 1] != 0) {
1494:Libs/mbedtls/library/bignum.c ****             break;
1495:Libs/mbedtls/library/bignum.c ****         }
1496:Libs/mbedtls/library/bignum.c ****     }
1497:Libs/mbedtls/library/bignum.c ****     if (i == 0) {
1498:Libs/mbedtls/library/bignum.c ****         result_is_zero = 1;
1499:Libs/mbedtls/library/bignum.c ****     }
1500:Libs/mbedtls/library/bignum.c **** 
1501:Libs/mbedtls/library/bignum.c ****     for (j = B->n; j > 0; j--) {
1502:Libs/mbedtls/library/bignum.c ****         if (B->p[j - 1] != 0) {
1503:Libs/mbedtls/library/bignum.c ****             break;
1504:Libs/mbedtls/library/bignum.c ****         }
1505:Libs/mbedtls/library/bignum.c ****     }
1506:Libs/mbedtls/library/bignum.c ****     if (j == 0) {
1507:Libs/mbedtls/library/bignum.c ****         result_is_zero = 1;
1508:Libs/mbedtls/library/bignum.c ****     }
1509:Libs/mbedtls/library/bignum.c **** 
1510:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_grow(X, i + j));
1511:Libs/mbedtls/library/bignum.c ****     MBEDTLS_MPI_CHK(mbedtls_mpi_lset(X, 0));
1512:Libs/mbedtls/library/bignum.c **** 
1513:Libs/mbedtls/library/bignum.c ****     for (; j > 0; j--) {
