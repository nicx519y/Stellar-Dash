 998:Src/webconfig/webhid_service.cpp **** bool WebHidService::setup()
 999:Src/webconfig/webhid_service.cpp **** {
1000:Src/webconfig/webhid_service.cpp ****     shutdown();
1001:Src/webconfig/webhid_service.cpp ****     /*
1002:Src/webconfig/webhid_service.cpp ****      * WebConfig deliberately initializes before the CH585 is exposed to the
1003:Src/webconfig/webhid_service.cpp ****      * browser. USBDriver::prepare() has already selected the profile, but
1004:Src/webconfig/webhid_service.cpp ****      * USBDriver::connect() must not run until this service has installed the
1005:Src/webconfig/webhid_service.cpp ****      * receive callback. Otherwise an eager browser can send the first
1006:Src/webconfig/webhid_service.cpp ****      * attestation report into a real, credited channel while the callback is
1007:Src/webconfig/webhid_service.cpp ****      * still null, permanently losing that bootstrap generation.
1008:Src/webconfig/webhid_service.cpp ****      */
1009:Src/webconfig/webhid_service.cpp ****     const bool driverReady = USB_DRIVER.isPrepared();
