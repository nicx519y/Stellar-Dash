 593:Src/transport/usb/usb_board_link_port.cpp ****             uint8_t fill = 0xffu;
 594:Src/transport/usb/usb_board_link_port.cpp ****             const uint32_t used = HAL_GetTick() - started;
 595:Src/transport/usb/usb_board_link_port.cpp ****             if (used >= budget) break;
 596:Src/transport/usb/usb_board_link_port.cpp ****             const uint32_t remaining = budget - used;
 597:Src/transport/usb/usb_board_link_port.cpp ****             if (HAL_SPI_TransmitReceive(&s_hspi, &fill, &raw[count], 1u,
 598:Src/transport/usb/usb_board_link_port.cpp ****                                        remaining < kSpiTimeoutMs ? remaining : kSpiTimeoutMs) != HA
 599:Src/transport/usb/usb_board_link_port.cpp ****             ++count;
 600:Src/transport/usb/usb_board_link_port.cpp ****             if (!total && count >= 3u) {
 601:Src/transport/usb/usb_board_link_port.cpp ****                 const uint8_t at = count - 3u;
 602:Src/transport/usb/usb_board_link_port.cpp ****                 if (raw[at] == USB_BOARD_LINK_SYNC && raw[at + 1u] == USB_BOARD_EVT_ROLE_SELECTED &
