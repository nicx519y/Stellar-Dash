1960:Libs/mbedtls/library/bignum.c ****      * do the calculation without using conditional tests. */
1961:Libs/mbedtls/library/bignum.c ****     /* Set d to d0 + (2^biL)^n - N where d0 is the current value of d. */
1962:Libs/mbedtls/library/bignum.c ****     d[n] += 1;
