 110:Cpp_Core/Src/firmware/firmware_manager.cpp **** // CRC32计算函数（如果没有硬件CRC，使用软件实现）
 111:Cpp_Core/Src/firmware/firmware_manager.cpp **** static uint32_t calculate_crc32(const uint8_t* data, size_t length, uint32_t initial_crc = 0xFFFFFF
 112:Cpp_Core/Src/firmware/firmware_manager.cpp ****     // 使用STM32硬件CRC或软件CRC32实现
 113:Cpp_Core/Src/firmware/firmware_manager.cpp ****     #ifdef USE_HARDWARE_CRC
 114:Cpp_Core/Src/firmware/firmware_manager.cpp ****         // 使用STM32硬件CRC计算
 115:Cpp_Core/Src/firmware/firmware_manager.cpp ****         return HAL_CRC_Calculate(&hcrc, (uint32_t*)data, length/4);
 116:Cpp_Core/Src/firmware/firmware_manager.cpp ****     #else
 117:Cpp_Core/Src/firmware/firmware_manager.cpp ****         uint32_t crc = initial_crc;
 118:Cpp_Core/Src/firmware/firmware_manager.cpp ****         for (size_t i = 0; i < length; i++) {
 119:Cpp_Core/Src/firmware/firmware_manager.cpp ****             crc = crc32_table[(crc ^ data[i]) & 0xFF] ^ (crc >> 8);
 120:Cpp_Core/Src/firmware/firmware_manager.cpp ****         }
 121:Cpp_Core/Src/firmware/firmware_manager.cpp ****         return crc ^ 0xFFFFFFFF;
 122:Cpp_Core/Src/firmware/firmware_manager.cpp ****     #endif
 123:Cpp_Core/Src/firmware/firmware_manager.cpp **** }
