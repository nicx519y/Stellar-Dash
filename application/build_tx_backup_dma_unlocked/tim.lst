 116:Core/Src/tim.c ****   /* USER CODE BEGIN TIM4_Init 2 */
 117:Core/Src/tim.c ****   /* Request each channel's next CCR preload at the period boundary. With
 118:Core/Src/tim.c ****    * compare-triggered DMA a '1' (CCR=150) leaves only 158 timer ticks before
 119:Core/Src/tim.c ****    * the next preload latch; update-triggered CC requests get all 308 ticks.
 120:Core/Src/tim.c ****    * CCDS keeps the independent TIM4_CH1/CH2 DMA mappings and CCxDE gates.
 121:Core/Src/tim.c ****    * Set once before either strip starts; never generate UG/reset CNT here. */
 122:Core/Src/tim.c ****   SET_BIT(htim4.Instance->CR2, TIM_CR2_CCDS);
 123:Core/Src/tim.c ****   /* USER CODE END TIM4_Init 2 */
 124:Core/Src/tim.c ****   HAL_TIM_MspPostInit(&htim4);
