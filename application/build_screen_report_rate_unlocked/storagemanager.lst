  43:Src/config/storagemanager.cpp **** 	/*
  44:Src/config/storagemanager.cpp **** 	 * A journal write always targets the inactive bank and commits last, so a
  45:Src/config/storagemanager.cpp **** 	 * failed save leaves the previous bank readable. Reload it in-place instead
  46:Src/config/storagemanager.cpp **** 	 * of keeping a second ~36 KiB Config object resident in scarce MCU RAM.
  47:Src/config/storagemanager.cpp **** 	 */
  48:Src/config/storagemanager.cpp **** 	if (ConfigUtils::fromStorage(config)) {
  49:Src/config/storagemanager.cpp **** 		APP_ERR("Storage::saveConfig failed; runtime config reloaded from the committed bank.");
  50:Src/config/storagemanager.cpp **** 	} else {
  51:Src/config/storagemanager.cpp **** 		APP_ERR("Storage::saveConfig failed; committed config reload also failed.");
  52:Src/config/storagemanager.cpp **** 	}
  53:Src/config/storagemanager.cpp **** 	return false;
