 769:Libs/mbedtls/library/bignum.c **** static void mpi_bigendian_to_host(mbedtls_mpi_uint * const p, size_t limbs)
 770:Libs/mbedtls/library/bignum.c **** {
 771:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint *cur_limb_left;
 772:Libs/mbedtls/library/bignum.c ****     mbedtls_mpi_uint *cur_limb_right;
 773:Libs/mbedtls/library/bignum.c ****     if (limbs == 0) {
