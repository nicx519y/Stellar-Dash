 323:Libs/mbedtls/library/constant_time.c **** /** Shift some data towards the left inside a buffer.
 324:Libs/mbedtls/library/constant_time.c ****  *
 325:Libs/mbedtls/library/constant_time.c ****  * `mbedtls_ct_mem_move_to_left(start, total, offset)` is functionally
 326:Libs/mbedtls/library/constant_time.c ****  * equivalent to
 327:Libs/mbedtls/library/constant_time.c ****  * ```
 328:Libs/mbedtls/library/constant_time.c ****  * memmove(start, start + offset, total - offset);
 329:Libs/mbedtls/library/constant_time.c ****  * memset(start + offset, 0, total - offset);
 330:Libs/mbedtls/library/constant_time.c ****  * ```
 331:Libs/mbedtls/library/constant_time.c ****  * but it strives to use a memory access pattern (and thus total timing)
 332:Libs/mbedtls/library/constant_time.c ****  * that does not depend on \p offset. This timing independence comes at
 333:Libs/mbedtls/library/constant_time.c ****  * the expense of performance.
 334:Libs/mbedtls/library/constant_time.c ****  *
 335:Libs/mbedtls/library/constant_time.c ****  * \param start     Pointer to the start of the buffer.
 336:Libs/mbedtls/library/constant_time.c ****  * \param total     Total size of the buffer.
 337:Libs/mbedtls/library/constant_time.c ****  * \param offset    Offset from which to copy \p total - \p offset bytes.
 338:Libs/mbedtls/library/constant_time.c ****  */
 339:Libs/mbedtls/library/constant_time.c **** static void mbedtls_ct_mem_move_to_left(void *start,
 340:Libs/mbedtls/library/constant_time.c ****                                         size_t total,
 341:Libs/mbedtls/library/constant_time.c ****                                         size_t offset)
 342:Libs/mbedtls/library/constant_time.c **** {
 343:Libs/mbedtls/library/constant_time.c ****     volatile unsigned char *buf = start;
 344:Libs/mbedtls/library/constant_time.c ****     size_t i, n;
 345:Libs/mbedtls/library/constant_time.c ****     if (total == 0) {
 346:Libs/mbedtls/library/constant_time.c ****         return;
 347:Libs/mbedtls/library/constant_time.c ****     }
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\ccBWFA13.s 			page 19


 348:Libs/mbedtls/library/constant_time.c ****     for (i = 0; i < total; i++) {
 349:Libs/mbedtls/library/constant_time.c ****         unsigned no_op = mbedtls_ct_size_gt(total - offset, i);
 350:Libs/mbedtls/library/constant_time.c ****         /* The first `total - offset` passes are a no-op. The last
 351:Libs/mbedtls/library/constant_time.c ****          * `offset` passes shift the data one byte to the left and
 352:Libs/mbedtls/library/constant_time.c ****          * zero out the last byte. */
 353:Libs/mbedtls/library/constant_time.c ****         for (n = 0; n < total - 1; n++) {
 354:Libs/mbedtls/library/constant_time.c ****             unsigned char current = buf[n];
 355:Libs/mbedtls/library/constant_time.c ****             unsigned char next = buf[n+1];
 356:Libs/mbedtls/library/constant_time.c ****             buf[n] = mbedtls_ct_uint_if(no_op, current, next);
 357:Libs/mbedtls/library/constant_time.c ****         }
 358:Libs/mbedtls/library/constant_time.c ****         buf[total-1] = mbedtls_ct_uint_if(no_op, buf[total-1], 0);
 359:Libs/mbedtls/library/constant_time.c ****     }
 360:Libs/mbedtls/library/constant_time.c **** }
 361:Libs/mbedtls/library/constant_time.c **** 
 362:Libs/mbedtls/library/constant_time.c **** #endif /* MBEDTLS_PKCS1_V15 && MBEDTLS_RSA_C && ! MBEDTLS_RSA_ALT */
 363:Libs/mbedtls/library/constant_time.c **** 
 364:Libs/mbedtls/library/constant_time.c **** #if defined(MBEDTLS_SSL_SOME_MODES_USE_MAC)
 365:Libs/mbedtls/library/constant_time.c **** void mbedtls_ct_memcpy_if_eq(unsigned char *dest,
 366:Libs/mbedtls/library/constant_time.c ****                              const unsigned char *src,
 367:Libs/mbedtls/library/constant_time.c ****                              size_t len,
 368:Libs/mbedtls/library/constant_time.c ****                              size_t c1,
 369:Libs/mbedtls/library/constant_time.c ****                              size_t c2)
 370:Libs/mbedtls/library/constant_time.c **** {
 371:Libs/mbedtls/library/constant_time.c ****     /* mask = c1 == c2 ? 0xff : 0x00 */
 372:Libs/mbedtls/library/constant_time.c ****     const size_t equal = mbedtls_ct_size_bool_eq(c1, c2);
 373:Libs/mbedtls/library/constant_time.c ****     const unsigned char mask = (unsigned char) mbedtls_ct_size_mask(equal);
 374:Libs/mbedtls/library/constant_time.c **** 
 375:Libs/mbedtls/library/constant_time.c ****     /* dest[i] = c1 == c2 ? src[i] : dest[i] */
 376:Libs/mbedtls/library/constant_time.c ****     for (size_t i = 0; i < len; i++) {
 377:Libs/mbedtls/library/constant_time.c ****         dest[i] = (src[i] & mask) | (dest[i] & ~mask);
 378:Libs/mbedtls/library/constant_time.c ****     }
