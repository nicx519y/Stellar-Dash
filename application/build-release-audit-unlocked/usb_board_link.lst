  36:../common/usb_monitor_protocol.h **** /* Feature: magic[0], version[4], opcode[5], status[6], flags[7],
  37:../common/usb_monitor_protocol.h ****  * transaction[8], session[12], period_ms:u16[16], speed[18], caps[19],
  38:../common/usb_monitor_protocol.h ****  * drops:u32[20], reserved[24..29], CRC16[30] over bytes 0..29.
  39:../common/usb_monitor_protocol.h ****  * Stats: magic, version/flags/speed/reserved, session, device_us,
ARM GAS  C:\Users\nicx5\AppData\Local\Temp\cc14gaRw.s 			page 89


  40:../common/usb_monitor_protocol.h ****  * received, completed, overwritten, rate:u16, diagnostic_drops:u16.
  41:../common/usb_monitor_protocol.h ****  * Edge: magic, version/page/revision/flags, session, event, previous,
  42:../common/usb_monitor_protocol.h ****  * current, two u32 values. Pages 0 ADC/logic, 1 SPI-wait/SPI,
  43:../common/usb_monitor_protocol.h ****  * 2 CH585 receive-to-arm/arm-to-complete, 3 total lower/upper (us).
  44:../common/usb_monitor_protocol.h ****  * Four pages form one revision; UNKNOWN is not a zero duration.
  45:../common/usb_monitor_protocol.h ****  * Board messages use the existing BoardLink frame checksum: op/version/flags/seq,
  46:../common/usb_monitor_protocol.h ****  * session:u32[4], transaction/event:u32[8], then payload.
  47:../common/usb_monitor_protocol.h ****  * QUERY: cumulative source diagnostic drops[12]. Reply echoes header, t2[12], t3[16].
  48:../common/usb_monitor_protocol.h ****  * CLOCK: signed CH585-minus-STM32 lower[12], upper[16], query t2[20].
  49:../common/usb_monitor_protocol.h ****  * EDGE: previous[12], current[16], sample_us[20], ADC[24], logic[28],
  50:../common/usb_monitor_protocol.h ****  * SPI-wait[32], SPI[36]. seq is the original input sequence.
  51:../common/usb_monitor_protocol.h ****  */
